// name:              Directory changes by or to one user
// purpose:           What Entra changes did this user make, and what changes were made to them?
// starting_entities: UPN
// required_tables:   AuditLogs
// optional_tables:   none
// variables:         TargetUser, Lookback
// done_criteria:     Each change is attributed to an expected admin, app or self-service action, or escalated.
// output_type:       analysis
//
// Surface: Sentinel Log Analytics (TimeGenerated).

let TargetUser = "user@contoso.com";
let Lookback = 14d;
AuditLogs
| where TimeGenerated >= ago(Lookback)
| extend InitiatorUPN = tostring(InitiatedBy.user.userPrincipalName), InitiatorApp = tostring(InitiatedBy.app.displayName)
| mv-expand TargetResource = TargetResources
| extend TargetUPN = tostring(TargetResource.userPrincipalName), TargetName = tostring(TargetResource.displayName), TargetType = tostring(TargetResource.type)
| where InitiatorUPN =~ TargetUser or TargetUPN =~ TargetUser or TargetName =~ TargetUser
| project TimeGenerated, ActivityDisplayName, Result, InitiatorUPN, InitiatorApp, TargetUPN, TargetName, TargetType
| order by TimeGenerated desc
