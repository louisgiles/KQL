// name:              Direct process lineage
// purpose:           What spawned this process, and what did it spawn next?
// starting_entities: DeviceName and ProcessId, near a known process time
// required_tables:   DeviceProcessEvents
// optional_tables:   none
// variables:         TargetDevice, TargetProcessId, ProcessTime, Window
// done_criteria:     Parent and children are identified for the right process instance. PIDs are reused, so keep Window tight around ProcessTime.
// output_type:       analysis
//
// Surface: Sentinel Log Analytics (TimeGenerated).

let TargetDevice = "host.contoso.com";
let TargetProcessId = 1234;
let ProcessTime = now();  // set to the alert or process creation time
let Window = 2h;          // PIDs are reused; keep this tight
DeviceProcessEvents
| where TimeGenerated between ((ProcessTime - Window) .. (ProcessTime + Window))
| where DeviceName =~ TargetDevice
| where ProcessId == TargetProcessId or InitiatingProcessId == TargetProcessId
| extend Relation = iff(ProcessId == TargetProcessId, "Target", "Child")
| project TimeGenerated, Relation, AccountName, FileName, ProcessCommandLine, ProcessId, InitiatingProcessFileName, InitiatingProcessId
| order by TimeGenerated asc
