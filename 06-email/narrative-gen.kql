// name:              Email Narrative Generator
// purpose:           Dash-prefixed, paste-ready investigation note for email/phishing alerts.
//                    Companion to email quick-dive and email deep-dive.
// starting_entities: NetworkMessageId
// required_tables:   EmailEvents
// optional_tables:   EmailAttachmentInfo, EmailUrlInfo, EmailPostDeliveryEvents, UrlClickEvents
// variables:         TargetNetworkMessageId, SearchLookback, BaselineWindow
// done_criteria:     Closure-only narrative output. Architecture: narrative-gen produces the Actions-taken body for a closure note; it is not an escalation generator. Benign verdicts open with the determination, carry the body, and end with a fixed insignia line. Escalation verdicts open with a single "--- ESCALATE ---" header followed by the determination, pre-filled branch-aware Analyst assessment, and the body — no ASK BLOCK, no Incident Summary, no Remediation. Review verdicts carry the determination, pre-filled Analyst assessment, and the body. Body lines are ordered by verdict-bearing (verdict-driving first, corroborating posture next, meta last). Literal entity values (recipient, sender, NetworkMessageId, sender IP, URL domains, attachment file names / hashes, subject) stay in the projected non-narrative columns — the body refers to them by role label. Output pasted into the investigation ticket.
// output_type:       narrative

let TargetNetworkMessageId = "";
let SearchLookback = 30d;
let BaselineWindow = 90d;
let BaselineLabel = "90d";
//
// --- Render a timespan as plain English ("30 days", "7 days", "1 hour"). ---
let humanTimespan = (t:timespan) {
    case(
        t >= 1d, strcat(tostring(toint(t / 1d)), iff(toint(t / 1d) == 1, " day", " days")),
        t >= 1h, strcat(tostring(toint(t / 1h)), iff(toint(t / 1h) == 1, " hour", " hours")),
        t >= 1m, strcat(tostring(toint(t / 1m)), iff(toint(t / 1m) == 1, " minute", " minutes")),
        tostring(t)
    )
};
//
// ============================================================================
// Target message
// ============================================================================
let TargetEmail = materialize(
    EmailEvents
    | extend EventTime = coalesce(
        column_ifexists("Timestamp", datetime(null)),
        column_ifexists("TimeGenerated", datetime(null))
    )
    | where EventTime >= ago(SearchLookback)
    | where NetworkMessageId == TargetNetworkMessageId
    | extend
        Sender = tolower(tostring(SenderFromAddress)),
        SenderDomain = tolower(extract(@"@([^@]+)$", 1, tostring(SenderFromAddress))),
        Recipient = tolower(tostring(RecipientEmailAddress)),
        SenderMailFromAddressSafe = tostring(column_ifexists("SenderMailFromAddress", "")),
        SenderIPv4Safe = tostring(column_ifexists("SenderIPv4", "")),
        DeliveryActionSafe = tostring(column_ifexists("DeliveryAction", "")),
        DeliveryLocationSafe = tostring(column_ifexists("DeliveryLocation", "")),
        EmailDirectionSafe = tostring(column_ifexists("EmailDirection", "")),
        ThreatTypesSafe = tostring(column_ifexists("ThreatTypes", "")),
        ThreatNamesSafe = tostring(column_ifexists("ThreatNames", "")),
        DetectionMethodsSafe = tostring(column_ifexists("DetectionMethods", "")),
        OrgLevelActionSafe = tostring(column_ifexists("OrgLevelAction", "")),
        UserLevelActionSafe = tostring(column_ifexists("UserLevelAction", "")),
        AuthRaw = tostring(AuthenticationDetails)
    | extend AuthJson = parse_json(AuthRaw)
    | extend
        DKIM = tolower(tostring(coalesce(
            extractjson("$.DKIM", AuthRaw),
            extractjson("$.dkim", AuthRaw),
            AuthJson["DKIM"],
            AuthJson["dkim"]
        ))),
        DMARC = tolower(tostring(coalesce(
            extractjson("$.DMARC", AuthRaw),
            extractjson("$.dmarc", AuthRaw),
            AuthJson["DMARC"],
            AuthJson["dmarc"]
        ))),
        SPF = tolower(tostring(coalesce(
            extractjson("$.SPF", AuthRaw),
            extractjson("$.spf", AuthRaw),
            AuthJson["SPF"],
            AuthJson["spf"]
        ))),
        CompAuth = tolower(tostring(coalesce(
            extractjson("$.CompAuth", AuthRaw),
            extractjson("$.compauth", AuthRaw),
            AuthJson["CompAuth"],
            AuthJson["compauth"]
        )))
    | summarize arg_max(EventTime, *) by NetworkMessageId
);
let TargetTime = toscalar(TargetEmail | project EventTime);
let TargetSender = toscalar(TargetEmail | project Sender);
let TargetSenderDomain = toscalar(TargetEmail | project SenderDomain);
let TargetRecipient = toscalar(TargetEmail | project Recipient);
let TargetSubject = toscalar(TargetEmail | project Subject);
//
// ============================================================================
// Sender / domain / recipient baseline
// ============================================================================
let HistoricalEmail = materialize(
    EmailEvents
    | extend EventTime = coalesce(
        column_ifexists("Timestamp", datetime(null)),
        column_ifexists("TimeGenerated", datetime(null))
    )
    | where EventTime between (TargetTime - BaselineWindow .. TargetTime - 1h)
    | extend
        Sender = tolower(tostring(SenderFromAddress)),
        SenderDomain = tolower(extract(@"@([^@]+)$", 1, tostring(SenderFromAddress))),
        Recipient = tolower(tostring(RecipientEmailAddress))
);
let SenderBaseline =
    HistoricalEmail
    | where Sender == TargetSender
    | summarize
        SenderSeenCount=count(),
        SenderDaysSeen=dcount(bin(EventTime, 1d)),
        SenderRecipientsSeen=dcount(Recipient),
        SenderFirstSeen=min(EventTime),
        SenderLastSeen=max(EventTime);
let SenderDomainBaseline =
    HistoricalEmail
    | where SenderDomain == TargetSenderDomain
    | summarize
        SenderDomainSeenCount=count(),
        SenderDomainDaysSeen=dcount(bin(EventTime, 1d)),
        SenderDomainRecipientsSeen=dcount(Recipient),
        SenderDomainSendersSeen=dcount(Sender),
        SenderDomainFirstSeen=min(EventTime),
        SenderDomainLastSeen=max(EventTime);
let SenderRecipientBaseline =
    HistoricalEmail
    | where Sender == TargetSender
    | where Recipient == TargetRecipient
    | summarize
        SenderRecipientSeenCount=count(),
        SenderRecipientDaysSeen=dcount(bin(EventTime, 1d)),
        SenderRecipientFirstSeen=min(EventTime),
        SenderRecipientLastSeen=max(EventTime);
//
// ============================================================================
// Similar message / recipient spread
// ============================================================================
let SimilarMessages =
    EmailEvents
    | extend EventTime = coalesce(
        column_ifexists("Timestamp", datetime(null)),
        column_ifexists("TimeGenerated", datetime(null))
    )
    | where EventTime between (TargetTime - SearchLookback .. TargetTime + 1h)
    | extend
        Sender = tolower(tostring(SenderFromAddress)),
        SenderDomain = tolower(extract(@"@([^@]+)$", 1, tostring(SenderFromAddress))),
        Recipient = tolower(tostring(RecipientEmailAddress))
    | where NetworkMessageId == TargetNetworkMessageId
        or Sender == TargetSender
        or (SenderDomain == TargetSenderDomain and Subject =~ TargetSubject)
    | summarize
        SimilarEvents=count(),
        SimilarRecipients=dcount(Recipient),
        SimilarNetworkMessageIds=dcount(NetworkMessageId),
        SimilarFirstSeen=min(EventTime),
        SimilarLastSeen=max(EventTime),
        SimilarRecipientExamples=make_set(Recipient, 50);
//
// ============================================================================
// URLs
// ============================================================================
let TargetUrls = materialize(
    union isfuzzy=true
    (
        EmailUrlInfo
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where NetworkMessageId == TargetNetworkMessageId
        | extend
            UrlSafe = tostring(column_ifexists("Url", "")),
            UrlDomainSafe = tolower(tostring(column_ifexists("UrlDomain", ""))),
            UrlThreatTypes = tostring(column_ifexists("ThreatTypes", "")),
            UrlThreatNames = tostring(column_ifexists("ThreatNames", ""))
        | extend UrlDomainSafe = iff(
            isempty(UrlDomainSafe),
            tolower(extract(@"^(?:https?://)?([^/:?#]+)", 1, UrlSafe)),
            UrlDomainSafe
        )
        | where isnotempty(UrlSafe) or isnotempty(UrlDomainSafe)
        | project EventTime, NetworkMessageId, UrlSafe, UrlDomainSafe, UrlThreatTypes, UrlThreatNames
    )
);
let TargetUrlDomains = toscalar(TargetUrls | where isnotempty(UrlDomainSafe) | summarize make_set(UrlDomainSafe, 100));
let UrlDomainBaseline =
    union isfuzzy=true
    (
        EmailUrlInfo
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where EventTime between (TargetTime - BaselineWindow .. TargetTime - 1h)
        | extend
            UrlSafe = tostring(column_ifexists("Url", "")),
            UrlDomainSafe = tolower(tostring(column_ifexists("UrlDomain", ""))),
            RecipientSafe = tolower(tostring(column_ifexists("RecipientEmailAddress", "")))
        | extend UrlDomainSafe = iff(
            isempty(UrlDomainSafe),
            tolower(extract(@"^(?:https?://)?([^/:?#]+)", 1, UrlSafe)),
            UrlDomainSafe
        )
        | where UrlDomainSafe in (TargetUrlDomains)
        | summarize
            UrlDomainSeenCount=count(),
            UrlDomainDaysSeen=dcount(bin(EventTime, 1d)),
            UrlDomainRecipientsSeen=dcount(RecipientSafe)
            by UrlDomainSafe
    );
let UrlSummary =
    TargetUrls
    | join kind=leftouter UrlDomainBaseline on UrlDomainSafe
    | extend
        UrlDomainSeenCount=coalesce(UrlDomainSeenCount, 0),
        UrlDomainDaysSeen=coalesce(UrlDomainDaysSeen, 0),
        UrlDomainRecipientsSeen=coalesce(UrlDomainRecipientsSeen, 0)
    | summarize
        UrlCount=dcount(UrlSafe),
        UrlDomains=make_set(UrlDomainSafe, 50),
        Urls=make_set(UrlSafe, 50),
        RareUrlDomains=make_set_if(UrlDomainSafe, UrlDomainSeenCount == 0 or UrlDomainDaysSeen <= 1, 50),
        UrlThreatTypes=make_set_if(UrlThreatTypes, isnotempty(UrlThreatTypes), 20),
        UrlThreatNames=make_set_if(UrlThreatNames, isnotempty(UrlThreatNames), 20),
        UrlDomainSeenCountTotal=sum(UrlDomainSeenCount),
        UrlDomainDaysSeenMax=max(UrlDomainDaysSeen),
        UrlDomainRecipientsSeenTotal=sum(UrlDomainRecipientsSeen);
//
// ============================================================================
// Attachments
// ============================================================================
let TargetAttachments = materialize(
    union isfuzzy=true
    (
        EmailAttachmentInfo
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where NetworkMessageId == TargetNetworkMessageId
        | extend
            FileNameSafe = tostring(column_ifexists("FileName", "")),
            SHA256Safe = tostring(column_ifexists("SHA256", "")),
            FileTypeSafe = tolower(tostring(column_ifexists("FileType", ""))),
            AttachmentThreatTypes = tostring(column_ifexists("ThreatTypes", "")),
            AttachmentThreatNames = tostring(column_ifexists("ThreatNames", ""))
        | extend FileExt = tolower(extract(@"\.([^\.\\\/]+)$", 1, FileNameSafe))
        | extend AttachmentType = iff(isnotempty(FileTypeSafe), FileTypeSafe, FileExt)
        | where isnotempty(FileNameSafe) or isnotempty(SHA256Safe)
        | project EventTime, NetworkMessageId, FileNameSafe, SHA256Safe, AttachmentType, AttachmentThreatTypes, AttachmentThreatNames
    )
);
let TargetAttachmentHashes = toscalar(TargetAttachments | where isnotempty(SHA256Safe) | summarize make_set(SHA256Safe, 100));
let AttachmentHashBaseline =
    union isfuzzy=true
    (
        EmailAttachmentInfo
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where EventTime between (TargetTime - BaselineWindow .. TargetTime - 1h)
        | extend
            SHA256Safe = tostring(column_ifexists("SHA256", "")),
            RecipientSafe = tolower(tostring(column_ifexists("RecipientEmailAddress", "")))
        | where isnotempty(SHA256Safe)
        | where SHA256Safe in (TargetAttachmentHashes)
        | summarize
            AttachmentHashSeenCount=count(),
            AttachmentHashDaysSeen=dcount(bin(EventTime, 1d)),
            AttachmentHashRecipientsSeen=dcount(RecipientSafe)
            by SHA256Safe
    );
let AttachmentSummary =
    TargetAttachments
    | join kind=leftouter AttachmentHashBaseline on SHA256Safe
    | extend
        AttachmentHashSeenCount=coalesce(AttachmentHashSeenCount, 0),
        AttachmentHashDaysSeen=coalesce(AttachmentHashDaysSeen, 0),
        AttachmentHashRecipientsSeen=coalesce(AttachmentHashRecipientsSeen, 0)
    | extend IsRiskyAttachmentType = AttachmentType in (
        "html", "htm", "js", "jse", "vbs", "vbe", "wsf", "wsh",
        "lnk", "iso", "img", "exe", "scr", "dll", "bat", "cmd",
        "ps1", "zip", "rar", "7z", "one", "docm", "xlsm", "pptm"
    )
    | summarize
        AttachmentCount=dcount(FileNameSafe),
        AttachmentNames=make_set(FileNameSafe, 50),
        AttachmentSHA256s=make_set(SHA256Safe, 50),
        AttachmentTypes=make_set(AttachmentType, 50),
        RiskyAttachmentTypes=make_set_if(AttachmentType, IsRiskyAttachmentType, 50),
        NewOrRareAttachmentHashes=make_set_if(SHA256Safe, isnotempty(SHA256Safe) and (AttachmentHashSeenCount == 0 or AttachmentHashDaysSeen <= 1), 50),
        AttachmentThreatTypes=make_set_if(AttachmentThreatTypes, isnotempty(AttachmentThreatTypes), 20),
        AttachmentThreatNames=make_set_if(AttachmentThreatNames, isnotempty(AttachmentThreatNames), 20),
        AttachmentHashSeenCountTotal=sum(AttachmentHashSeenCount),
        AttachmentHashDaysSeenMax=max(AttachmentHashDaysSeen),
        AttachmentHashRecipientsSeenTotal=sum(AttachmentHashRecipientsSeen);
//
// ============================================================================
// Clicks and post-delivery remediation
// ============================================================================
let ClickSummary =
    union isfuzzy=true
    (
        UrlClickEvents
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where EventTime between (TargetTime - SearchLookback .. TargetTime + 7d)
        | where NetworkMessageId == TargetNetworkMessageId
        | summarize
            ClickCount=count(),
            ClickUsers=dcount(tolower(tostring(column_ifexists("AccountUpn", "")))),
            ClickUserList=make_set(tolower(tostring(column_ifexists("AccountUpn", ""))), 50),
            ClickActions=make_set(tostring(column_ifexists("ActionType", "")), 20),
            ClickedUrls=make_set(tostring(column_ifexists("Url", "")), 50),
            FirstClick=min(EventTime),
            LatestClick=max(EventTime)
            by NetworkMessageId
    );
let PostDeliverySummary =
    union isfuzzy=true
    (
        EmailPostDeliveryEvents
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where EventTime between (TargetTime - SearchLookback .. TargetTime + 7d)
        | where NetworkMessageId == TargetNetworkMessageId
        | summarize
            PostDeliveryEventCount=count(),
            PostDeliveryActions=make_set(tostring(column_ifexists("ActionType", "")), 20),
            PostDeliveryResults=make_set(tostring(column_ifexists("ActionResult", "")), 20),
            LatestPostDeliveryEvent=max(EventTime)
            by NetworkMessageId
    );
//
// ============================================================================
// Narrative source
// ============================================================================
TargetEmail
| extend _joinKey = 1
| join kind=leftouter (SenderBaseline | extend _joinKey = 1) on _joinKey
| join kind=leftouter (SenderDomainBaseline | extend _joinKey = 1) on _joinKey
| join kind=leftouter (SenderRecipientBaseline | extend _joinKey = 1) on _joinKey
| join kind=leftouter (SimilarMessages | extend _joinKey = 1) on _joinKey
| join kind=leftouter (UrlSummary | extend _joinKey = 1) on _joinKey
| join kind=leftouter (AttachmentSummary | extend _joinKey = 1) on _joinKey
| join kind=leftouter ClickSummary on NetworkMessageId
| join kind=leftouter PostDeliverySummary on NetworkMessageId
| extend
    SenderSeenCount=coalesce(SenderSeenCount, 0),
    SenderDaysSeen=coalesce(SenderDaysSeen, 0),
    SenderRecipientsSeen=coalesce(SenderRecipientsSeen, 0),
    SenderDomainSeenCount=coalesce(SenderDomainSeenCount, 0),
    SenderDomainDaysSeen=coalesce(SenderDomainDaysSeen, 0),
    SenderDomainRecipientsSeen=coalesce(SenderDomainRecipientsSeen, 0),
    SenderDomainSendersSeen=coalesce(SenderDomainSendersSeen, 0),
    SenderRecipientSeenCount=coalesce(SenderRecipientSeenCount, 0),
    SenderRecipientDaysSeen=coalesce(SenderRecipientDaysSeen, 0),
    SimilarEvents=coalesce(SimilarEvents, 0),
    SimilarRecipients=coalesce(SimilarRecipients, 0),
    SimilarNetworkMessageIds=coalesce(SimilarNetworkMessageIds, 0),
    UrlCount=coalesce(UrlCount, 0),
    UrlDomainSeenCountTotal=coalesce(UrlDomainSeenCountTotal, 0),
    UrlDomainDaysSeenMax=coalesce(UrlDomainDaysSeenMax, 0),
    AttachmentCount=coalesce(AttachmentCount, 0),
    AttachmentHashSeenCountTotal=coalesce(AttachmentHashSeenCountTotal, 0),
    AttachmentHashDaysSeenMax=coalesce(AttachmentHashDaysSeenMax, 0),
    ClickCount=coalesce(ClickCount, 0),
    ClickUsers=coalesce(ClickUsers, 0),
    PostDeliveryEventCount=coalesce(PostDeliveryEventCount, 0),
    UrlDomains=coalesce(UrlDomains, dynamic([])),
    Urls=coalesce(Urls, dynamic([])),
    RareUrlDomains=coalesce(RareUrlDomains, dynamic([])),
    UrlThreatTypes=coalesce(UrlThreatTypes, dynamic([])),
    UrlThreatNames=coalesce(UrlThreatNames, dynamic([])),
    AttachmentNames=coalesce(AttachmentNames, dynamic([])),
    AttachmentSHA256s=coalesce(AttachmentSHA256s, dynamic([])),
    AttachmentTypes=coalesce(AttachmentTypes, dynamic([])),
    RiskyAttachmentTypes=coalesce(RiskyAttachmentTypes, dynamic([])),
    NewOrRareAttachmentHashes=coalesce(NewOrRareAttachmentHashes, dynamic([])),
    AttachmentThreatTypes=coalesce(AttachmentThreatTypes, dynamic([])),
    AttachmentThreatNames=coalesce(AttachmentThreatNames, dynamic([])),
    ClickActions=coalesce(ClickActions, dynamic([])),
    ClickedUrls=coalesce(ClickedUrls, dynamic([])),
    PostDeliveryActions=coalesce(PostDeliveryActions, dynamic([])),
    PostDeliveryResults=coalesce(PostDeliveryResults, dynamic([]))
| extend
    AuthPassCount =
        iff(DKIM has "pass", 1, 0)
        + iff(DMARC has "pass", 1, 0)
        + iff(SPF has "pass", 1, 0)
        + iff(CompAuth has "pass", 1, 0),
    AuthFailCount =
        iff(isnotempty(DKIM) and DKIM !has "pass", 1, 0)
        + iff(isnotempty(DMARC) and DMARC !has "pass", 1, 0)
        + iff(isnotempty(SPF) and SPF !has "pass", 1, 0)
        + iff(isnotempty(CompAuth) and CompAuth !has "pass", 1, 0)
| extend AuthSummary = strcat(
    "DKIM=", iff(isempty(DKIM), "unknown", DKIM),
    "; DMARC=", iff(isempty(DMARC), "unknown", DMARC),
    "; SPF=", iff(isempty(SPF), "unknown", SPF),
    "; CompAuth=", iff(isempty(CompAuth), "unknown", CompAuth)
)
| extend
    SenderFamiliarity = case(
        SenderSeenCount == 0, "new sender in baseline",
        SenderDaysSeen <= 1, "rare sender",
        SenderDaysSeen <= 5, "occasional sender",
        "familiar sender"
    ),
    SenderDomainFamiliarity = case(
        SenderDomainSeenCount == 0, "new sender domain in baseline",
        SenderDomainDaysSeen <= 1, "rare sender domain",
        SenderDomainDaysSeen <= 5, "occasional sender domain",
        "familiar sender domain"
    ),
    SenderRecipientFamiliarity = case(
        SenderRecipientSeenCount == 0, "first observed sender-recipient relationship",
        SenderRecipientDaysSeen <= 1, "rare sender-recipient relationship",
        SenderRecipientDaysSeen <= 5, "occasional sender-recipient relationship",
        "familiar sender-recipient relationship"
    ),
    UrlDomainFamiliarity = case(
        UrlCount == 0, "no URLs observed",
        UrlDomainSeenCountTotal == 0, "new URL domain(s) in baseline",
        UrlDomainDaysSeenMax <= 1, "rare URL domain(s)",
        UrlDomainDaysSeenMax <= 5, "occasional URL domain(s)",
        "familiar URL domain(s)"
    ),
    AttachmentHashFamiliarity = case(
        AttachmentCount == 0, "no attachments observed",
        array_length(AttachmentSHA256s) == 0, "attachment hash not available",
        AttachmentHashSeenCountTotal == 0, "new attachment hash(es) in baseline",
        AttachmentHashDaysSeenMax <= 1, "rare attachment hash(es)",
        AttachmentHashDaysSeenMax <= 5, "occasional attachment hash(es)",
        "familiar attachment hash(es)"
    )
| extend
    IsNewSender = SenderSeenCount == 0,
    IsNewSenderDomain = SenderDomainSeenCount == 0,
    IsFirstContact = SenderRecipientSeenCount == 0,
    HasAuthFailure = AuthFailCount > 0,
    HasUrls = UrlCount > 0,
    HasRareUrlDomain = UrlCount > 0 and array_length(RareUrlDomains) > 0,
    HasAttachments = AttachmentCount > 0,
    HasNewAttachmentHash = AttachmentCount > 0 and array_length(NewOrRareAttachmentHashes) > 0,
    HasRiskyAttachmentType = array_length(RiskyAttachmentTypes) > 0,
    HasThreatVerdict = isnotempty(ThreatTypesSafe) or isnotempty(ThreatNamesSafe) or isnotempty(DetectionMethodsSafe),
    HasUrlThreatVerdict = array_length(UrlThreatTypes) > 0 or array_length(UrlThreatNames) > 0,
    HasAttachmentThreatVerdict = array_length(AttachmentThreatTypes) > 0 or array_length(AttachmentThreatNames) > 0,
    HasClick = ClickCount > 0,
    HasPostDeliveryAction = PostDeliveryEventCount > 0,
    WasQuarantinedOrBlocked = DeliveryActionSafe has_any ("Blocked", "Block", "Quarantine", "Junk") or DeliveryLocationSafe has_any ("Quarantine", "Junk", "Deleted"),
    WasDeliveredToUser = DeliveryActionSafe has_any ("Delivered", "Deliver") or DeliveryLocationSafe has_any ("Inbox", "Junk"),
    BroadRecipientSpread = SimilarRecipients >= 5
| extend
    EmailShape = case(
        HasClick and (HasThreatVerdict or HasUrlThreatVerdict or HasAttachmentThreatVerdict), "delivered/clicked message with threat indicators",
        HasClick, "delivered and clicked message",
        WasQuarantinedOrBlocked and not(HasClick), "blocked/quarantined message with no click observed",
        IsFirstContact and HasUrls and HasAuthFailure, "first-contact sender with URL and auth failure",
        IsFirstContact and HasAttachments and HasAuthFailure, "first-contact sender with attachment and auth failure",
        BroadRecipientSpread and HasUrls, "broad-recipient message with URL",
        BroadRecipientSpread and HasAttachments, "broad-recipient message with attachment",
        IsFirstContact and HasUrls, "first-contact sender with URL",
        IsFirstContact and HasAttachments, "first-contact sender with attachment",
        HasAuthFailure, "auth-failed email",
        HasUrls, "email with URL",
        HasAttachments, "email with attachment",
        "familiar/low-signal email shape"
    )
| extend BehaviouralFlags = strcat_array(array_concat(
    iff(IsNewSender, pack_array("NEW_SENDER"), dynamic([])),
    iff(IsNewSenderDomain, pack_array("NEW_SENDER_DOMAIN"), dynamic([])),
    iff(IsFirstContact, pack_array("FIRST_CONTACT_TO_RECIPIENT"), dynamic([])),
    iff(HasAuthFailure, pack_array("AUTH_FAILURE"), dynamic([])),
    iff(HasUrls, pack_array("URL_PRESENT"), dynamic([])),
    iff(HasRareUrlDomain, pack_array("RARE_URL_DOMAIN"), dynamic([])),
    iff(HasAttachments, pack_array("ATTACHMENT_PRESENT"), dynamic([])),
    iff(HasNewAttachmentHash, pack_array("NEW_OR_RARE_ATTACHMENT_HASH"), dynamic([])),
    iff(HasRiskyAttachmentType, pack_array("RISKY_ATTACHMENT_TYPE"), dynamic([])),
    iff(HasThreatVerdict, pack_array("EMAIL_THREAT_VERDICT_PRESENT"), dynamic([])),
    iff(HasUrlThreatVerdict, pack_array("URL_THREAT_VERDICT_PRESENT"), dynamic([])),
    iff(HasAttachmentThreatVerdict, pack_array("ATTACHMENT_THREAT_VERDICT_PRESENT"), dynamic([])),
    iff(WasDeliveredToUser, pack_array("DELIVERED_TO_USER"), dynamic([])),
    iff(WasQuarantinedOrBlocked, pack_array("BLOCKED_OR_QUARANTINED"), dynamic([])),
    iff(HasPostDeliveryAction, pack_array("POST_DELIVERY_ACTION"), dynamic([])),
    iff(HasClick, pack_array("USER_CLICK_OBSERVED"), dynamic([])),
    iff(BroadRecipientSpread, pack_array("BROAD_RECIPIENT_SPREAD"), dynamic([]))
), " | ")
| extend ThreatScore =
    0
    + iff(IsNewSender, 10, 0)
    + iff(IsNewSenderDomain, 10, 0)
    + iff(IsFirstContact, 10, 0)
    + iff(HasAuthFailure, 20, 0)
    + iff(HasRareUrlDomain, 15, 0)
    + iff(HasNewAttachmentHash, 15, 0)
    + iff(HasRiskyAttachmentType, 20, 0)
    + iff(HasThreatVerdict, 30, 0)
    + iff(HasUrlThreatVerdict, 25, 0)
    + iff(HasAttachmentThreatVerdict, 25, 0)
    + iff(BroadRecipientSpread, 10, 0),
    ExposureScore =
    0
    + iff(HasClick, 40, 0)
    + iff(WasDeliveredToUser and not(WasQuarantinedOrBlocked), 20, 0)
    + iff(BroadRecipientSpread, 15, 0)
    + iff(HasPostDeliveryAction, -10, 0)
    + iff(WasQuarantinedOrBlocked and not(HasClick), -20, 0)
| extend
    ThreatConcern = case(
        ThreatScore >= 70, "High",
        ThreatScore >= 40, "Medium",
        ThreatScore >= 20, "Low",
        "Limited"
    ),
    ExposureConcern = case(
        HasClick, "High",
        ExposureScore >= 30, "Medium",
        WasQuarantinedOrBlocked and not(HasClick), "Low",
        ExposureScore >= 10, "Low",
        "Limited"
    )
| extend
    _determination = strcat("- Determination: ", case(
        HasClick and ThreatConcern in ("High", "Medium"),
            "user interaction observed with suspicious email context. Deep dive/user impact review recommended.",
        ThreatConcern == "High" and ExposureConcern in ("Medium", "High"),
            "high threat concern with meaningful user exposure. Deep dive/remediation review recommended.",
        ThreatConcern == "High" and ExposureConcern in ("Low", "Limited"),
            "high threat concern but exposure appears limited. Validate quarantine/remediation state.",
        ThreatConcern == "Medium" and ExposureConcern in ("Medium", "High"),
            "review required. Validate sender legitimacy, URLs/attachments, delivery state and user interaction.",
        ThreatConcern == "Medium",
            "medium threat concern. Validate expected sender/message context and remediation state.",
        ThreatConcern == "Low",
            "low concern. Validate expected sender/message context.",
        "limited suspicious signals in scoped telemetry."
    )),
    // --- Per-line narrative builders ---
    // Each output line is a standalone computed column so the assembler
    // can order them by verdict-bearing. Branch text preserved verbatim
    // from the prior single-line builders; only the splitting and the
    // per-line emission is new. "in baseline" suffix dropped from
    // familiarity lines — baseline window stated once at the meta tier.
    // Tier A — verdict-driving
    _line_emailShape = strcat("- Email shape: ", EmailShape, "."),
    _line_threatExposure = strcat("- Threat concern: ", ThreatConcern, " | Exposure concern: ", ExposureConcern, "."),
    _line_urlClicks = iff(ClickCount == 0,
        "- URL clicks: none observed.",
        strcat("- URL clicks: ", tostring(ClickCount), " observed across ", tostring(ClickUsers), " user(s); actions: ", tostring(ClickActions), "; clicker identifiers and clicked URLs captured in the Entities block.")
    ),
    // Threat indicators: empty-field suppression per rule 4 on the populated
    // branch; deliberate-negative phrasing kept when no verdict recorded.
    _line_threatIndicators = iff(HasThreatVerdict,
        strcat("- Threat indicators: ", strcat_array(array_concat(
            iff(isnotempty(ThreatTypesSafe),      pack_array(strcat("ThreatTypes=", ThreatTypesSafe)), dynamic([])),
            iff(isnotempty(ThreatNamesSafe),      pack_array(strcat("ThreatNames=", ThreatNamesSafe)), dynamic([])),
            iff(isnotempty(DetectionMethodsSafe), pack_array(strcat("DetectionMethods=", DetectionMethodsSafe)), dynamic([]))
        ), "; "), "."),
        "- Threat indicators: none recorded on EmailEvents."
    ),
    // Auth summary: empty-field suppression per rule 4 — replaces the
    // prior "unknown" filler tokens. Named fallback when all four empty.
    _line_authSummary = case(
        isempty(DKIM) and isempty(DMARC) and isempty(SPF) and isempty(CompAuth),
            "- Auth summary: no auth verdicts recorded.",
        strcat("- Auth summary: ", strcat_array(array_concat(
            iff(isnotempty(DKIM),     pack_array(strcat("DKIM=", DKIM)),         dynamic([])),
            iff(isnotempty(DMARC),    pack_array(strcat("DMARC=", DMARC)),       dynamic([])),
            iff(isnotempty(SPF),      pack_array(strcat("SPF=", SPF)),           dynamic([])),
            iff(isnotempty(CompAuth), pack_array(strcat("CompAuth=", CompAuth)), dynamic([]))
        ), "; "), ".")
    ),
    _line_riskyAttachmentTypes = iff(array_length(RiskyAttachmentTypes) == 0,
        "- Risky attachment types: none observed.",
        strcat("- Risky attachment types: ", tostring(RiskyAttachmentTypes), ".")
    ),
    // Delivery posture: empty-field suppression per rule 4. Two-field
    // both-populated case uses Field=Value pairs parallel to Auth summary
    // above; single-survivor cases relabel the line header. Named
    // fallback when both empty.
    _line_deliveryPosture = case(
        isempty(DeliveryActionSafe) and isempty(DeliveryLocationSafe),
            "- Delivery posture: not recorded.",
        isnotempty(DeliveryActionSafe) and isnotempty(DeliveryLocationSafe),
            strcat("- Delivery posture: action=", DeliveryActionSafe, "; location=", DeliveryLocationSafe, "."),
        isnotempty(DeliveryActionSafe),
            strcat("- Delivery action: ", DeliveryActionSafe, "."),
        strcat("- Delivery location: ", DeliveryLocationSafe, ".")
    ),
    // Tier B — corroborating
    _line_senderPrev = strcat("- Sender prevalence: ", SenderFamiliarity,
        iff(SenderSeenCount > 0,
            strcat("; ", tostring(SenderSeenCount), " prior event(s) across ", tostring(SenderDaysSeen), " day(s)"),
            ""),
        "."),
    _line_senderDomainPrev = strcat("- Sender domain prevalence: ", SenderDomainFamiliarity,
        iff(SenderDomainSeenCount > 0,
            strcat("; ", tostring(SenderDomainSeenCount), " prior event(s) across ", tostring(SenderDomainDaysSeen), " day(s)"),
            ""),
        "."),
    _line_senderRecipRel = strcat("- Sender-recipient relationship: ", SenderRecipientFamiliarity,
        iff(SenderRecipientSeenCount > 0,
            strcat("; ", tostring(SenderRecipientSeenCount), " prior event(s)"),
            ""),
        "."),
    _line_urls = iff(UrlCount == 0,
        "- URLs: none observed.",
        strcat("- URLs: ", tostring(UrlCount), " observed; URL domain familiarity: ", UrlDomainFamiliarity, "; URL domains captured in the Entities block.")
    ),
    _line_attachments = iff(AttachmentCount == 0,
        "- Attachments: none observed.",
        strcat("- Attachments: ", tostring(AttachmentCount), " observed; attachment hash familiarity: ", AttachmentHashFamiliarity, "; file names and hashes captured in the Entities block.")
    ),
    _line_similarSpread = iff(SimilarEvents == 0,
        "- Similar message spread: none observed in lookback.",
        strcat("- Similar message spread: ", tostring(SimilarRecipients), " recipient(s), ", tostring(SimilarNetworkMessageIds), " message id(s), ", tostring(SimilarEvents), " event(s) in lookback.")
    ),
    _line_postDelivery = iff(PostDeliveryEventCount == 0,
        "- Post-delivery events: none observed.",
        strcat("- Post-delivery events: ", tostring(PostDeliveryEventCount), " observed; actions: ", tostring(PostDeliveryActions), ".")
    ),
    _line_direction = iff(isnotempty(EmailDirectionSafe),
        strcat("- Direction: ", EmailDirectionSafe, "."),
        ""),
    _line_entityPointerEnvelope = "- Target message id, recipient, sender, sender mail-from, sender display name and subject captured in the Entities block.",
    _line_entityPointerSenderIp = "- Sender IP captured in the Entities block.",
    // Tier M — meta / query-scope
    // Behavioural flags is a recap of signals already expressed in the
    // verdict-driving lines above (threat verdict, auth failure, risky
    // attachment, etc.); it sits in the meta tier as a one-line summary,
    // not as a verdict driver.
    _line_reviewedHeader = "- Email activity reviewed.",
    _line_emailEventTime = strcat("- Email event time: ", tostring(EventTime), "."),
    _line_searchLookback = strcat("- Search lookback: ", humanTimespan(SearchLookback), "."),
    _line_baselineWindow = strcat("- Baseline window: ", BaselineLabel, "."),
    _line_behaviouralFlags = strcat("- Behavioural flags: ", iff(isempty(BehaviouralFlags), "none", BehaviouralFlags), "."),
    _line_generated = strcat("- Generated: ", format_datetime(now(), "yyyy-MM-dd HH:mm"), " UTC")
//
// --- Verdict-class + Analyst assessment ---
// Derived in parallel from the same computed signals as _determination —
// never parsed from the determination text. Branch order mirrors
// _determination so a signal change updates both case-expressions in
// lockstep. Analyst assessment is branch-aware: the user-click branch
// and the high-threat + meaningful-exposure branch each get their own
// sentence; the review branches keep theirs; benign branches stay empty.
| extend
    _verdictClass = case(
        HasClick and ThreatConcern in ("High", "Medium"),
            "escalation",
        ThreatConcern == "High" and ExposureConcern in ("Medium", "High"),
            "escalation",
        ThreatConcern == "High" and ExposureConcern in ("Low", "Limited"),
            "review",
        ThreatConcern == "Medium" and ExposureConcern in ("Medium", "High"),
            "review",
        ThreatConcern == "Medium",
            "review",
        ThreatConcern == "Low",
            "benign",
        "benign"
    ),
    _analystAssessment = case(
        HasClick and ThreatConcern in ("High", "Medium"),
            "- Analyst assessment: user interaction observed with suspicious email content. Confirm whether any clicker entered credentials, opened an attachment, or otherwise interacted with the message, and review their downstream account posture for signs of follow-on compromise.",
        ThreatConcern == "High" and ExposureConcern in ("Medium", "High"),
            "- Analyst assessment: high threat indicators with meaningful user exposure. Confirm quarantine, soft-delete and remediation state across every recipient in the campaign before closing.",
        ThreatConcern == "High" and ExposureConcern in ("Low", "Limited"),
            "- Analyst assessment: high threat indicators but exposure appears limited. Verify the message was quarantined or removed and that no recipient interacted with it.",
        ThreatConcern == "Medium" and ExposureConcern in ("Medium", "High"),
            "- Analyst assessment: medium threat with meaningful user exposure. Validate sender legitimacy, URL/attachment context, delivery state and whether any user interaction occurred.",
        ThreatConcern == "Medium",
            "- Analyst assessment: medium threat with limited exposure. Validate expected sender/message context and confirm the message was contained.",
        ThreatConcern == "Low",
            "",
        ""
    )
//
// --- Assemble (closure-only; verdict-first; verdict-bearing tiers) ---
// Architecture: narrative-gen produces the Actions-taken body only.
// Escalation verdicts prepend the literal header
//     --- ESCALATE ---
// Benign verdicts append the fixed closure insignia line, character
// for character. Review verdicts get neither.
| extend InvestigationNarrative = strcat_array(array_concat(
    iff(_verdictClass == "escalation", pack_array("--- ESCALATE ---"), dynamic([])),
    pack_array(_determination),
    iff(isnotempty(_analystAssessment), pack_array(_analystAssessment), dynamic([])),
    // Tier A — verdict-driving
    pack_array(_line_emailShape, _line_threatExposure, _line_urlClicks,
               _line_threatIndicators, _line_authSummary,
               _line_riskyAttachmentTypes, _line_deliveryPosture),
    // Tier B — corroborating posture
    pack_array(_line_senderPrev, _line_senderDomainPrev, _line_senderRecipRel,
               _line_urls, _line_attachments, _line_similarSpread, _line_postDelivery),
    iff(isnotempty(_line_direction), pack_array(_line_direction), dynamic([])),
    pack_array(_line_entityPointerEnvelope, _line_entityPointerSenderIp),
    // Tier M — meta / query-scope
    pack_array(_line_reviewedHeader, _line_emailEventTime,
               _line_searchLookback, _line_baselineWindow,
               _line_behaviouralFlags, _line_generated),
    // Closure insignia — benign only, hardcoded literal
    iff(_verdictClass == "benign",
        pack_array("Totality of context facilitates no further investigation, converges benign. Closing as such."),
        dynamic([]))
), "\n")
| project InvestigationNarrative
