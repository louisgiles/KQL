// name:              Email Quick Dive + Narrative
// purpose:           Fast single-message triage for email alerts.
//                    Outputs sender/auth posture, prevalence, URL/attachment context,
//                    delivery/remediation/click exposure, behavioural flags, and paste-ready note.
// starting_entities: NetworkMessageId, SenderFromAddress, RecipientEmailAddress, Subject
// required_tables:   EmailEvents
// optional_tables:   EmailAttachmentInfo, EmailUrlInfo, EmailPostDeliveryEvents, UrlClickEvents
// variables:         NetworkMessageIdToCheck, SenderToCheck, RecipientToCheck, SubjectToCheck, SearchLookback, BaselineWindow
// done_criteria:     Target email identified; sender/domain/recipient prevalence reviewed; authentication reviewed;
//                    URL/attachment prevalence reviewed; delivery/remediation/click exposure reviewed;
//                    threat concern and exposure concern separated.
// output_type:       quick-triage
//
// Design:
// Email quick-dive is a decision gate.
// It separates threat concern from exposure concern.
// A quarantined suspicious email is not the same as a delivered and clicked suspicious email.

let NetworkMessageIdToCheck = "";
let SenderToCheck = "";
let RecipientToCheck = "";
let SubjectToCheck = "";
let SearchLookback = 30d;
let BaselineWindow = 90d;
let BaselineLabel = "90d";
//
// ============================================================================
// Target message
// ============================================================================
let CandidateEmails = materialize(
    EmailEvents
    | extend EventTime = coalesce(
        column_ifexists("Timestamp", datetime(null)),
        column_ifexists("TimeGenerated", datetime(null))
    )
    | where EventTime >= ago(SearchLookback)
    | where isempty(NetworkMessageIdToCheck) or NetworkMessageId == NetworkMessageIdToCheck
    | where isempty(SenderToCheck) or SenderFromAddress contains SenderToCheck
    | where isempty(RecipientToCheck) or RecipientEmailAddress contains RecipientToCheck
    | where isempty(SubjectToCheck) or Subject contains SubjectToCheck
    | extend
        Sender = tolower(tostring(SenderFromAddress)),
        SenderDomain = tolower(extract(@"@([^@]+)$", 1, tostring(SenderFromAddress))),
        Recipient = tolower(tostring(RecipientEmailAddress)),
        AuthJson = parse_json(tostring(AuthenticationDetails)),
        DKIM = tolower(tostring(AuthJson.DKIM)),
        DMARC = tolower(tostring(AuthJson.DMARC)),
        SPF = tolower(tostring(AuthJson.SPF)),
        CompAuth = tolower(tostring(AuthJson.CompAuth)),
        SenderMailFromAddressSafe = tostring(column_ifexists("SenderMailFromAddress", "")),
        SenderIPv4Safe = tostring(column_ifexists("SenderIPv4", "")),
        DeliveryActionSafe = tostring(column_ifexists("DeliveryAction", "")),
        DeliveryLocationSafe = tostring(column_ifexists("DeliveryLocation", "")),
        ThreatTypesSafe = tostring(column_ifexists("ThreatTypes", "")),
        ThreatNamesSafe = tostring(column_ifexists("ThreatNames", "")),
        DetectionMethodsSafe = tostring(column_ifexists("DetectionMethods", "")),
        EmailDirectionSafe = tostring(column_ifexists("EmailDirection", "")),
        OrgLevelActionSafe = tostring(column_ifexists("OrgLevelAction", "")),
        UserLevelActionSafe = tostring(column_ifexists("UserLevelAction", "")),
        BulkComplaintLevelSafe = tostring(column_ifexists("BulkComplaintLevel", ""))
);
// Prefer one target message. NetworkMessageId is the preferred input.
let TargetEmail = materialize(
    CandidateEmails
    | top 1 by EventTime desc
);
let TargetTime = toscalar(TargetEmail | project EventTime);
let TargetNetworkMessageId = toscalar(TargetEmail | project NetworkMessageId);
let TargetSender = toscalar(TargetEmail | project Sender);
let TargetSenderDomain = toscalar(TargetEmail | project SenderDomain);
let TargetRecipient = toscalar(TargetEmail | project Recipient);
//
// ============================================================================
// Historical sender / domain / relationship baseline
// ============================================================================
let HistoricalEmail = materialize(
    EmailEvents
    | extend EventTime = coalesce(
        column_ifexists("Timestamp", datetime(null)),
        column_ifexists("TimeGenerated", datetime(null))
    )
    | where EventTime between (TargetTime - BaselineWindow .. TargetTime - 1h)
    | extend
        Sender = tolower(tostring(SenderFromAddress)),
        SenderDomain = tolower(extract(@"@([^@]+)$", 1, tostring(SenderFromAddress))),
        Recipient = tolower(tostring(RecipientEmailAddress))
);
let SenderBaseline =
    HistoricalEmail
    | where Sender == TargetSender
    | summarize
        SenderSeenCount=count(),
        SenderDaysSeen=dcount(bin(EventTime, 1d)),
        SenderRecipientsSeen=dcount(Recipient),
        SenderFirstSeen=min(EventTime),
        SenderLastSeen=max(EventTime)
        by Sender;
let SenderDomainBaseline =
    HistoricalEmail
    | where SenderDomain == TargetSenderDomain
    | summarize
        SenderDomainSeenCount=count(),
        SenderDomainDaysSeen=dcount(bin(EventTime, 1d)),
        SenderDomainRecipientsSeen=dcount(Recipient),
        SenderDomainSendersSeen=dcount(Sender),
        SenderDomainFirstSeen=min(EventTime),
        SenderDomainLastSeen=max(EventTime)
        by SenderDomain;
let SenderRecipientBaseline =
    HistoricalEmail
    | where Sender == TargetSender
    | where Recipient == TargetRecipient
    | summarize
        SenderRecipientSeenCount=count(),
        SenderRecipientDaysSeen=dcount(bin(EventTime, 1d)),
        SenderRecipientFirstSeen=min(EventTime),
        SenderRecipientLastSeen=max(EventTime)
        by Sender, Recipient;
//
// ============================================================================
// Recipient spread
// ============================================================================
let RecipientSpread =
    EmailEvents
    | extend EventTime = coalesce(
        column_ifexists("Timestamp", datetime(null)),
        column_ifexists("TimeGenerated", datetime(null))
    )
    | where EventTime between (TargetTime - SearchLookback .. TargetTime + 1h)
    | extend
        Sender = tolower(tostring(SenderFromAddress)),
        Recipient = tolower(tostring(RecipientEmailAddress))
    | where NetworkMessageId == TargetNetworkMessageId or Sender == TargetSender
    | summarize
        SameMessageRecipientCount=dcountif(Recipient, NetworkMessageId == TargetNetworkMessageId),
        SenderRecipientCount=dcountif(Recipient, Sender == TargetSender),
        SameMessageRecipients=make_set_if(Recipient, NetworkMessageId == TargetNetworkMessageId, 50)
        by Sender;
//
// ============================================================================
// URL context and URL domain prevalence
// ============================================================================
let TargetUrls = materialize(
    union isfuzzy=true
    (
        EmailUrlInfo
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where EventTime between (TargetTime - SearchLookback .. TargetTime + 1h)
        | where NetworkMessageId == TargetNetworkMessageId
        | extend
            UrlSafe = tostring(column_ifexists("Url", "")),
            UrlDomainSafe = tolower(tostring(column_ifexists("UrlDomain", ""))),
            UrlThreatTypes = tostring(column_ifexists("ThreatTypes", "")),
            UrlThreatNames = tostring(column_ifexists("ThreatNames", ""))
        | extend UrlDomainSafe = iff(
            isempty(UrlDomainSafe),
            tolower(extract(@"^(?:https?://)?([^/:?#]+)", 1, UrlSafe)),
            UrlDomainSafe
        )
        | where isnotempty(UrlSafe) or isnotempty(UrlDomainSafe)
        | project EventTime, NetworkMessageId, UrlSafe, UrlDomainSafe, UrlThreatTypes, UrlThreatNames
    )
);
let TargetUrlDomains = toscalar(TargetUrls | where isnotempty(UrlDomainSafe) | summarize make_set(UrlDomainSafe, 100));
let UrlSummary =
    TargetUrls
    | summarize
        UrlCount=dcount(UrlSafe),
        UrlDomains=make_set(UrlDomainSafe, 50),
        Urls=make_set(UrlSafe, 50),
        UrlThreatTypes=make_set(UrlThreatTypes, 20),
        UrlThreatNames=make_set(UrlThreatNames, 20)
        by NetworkMessageId;
let UrlDomainBaseline =
    union isfuzzy=true
    (
        EmailUrlInfo
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where EventTime between (TargetTime - BaselineWindow .. TargetTime - 1h)
        | extend
            UrlSafe = tostring(column_ifexists("Url", "")),
            UrlDomainSafe = tolower(tostring(column_ifexists("UrlDomain", ""))),
            RecipientSafe = tolower(tostring(column_ifexists("RecipientEmailAddress", "")))
        | extend UrlDomainSafe = iff(
            isempty(UrlDomainSafe),
            tolower(extract(@"^(?:https?://)?([^/:?#]+)", 1, UrlSafe)),
            UrlDomainSafe
        )
        | where UrlDomainSafe in (TargetUrlDomains)
        | summarize
            UrlDomainSeenCount=count(),
            UrlDomainDaysSeen=dcount(bin(EventTime, 1d)),
            UrlDomainRecipientsSeen=dcount(RecipientSafe)
            by UrlDomainSafe
    );
let UrlDomainBaselineSummary =
    UrlDomainBaseline
    | summarize
        RareUrlDomains=make_set_if(UrlDomainSafe, UrlDomainSeenCount == 0 or UrlDomainDaysSeen <= 1, 50),
        UrlDomainSeenCountTotal=sum(UrlDomainSeenCount),
        UrlDomainDaysSeenMax=max(UrlDomainDaysSeen),
        UrlDomainRecipientsSeenTotal=sum(UrlDomainRecipientsSeen);
//
// ============================================================================
// Attachment context and attachment prevalence
// ============================================================================
let TargetAttachments = materialize(
    union isfuzzy=true
    (
        EmailAttachmentInfo
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where EventTime between (TargetTime - SearchLookback .. TargetTime + 1h)
        | where NetworkMessageId == TargetNetworkMessageId
        | extend
            FileNameSafe = tostring(column_ifexists("FileName", "")),
            SHA256Safe = tostring(column_ifexists("SHA256", "")),
            FileTypeSafe = tolower(tostring(column_ifexists("FileType", ""))),
            AttachmentThreatTypes = tostring(column_ifexists("ThreatTypes", "")),
            AttachmentThreatNames = tostring(column_ifexists("ThreatNames", ""))
        | extend FileExt = tolower(extract(@"\.([^\.\\\/]+)$", 1, FileNameSafe))
        | extend AttachmentType = iff(isnotempty(FileTypeSafe), FileTypeSafe, FileExt)
        | where isnotempty(FileNameSafe) or isnotempty(SHA256Safe)
        | project EventTime, NetworkMessageId, FileNameSafe, SHA256Safe, AttachmentType, AttachmentThreatTypes, AttachmentThreatNames
    )
);
let TargetAttachmentHashes = toscalar(TargetAttachments | where isnotempty(SHA256Safe) | summarize make_set(SHA256Safe, 100));
let AttachmentSummary =
    TargetAttachments
    | summarize
        AttachmentCount=dcount(FileNameSafe),
        AttachmentNames=make_set(FileNameSafe, 50),
        AttachmentSHA256s=make_set(SHA256Safe, 50),
        AttachmentTypes=make_set(AttachmentType, 50),
        RiskyAttachmentTypes=make_set_if(AttachmentType, AttachmentType in (
            "html", "htm", "js", "jse", "vbs", "vbe", "wsf", "wsh",
            "lnk", "iso", "img", "exe", "scr", "dll", "bat", "cmd",
            "ps1", "zip", "rar", "7z", "one", "docm", "xlsm", "pptm"
        ), 50),
        AttachmentThreatTypes=make_set(AttachmentThreatTypes, 20),
        AttachmentThreatNames=make_set(AttachmentThreatNames, 20)
        by NetworkMessageId;
let AttachmentHashBaseline =
    union isfuzzy=true
    (
        EmailAttachmentInfo
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where EventTime between (TargetTime - BaselineWindow .. TargetTime - 1h)
        | extend
            SHA256Safe = tostring(column_ifexists("SHA256", "")),
            RecipientSafe = tolower(tostring(column_ifexists("RecipientEmailAddress", "")))
        | where isnotempty(SHA256Safe)
        | where SHA256Safe in (TargetAttachmentHashes)
        | summarize
            AttachmentHashSeenCount=count(),
            AttachmentHashDaysSeen=dcount(bin(EventTime, 1d)),
            AttachmentHashRecipientsSeen=dcount(RecipientSafe)
            by SHA256Safe
    );
let AttachmentHashBaselineSummary =
    AttachmentHashBaseline
    | summarize
        NewAttachmentHashes=make_set_if(SHA256Safe, AttachmentHashSeenCount == 0 or AttachmentHashDaysSeen <= 1, 50),
        AttachmentHashSeenCountTotal=sum(AttachmentHashSeenCount),
        AttachmentHashDaysSeenMax=max(AttachmentHashDaysSeen),
        AttachmentHashRecipientsSeenTotal=sum(AttachmentHashRecipientsSeen);
//
// ============================================================================
// Post-delivery remediation and user click context
// ============================================================================
let PostDelivery =
    union isfuzzy=true
    (
        EmailPostDeliveryEvents
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where EventTime between (TargetTime - SearchLookback .. TargetTime + 7d)
        | where NetworkMessageId == TargetNetworkMessageId
        | summarize
            PostDeliveryEventCount=count(),
            PostDeliveryActions=make_set(tostring(column_ifexists("ActionType", "")), 20),
            PostDeliveryResults=make_set(tostring(column_ifexists("ActionResult", "")), 20),
            LatestPostDeliveryEvent=max(EventTime)
            by NetworkMessageId
    );
let Clicks =
    union isfuzzy=true
    (
        UrlClickEvents
        | extend EventTime = coalesce(
            column_ifexists("Timestamp", datetime(null)),
            column_ifexists("TimeGenerated", datetime(null))
        )
        | where EventTime between (TargetTime - SearchLookback .. TargetTime + 7d)
        | where NetworkMessageId == TargetNetworkMessageId
        | summarize
            ClickCount=count(),
            ClickActions=make_set(tostring(column_ifexists("ActionType", "")), 20),
            ClickedUrls=make_set(tostring(column_ifexists("Url", "")), 20),
            LatestClick=max(EventTime)
            by NetworkMessageId
    );
//
// ============================================================================
// Final quick-dive output
// ============================================================================
TargetEmail
| join kind=leftouter SenderBaseline on Sender
| join kind=leftouter SenderDomainBaseline on SenderDomain
| join kind=leftouter SenderRecipientBaseline on Sender, Recipient
| join kind=leftouter RecipientSpread on Sender
| join kind=leftouter UrlSummary on NetworkMessageId
| extend _joinKey = 1
| join kind=leftouter (UrlDomainBaselineSummary | extend _joinKey = 1) on _joinKey
| join kind=leftouter AttachmentSummary on NetworkMessageId
| join kind=leftouter (AttachmentHashBaselineSummary | extend _joinKey = 1) on _joinKey
| join kind=leftouter PostDelivery on NetworkMessageId
| join kind=leftouter Clicks on NetworkMessageId
| extend
    SenderSeenCount=coalesce(SenderSeenCount, 0),
    SenderDaysSeen=coalesce(SenderDaysSeen, 0),
    SenderRecipientsSeen=coalesce(SenderRecipientsSeen, 0),
    SenderDomainSeenCount=coalesce(SenderDomainSeenCount, 0),
    SenderDomainDaysSeen=coalesce(SenderDomainDaysSeen, 0),
    SenderDomainRecipientsSeen=coalesce(SenderDomainRecipientsSeen, 0),
    SenderDomainSendersSeen=coalesce(SenderDomainSendersSeen, 0),
    SenderRecipientSeenCount=coalesce(SenderRecipientSeenCount, 0),
    SenderRecipientDaysSeen=coalesce(SenderRecipientDaysSeen, 0),
    SameMessageRecipientCount=coalesce(SameMessageRecipientCount, 0),
    SenderRecipientCount=coalesce(SenderRecipientCount, 0),
    UrlCount=coalesce(UrlCount, 0),
    UrlDomainSeenCountTotal=coalesce(UrlDomainSeenCountTotal, 0),
    UrlDomainDaysSeenMax=coalesce(UrlDomainDaysSeenMax, 0),
    UrlDomainRecipientsSeenTotal=coalesce(UrlDomainRecipientsSeenTotal, 0),
    AttachmentCount=coalesce(AttachmentCount, 0),
    AttachmentHashSeenCountTotal=coalesce(AttachmentHashSeenCountTotal, 0),
    AttachmentHashDaysSeenMax=coalesce(AttachmentHashDaysSeenMax, 0),
    AttachmentHashRecipientsSeenTotal=coalesce(AttachmentHashRecipientsSeenTotal, 0),
    PostDeliveryEventCount=coalesce(PostDeliveryEventCount, 0),
    ClickCount=coalesce(ClickCount, 0),
    UrlDomains=coalesce(UrlDomains, dynamic([])),
    Urls=coalesce(Urls, dynamic([])),
    RareUrlDomains=coalesce(RareUrlDomains, dynamic([])),
    AttachmentNames=coalesce(AttachmentNames, dynamic([])),
    AttachmentSHA256s=coalesce(AttachmentSHA256s, dynamic([])),
    AttachmentTypes=coalesce(AttachmentTypes, dynamic([])),
    RiskyAttachmentTypes=coalesce(RiskyAttachmentTypes, dynamic([])),
    NewAttachmentHashes=coalesce(NewAttachmentHashes, dynamic([])),
    PostDeliveryActions=coalesce(PostDeliveryActions, dynamic([])),
    PostDeliveryResults=coalesce(PostDeliveryResults, dynamic([])),
    ClickActions=coalesce(ClickActions, dynamic([])),
    ClickedUrls=coalesce(ClickedUrls, dynamic([]))
| extend
    SenderFamiliarity = case(
        SenderSeenCount == 0, "new sender in baseline",
        SenderDaysSeen <= 1, "rare sender",
        SenderDaysSeen <= 5, "occasional sender",
        "familiar sender"
    ),
    SenderDomainFamiliarity = case(
        SenderDomainSeenCount == 0, "new sender domain in baseline",
        SenderDomainDaysSeen <= 1, "rare sender domain",
        SenderDomainDaysSeen <= 5, "occasional sender domain",
        "familiar sender domain"
    ),
    SenderRecipientFamiliarity = case(
        SenderRecipientSeenCount == 0, "first observed sender-recipient relationship",
        SenderRecipientDaysSeen <= 1, "rare sender-recipient relationship",
        SenderRecipientDaysSeen <= 5, "occasional sender-recipient relationship",
        "familiar sender-recipient relationship"
    ),
    UrlDomainFamiliarity = case(
        UrlCount == 0, "no URLs observed",
        UrlDomainSeenCountTotal == 0, "new URL domain(s) in baseline",
        UrlDomainDaysSeenMax <= 1, "rare URL domain(s)",
        UrlDomainDaysSeenMax <= 5, "occasional URL domain(s)",
        "familiar URL domain(s)"
    ),
    AttachmentHashFamiliarity = case(
        AttachmentCount == 0, "no attachments observed",
        array_length(AttachmentSHA256s) == 0, "attachment hash not available",
        AttachmentHashSeenCountTotal == 0, "new attachment hash(es) in baseline",
        AttachmentHashDaysSeenMax <= 1, "rare attachment hash(es)",
        AttachmentHashDaysSeenMax <= 5, "occasional attachment hash(es)",
        "familiar attachment hash(es)"
    )
| extend
    AuthPassCount =
        iff(DKIM has "pass", 1, 0)
        + iff(DMARC has "pass", 1, 0)
        + iff(SPF has "pass", 1, 0)
        + iff(CompAuth has "pass", 1, 0),
    AuthFailCount =
        iff(isnotempty(DKIM) and DKIM !has "pass", 1, 0)
        + iff(isnotempty(DMARC) and DMARC !has "pass", 1, 0)
        + iff(isnotempty(SPF) and SPF !has "pass", 1, 0)
        + iff(isnotempty(CompAuth) and CompAuth !has "pass", 1, 0)
| extend AuthSummary = strcat(
    "DKIM=", iff(isempty(DKIM), "unknown", DKIM),
    "; DMARC=", iff(isempty(DMARC), "unknown", DMARC),
    "; SPF=", iff(isempty(SPF), "unknown", SPF),
    "; CompAuth=", iff(isempty(CompAuth), "unknown", CompAuth)
)
| extend
    IsNewSender = SenderSeenCount == 0,
    IsRareSender = SenderSeenCount == 0 or SenderDaysSeen <= 1,
    IsNewSenderDomain = SenderDomainSeenCount == 0,
    IsRareSenderDomain = SenderDomainSeenCount == 0 or SenderDomainDaysSeen <= 1,
    IsFirstContact = SenderRecipientSeenCount == 0,
    HasAuthFailure = AuthFailCount > 0,
    HasUrls = UrlCount > 0,
    HasRareUrlDomain = UrlCount > 0 and (UrlDomainSeenCountTotal == 0 or UrlDomainDaysSeenMax <= 1),
    HasAttachments = AttachmentCount > 0,
    HasNewAttachmentHash = AttachmentCount > 0 and array_length(AttachmentSHA256s) > 0 and (AttachmentHashSeenCountTotal == 0 or AttachmentHashDaysSeenMax <= 1),
    HasRiskyAttachmentType = array_length(RiskyAttachmentTypes) > 0,
    HasThreatVerdict = isnotempty(ThreatTypesSafe) or isnotempty(ThreatNamesSafe) or isnotempty(DetectionMethodsSafe),
    HasUrlThreatVerdict = array_length(UrlThreatTypes) > 0 or array_length(UrlThreatNames) > 0,
    HasAttachmentThreatVerdict = array_length(AttachmentThreatTypes) > 0 or array_length(AttachmentThreatNames) > 0,
    WasQuarantinedOrBlocked = DeliveryActionSafe has_any ("Blocked", "Block", "Quarantine", "Junk") or DeliveryLocationSafe has_any ("Quarantine", "Junk", "Deleted"),
    WasDeliveredToUser = DeliveryActionSafe has_any ("Delivered", "Deliver") or DeliveryLocationSafe has_any ("Inbox", "Junk"),
    HasPostDeliveryAction = PostDeliveryEventCount > 0,
    HasClick = ClickCount > 0,
    BroadRecipientSpread = SameMessageRecipientCount >= 5 or SenderRecipientCount >= 20
| extend
    EmailShape = case(
        HasClick and (HasThreatVerdict or HasUrlThreatVerdict or HasAttachmentThreatVerdict),
            "delivered/clicked message with threat indicators",
        HasClick,
            "delivered and clicked message",
        WasQuarantinedOrBlocked and not(HasClick),
            "blocked/quarantined message with no click observed",
        IsFirstContact and HasUrls and HasAuthFailure,
            "first-contact sender with URL and auth failure",
        IsFirstContact and HasAttachments and HasAuthFailure,
            "first-contact sender with attachment and auth failure",
        BroadRecipientSpread and HasUrls,
            "broad-recipient message with URL",
        BroadRecipientSpread and HasAttachments,
            "broad-recipient message with attachment",
        IsFirstContact and HasUrls,
            "first-contact sender with URL",
        IsFirstContact and HasAttachments,
            "first-contact sender with attachment",
        HasAuthFailure,
            "auth-failed email",
        HasUrls,
            "email with URL",
        HasAttachments,
            "email with attachment",
        "familiar/low-signal email shape"
    )
| extend BehaviouralFlags = strcat_array(array_concat(
    iff(IsNewSender, pack_array("NEW_SENDER"), dynamic([])),
    iff(IsRareSender and not(IsNewSender), pack_array("RARE_SENDER"), dynamic([])),
    iff(IsNewSenderDomain, pack_array("NEW_SENDER_DOMAIN"), dynamic([])),
    iff(IsRareSenderDomain and not(IsNewSenderDomain), pack_array("RARE_SENDER_DOMAIN"), dynamic([])),
    iff(IsFirstContact, pack_array("FIRST_CONTACT_TO_RECIPIENT"), dynamic([])),
    iff(HasAuthFailure, pack_array("AUTH_FAILURE"), dynamic([])),
    iff(HasUrls, pack_array("URL_PRESENT"), dynamic([])),
    iff(HasRareUrlDomain, pack_array("RARE_URL_DOMAIN"), dynamic([])),
    iff(HasAttachments, pack_array("ATTACHMENT_PRESENT"), dynamic([])),
    iff(HasNewAttachmentHash, pack_array("NEW_OR_RARE_ATTACHMENT_HASH"), dynamic([])),
    iff(HasRiskyAttachmentType, pack_array("RISKY_ATTACHMENT_TYPE"), dynamic([])),
    iff(HasThreatVerdict, pack_array("EMAIL_THREAT_VERDICT_PRESENT"), dynamic([])),
    iff(HasUrlThreatVerdict, pack_array("URL_THREAT_VERDICT_PRESENT"), dynamic([])),
    iff(HasAttachmentThreatVerdict, pack_array("ATTACHMENT_THREAT_VERDICT_PRESENT"), dynamic([])),
    iff(WasQuarantinedOrBlocked, pack_array("BLOCKED_OR_QUARANTINED"), dynamic([])),
    iff(HasPostDeliveryAction, pack_array("POST_DELIVERY_ACTION"), dynamic([])),
    iff(HasClick, pack_array("USER_CLICK_OBSERVED"), dynamic([])),
    iff(BroadRecipientSpread, pack_array("BROAD_RECIPIENT_SPREAD"), dynamic([]))
), " | ")
| extend ThreatScore =
    0
    + iff(IsNewSender, 10, 0)
    + iff(IsNewSenderDomain, 10, 0)
    + iff(IsFirstContact, 10, 0)
    + iff(HasAuthFailure, 20, 0)
    + iff(HasRareUrlDomain, 15, 0)
    + iff(HasUrls and not(HasRareUrlDomain), 5, 0)
    + iff(HasNewAttachmentHash, 15, 0)
    + iff(HasRiskyAttachmentType, 20, 0)
    + iff(HasAttachments and not(HasNewAttachmentHash) and not(HasRiskyAttachmentType), 5, 0)
    + iff(HasThreatVerdict, 30, 0)
    + iff(HasUrlThreatVerdict, 25, 0)
    + iff(HasAttachmentThreatVerdict, 25, 0)
    + iff(BroadRecipientSpread, 10, 0),
    ExposureScore =
    0
    + iff(HasClick, 40, 0)
    + iff(WasDeliveredToUser and not(WasQuarantinedOrBlocked), 20, 0)
    + iff(BroadRecipientSpread, 15, 0)
    + iff(HasPostDeliveryAction, -10, 0)
    + iff(WasQuarantinedOrBlocked and not(HasClick), -20, 0)
| extend
    ThreatConcern = case(
        ThreatScore >= 70, "High",
        ThreatScore >= 40, "Medium",
        ThreatScore >= 20, "Low",
        "Limited"
    ),
    ExposureConcern = case(
        HasClick, "High",
        ExposureScore >= 30, "Medium",
        WasQuarantinedOrBlocked and not(HasClick), "Low",
        ExposureScore >= 10, "Low",
        "Limited"
    )
| extend QuickAssessment = case(
    HasClick and ThreatConcern in ("High", "Medium"),
        "High exposure concern - user interaction observed. Run email deep dive and review user impact.",
    ThreatConcern == "High" and ExposureConcern in ("Medium", "High"),
        "High concern - suspicious message appears to have reached users. Deep dive recommended.",
    ThreatConcern == "High" and ExposureConcern in ("Low", "Limited"),
        "Threat concern is high but exposure appears limited. Validate remediation/quarantine state.",
    ThreatConcern == "Medium" and ExposureConcern in ("Medium", "High"),
        "Review closely - validate sender, URL/attachment legitimacy, delivery state and user interaction.",
    ThreatConcern == "Medium",
        "Medium threat concern - validate context and remediation state.",
    ThreatConcern == "Low",
        "Low concern - validate expected sender/message context.",
    "Limited suspicious signals in scoped telemetry."
)
| extend Narrative = strcat(
    "- Email quick triage completed.\n",
    "- Email shape: ", EmailShape, ".\n",
    "- Threat concern: ", ThreatConcern, ".\n",
    "- Exposure concern: ", ExposureConcern, ".\n",
    "- TimeGenerated: ", tostring(EventTime), "\n",
    "- NetworkMessageId: ", NetworkMessageId, "\n",
    "- Sender: ", SenderFromAddress, "\n",
    "- Sender mail-from: ", iff(isempty(SenderMailFromAddressSafe), "N/A", SenderMailFromAddressSafe), "\n",
    "- Sender IP: ", iff(isempty(SenderIPv4Safe), "N/A", SenderIPv4Safe), "\n",
    "- Sender display name: ", SenderDisplayName, "\n",
    "- Recipient: ", RecipientEmailAddress, "\n",
