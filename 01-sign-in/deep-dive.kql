// name:              Sign-In Triage & Risk Scoring Engine
// purpose:           Deep-dive triage of a specific user, IP, or device with a weighted risk score across nine sign-in signals.
// starting_entities: UPN, IPAddress, DeviceDetail (any or all)
// required_tables:   SigninLogs
// optional_tables:   IdentityInfo (job, manager, assigned roles), AuditLogs (new-starter detection)
// variables:         TimeToCheck, UserIdentityCheck, IPtoCheck, DeviceDetailtoCheck
// done_criteria:     Every elevated-score row explained (known travel, device change, etc.) or escalated; most recent sign-in classified against the four closure buckets.
// output_type:       analysis
//
// Sign-In Triage & Risk Scoring Investigation Query
// Deep-dive investigation tool for a specific user, IP address, or device.
// Enriches every sign-in event with frequency baselines (how many days each
// IP/device/location/app/user-agent has been seen), identity context from
// IdentityInfo (job title, risk level, assigned roles, manager), new-starter
// detection from AuditLogs, and a weighted risk scoring engine that flags
// anomalies across nine dimensions.
//
// Usage: Populate UserIdentityCheck, IPtoCheck, or DeviceDetailtoCheck to scope.
// Run this AFTER a detection query (queries 6-11) surfaces something worth investigating.
//
// Tables: SigninLogs, IdentityInfo, AuditLogs

// ------- parameters -------
let TimeToCheck = 30d;
let UserIdentityCheck = "";
let IPtoCheck = "";
let DeviceDetailtoCheck = "";
let IncludeNonInteractive = false;
//
// ------- signin source -------
let Signins = union isfuzzy=true
    (SigninLogs
    | where TimeGenerated >= ago(TimeToCheck)
    | project TimeGenerated, CreatedDateTime, UserPrincipalName, Identity, IPAddress,
        ResultType, ResultDescription,
        DeviceDetailStr = tostring(DeviceDetail),
        LocationDetailsStr = tostring(LocationDetails),
        UserAgent, AppDisplayName,
        RiskDetail, RiskEventTypes, RiskLevelDuringSignIn, RiskState,
        AuthenticationDetails = tostring(AuthenticationDetails),
        MfaDetail = tostring(MfaDetail),
        ConditionalAccessPolicies = tostring(ConditionalAccessPolicies),
        ConditionalAccessStatus, CorrelationId,
        SigninType = "Interactive"),
    (AADNonInteractiveUserSignInLogs
    | where IncludeNonInteractive
    | where TimeGenerated >= ago(TimeToCheck)
    | project TimeGenerated, CreatedDateTime, UserPrincipalName,
        Identity = tostring(column_ifexists("Identity", UserPrincipalName)),
        IPAddress, ResultType, ResultDescription,
        DeviceDetailStr = tostring(DeviceDetail),
        LocationDetailsStr = tostring(LocationDetails),
        UserAgent, AppDisplayName,
        RiskDetail,
        RiskEventTypes = tostring(column_ifexists("RiskEventTypes", "")),
        RiskLevelDuringSignIn, RiskState,
        AuthenticationDetails = tostring(AuthenticationDetails),
        MfaDetail = tostring(column_ifexists("MfaDetail", "")),
        ConditionalAccessPolicies = tostring(ConditionalAccessPolicies),
        ConditionalAccessStatus, CorrelationId,
        SigninType = "NonInteractive");
//
// ------- identity context -------
let Job = IdentityInfo
    | where TimeGenerated >= ago(90d)
    | where AccountUPN contains UserIdentityCheck
    | extend JoinUPN = tolower(AccountUPN)
    | summarize arg_max(TimeGenerated, JobTitle, RiskLevel, AssignedRoles, Manager) by JoinUPN
    | project JoinUPN, JobTitle, RiskLevel, AssignedRoles, Manager;
let NewStarterCheck = AuditLogs
    | where TimeGenerated >= ago(90d)
    | where OperationName == "Add user"
    | mv-expand TargetResources
    | where tostring(TargetResources.type) == "User"
    | extend NewStarterUPN = tolower(tostring(TargetResources.userPrincipalName))
    | where NewStarterUPN contains tolower(UserIdentityCheck)
    | mv-expand ModProp = TargetResources.modifiedProperties
    | summarize
        StartDate = max(ActivityDateTime),
        NewStarterJobTitle = take_anyif(tostring(parse_json(tostring(ModProp.newValue))[0]), tostring(ModProp.displayName) == "JobTitle")
        by NewStarterUPN;
//
// -------  org-wide IP prevalence -------
let OrgIPStats = materialize(
    Signins
    | summarize
        DaysIpSeenInOrg = dcountif(startofday(TimeGenerated), ResultType == "0"),
        OrgFailuresFromIP = countif(ResultType != "0"),
        UsersWIPCount = dcountif(Identity, ResultType == "0"),
        UsersWithThisIP = make_set_if(Identity, ResultType == "0", 20)
        by IPAddress
);
//
// ------- user familiarity baselines -------
let UserBase = materialize(
    Signins
    | where UserPrincipalName contains UserIdentityCheck
    | extend Day = startofday(TimeGenerated), IsSuccess = ResultType == "0"
    | extend DeviceParsed = parse_json(DeviceDetailStr), LocationParsed = parse_json(LocationDetailsStr)
    | extend
        DeviceKey = iff(isempty(tostring(DeviceParsed.deviceId)),
            strcat("unreg|", tostring(DeviceParsed.operatingSystem), "|", tostring(DeviceParsed.browser)),
            tostring(DeviceParsed.deviceId)),
        LocationKey = strcat(tostring(LocationParsed.city), "|", tostring(LocationParsed.state), "|", tostring(LocationParsed.countryOrRegion))
    | project Day, IsSuccess, IPAddress, DeviceKey, UserAgent, LocationKey, AppDisplayName
);
let IPDays = UserBase | summarize DaysIpSeenUser = dcountif(Day, IsSuccess) by IPAddress;
let DeviceDays = UserBase | summarize DeviceDayCount = dcountif(Day, IsSuccess) by DeviceKey;
let UADays = UserBase | summarize UserAgentDayCount = dcountif(Day, IsSuccess) by UserAgent;
let LocationDays = UserBase | summarize DaysLocationSeenUser = dcountif(Day, IsSuccess) by LocationKey;
let AppDays = UserBase | summarize AppDayCount = dcountif(Day, IsSuccess) by AppDisplayName;
//
// ------- main pipeline -------
Signins
| where UserPrincipalName contains UserIdentityCheck
| where IPAddress contains IPtoCheck
| where DeviceDetailStr contains DeviceDetailtoCheck
| extend JoinUPN = tolower(UserPrincipalName)
| extend DeviceParsed = parse_json(DeviceDetailStr), LocationParsed = parse_json(LocationDetailsStr)
| extend
    IsManaged = tostring(DeviceParsed.isManaged),
    IsCompliant = tostring(DeviceParsed.isCompliant),
    TrustType = tostring(DeviceParsed.trustType),
    DeviceOS = tostring(DeviceParsed.operatingSystem),
    DeviceBrowser = tostring(DeviceParsed.browser),
    DeviceDisplayName = tostring(DeviceParsed.displayName),
    DeviceKey = iff(isempty(tostring(DeviceParsed.deviceId)),
        strcat("unreg|", tostring(DeviceParsed.operatingSystem), "|", tostring(DeviceParsed.browser)),
        tostring(DeviceParsed.deviceId)),
    LocationKey = strcat(tostring(LocationParsed.city), "|", tostring(LocationParsed.state), "|", tostring(LocationParsed.countryOrRegion))
| join kind=leftouter OrgIPStats on IPAddress
| join kind=leftouter IPDays on IPAddress
| join kind=leftouter DeviceDays on DeviceKey
| join kind=leftouter UADays on UserAgent
| join kind=leftouter LocationDays on LocationKey
| join kind=leftouter AppDays on AppDisplayName
| join kind=leftouter NewStarterCheck on $left.JoinUPN == $right.NewStarterUPN
| join kind=leftouter Job on JoinUPN
| extend
    DaysIpSeenInOrg = coalesce(DaysIpSeenInOrg, 0),
    OrgFailuresFromIP = coalesce(OrgFailuresFromIP, 0),
    UsersWIPCount = coalesce(UsersWIPCount, 0),
    DaysIpSeenUser = coalesce(DaysIpSeenUser, 0),
    DeviceDayCount = coalesce(DeviceDayCount, 0),
    UserAgentDayCount = coalesce(UserAgentDayCount, 0),
    DaysLocationSeenUser = coalesce(DaysLocationSeenUser, 0),
    AppDayCount = coalesce(AppDayCount, 0)
| project-rename LogCreatedTime = TimeGenerated, EventTime = CreatedDateTime
//
// ------- risk scoring engine -------
| extend
    _ipOrgRisk = iff(DaysIpSeenInOrg <= 1, 30, 0),
    _ipUserRisk = iff(DaysIpSeenInOrg > 1 and DaysIpSeenUser <= 1, 10, 0),
    _deviceMgmtRisk = iff(IsManaged != "true", 25, 0),
    _deviceFamiliarityRisk = iff(DeviceDayCount <= 1, 15, 0),
    _uaRisk = iff(UserAgentDayCount <= 1, 10, 0),
    _locationRisk = iff(DaysLocationSeenUser <= 1, 10, 0),
    _appRisk = iff(AppDayCount <= 1, 5, 0),
    _aadRisk = iff(RiskLevelDuringSignIn in~ ("medium", "high") or RiskState =~ "atRisk", 20, 0),
    _sprayRisk = iff(OrgFailuresFromIP >= 20 and DaysIpSeenInOrg <= 1, 10, 0),
    _newStarterRisk = iff(isnotnull(StartDate) and StartDate > ago(14d), 5, 0)
| extend
    RiskScore = _ipOrgRisk + _ipUserRisk + _deviceMgmtRisk + _deviceFamiliarityRisk
        + _uaRisk + _locationRisk + _appRisk + _aadRisk + _sprayRisk + _newStarterRisk
| extend
    RiskFlags = strcat_array(array_concat(
        iff(_ipOrgRisk > 0, pack_array("IP_NEW_TO_ORG"), dynamic([])),
        iff(_ipUserRisk > 0, pack_array("IP_NEW_TO_USER"), dynamic([])),
        iff(_deviceMgmtRisk > 0, pack_array("UNMANAGED_DEVICE"), dynamic([])),
        iff(_deviceFamiliarityRisk > 0, pack_array("DEVICE_NEW_TO_USER"), dynamic([])),
        iff(_uaRisk > 0, pack_array("UA_NEW_TO_USER"), dynamic([])),
        iff(_locationRisk > 0, pack_array("LOCATION_NEW_TO_USER"), dynamic([])),
        iff(_appRisk > 0, pack_array("APP_NEW_TO_USER"), dynamic([])),
        iff(_aadRisk > 0, pack_array("AAD_RISK_FLAGGED"), dynamic([])),
        iff(_sprayRisk > 0, pack_array("IP_FAIL_HEAVY"), dynamic([])),
        iff(_newStarterRisk > 0, pack_array("NEW_STARTER"), dynamic([]))
    ), " | ")
| extend
    TriageVerdict = case(
        RiskScore >= 55, "🔴 HIGH-RISK",
        RiskScore >= 35, "🟠 MEDIUM-RISK",
        RiskScore >= 15, "🟡 LOW-RISK",
        "🟢 LIKELY BENIGN"
    )
//
// ------- output -------
| project
    TriageVerdict, RiskScore, RiskFlags, SigninType,
    EventTime, LogCreatedTime,
    IsManaged, IsCompliant, TrustType,
    RiskLevelDuringSignIn, RiskState, RiskDetail, RiskEventTypes,
    UsersWIPCount, UsersWithThisIP,
    StartDate, NewStarterJobTitle,
    UserPrincipalName, Identity, JobTitle, RiskLevel, AssignedRoles, Manager,
    IPAddress, DaysIpSeenInOrg, DaysIpSeenUser, OrgFailuresFromIP,
    ResultType, ResultDescription,
    AppDayCount, AppDisplayName,
    DaysLocationSeenUser, LocationKey,
    AuthenticationDetails,
    DeviceDayCount, DeviceDisplayName, DeviceOS, DeviceBrowser, DeviceKey, DeviceDetailStr,
    UserAgentDayCount, UserAgent,
    MfaDetail, ConditionalAccessPolicies, ConditionalAccessStatus,
    CorrelationId
| sort by EventTime desc
