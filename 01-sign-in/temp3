SigninLogs
| where UserPrincipalName =~ "<same UPN>"
| extend EventTime = coalesce(CreatedDateTime, TimeGenerated)
| where EventTime between (
    datetime(2026-06-20T17:20:00Z) ..
    datetime(2026-06-20T17:22:00Z)
)
| project
    EventTime,
    CreatedDateTime,
    TimeGenerated,
    Id,
    OriginalRequestId,
    CorrelationId,
    AppDisplayName
| sort by TimeGenerated asc