let TargetUPN = "<upn>";
let AnchorTime = now();
// ============================================================
// SECTION INPUT ADAPTER. Parent owns TargetUPN and AnchorTime.
// ============================================================
let IdpTargetUPN             = TargetUPN;
let IdpAnchorTime            = AnchorTime;
let IdpSectionOrder          = 20;
let IdpScoreWindow           = 1d;
let IdpBaselineWindow        = 90d;
let IdpIngestionGrace        = 2d;
let IdpMinBaselineEvents     = 25;
let IdpMinBaselineActiveDays = 7;
let IdpNoBaselineFloor       = 5;
let IdpMinModelCoveragePct   = 75.0;
let IdpMaxFindings           = 20;
let IdpTargetConfigured      =
    isnotempty(IdpTargetUPN) and IdpTargetUPN != "<upn>";
let IdpAnchorConfigured      = isnotnull(IdpAnchorTime);
let IdpScoreEnd              = IdpAnchorTime;
let IdpScoreStart            = IdpScoreEnd - IdpScoreWindow;
let IdpModelEnd              = IdpScoreStart;
let IdpModelStart            = IdpModelEnd - IdpBaselineWindow;
//
// Per-user verdict ledger. Copy the exact UserId/Dimension/Value tuple from the
// finding Evidence bag. Raw bits remain historical; active entries adjust only
// the actionable view.
let IdpDispositioned = datatable(
    UserId: string,
    Dimension: string,
    Value: string,
    ValidFrom: datetime,
    ExpiresOn: datetime,
    CaseId: string,
    DispositionNote: string
)[
    // "00000000-0000-0000-0000-000000000000", "asn", "12576",
    // datetime(2026-08-01), datetime(2026-09-01), "CASE-12345",
    // "Confirmed corporate/mobile egress"
];
//
// Resolve duplicate disposition tuples before scoring so lookup cannot
// multiply scoring rows.
let IdpDispositionedResolved =
    IdpDispositioned
    | summarize arg_max(
        ValidFrom,
        ExpiresOn,
        CaseId,
        DispositionNote)
      by UserId, Dimension, Value;
//
// ============================================================
// SCORING ENGINE. Namespaced.
// ============================================================
// === SECTION 1: resolve the analyst-friendly UPN to stable UserId ===
let IdpResolvedUserId = toscalar(
    SigninLogs
    | where TimeGenerated >= IdpModelStart
    | where TimeGenerated < IdpAnchorTime + IdpIngestionGrace
    | where UserPrincipalName =~ IdpTargetUPN
    | where isnotempty(UserId)
    | summarize arg_max(TimeGenerated, UserId)
    | project UserId
);
//
// === SECTION 2: scoped raw rows, with event time distinct from ingestion ===
// Ingestion grace is applied to the TRAILING edge. A row whose EventTime is in
// window but whose TimeGenerated lands after the anchor is late, not absent.
// On a live run (anchor = now) this is a no-op; on a historical anchor it is
// the difference between a complete window and a silently short one.
let IdpRawSigninRows =
    SigninLogs
    | where TimeGenerated >= IdpModelStart
    | where TimeGenerated < IdpAnchorTime + IdpIngestionGrace
    | where IsInteractive == true
    | where iff(isnotempty(IdpResolvedUserId),
                UserId == IdpResolvedUserId,
                UserPrincipalName =~ IdpTargetUPN)
    | extend EventTime = coalesce(CreatedDateTime, TimeGenerated)
    | where EventTime >= IdpModelStart and EventTime < IdpScoreEnd
    | extend FlowKey = tostring(Id)
    | project
        EventTime, TimeGenerated, FlowKey, CorrelationId, SessionId, UserId,
        IPAddress, AutonomousSystemNumber, Location, LocationDetails,
        DeviceDetail, AppId, AppDisplayName, AuthenticationProtocol,
        AuthenticationRequirement, AuthenticationMethodsUsed,
        ClientAppUsed, ResultType, ResultDescription,
        ConditionalAccessStatus, RiskLevelDuringSignIn,
        RiskEventTypes_V2, IsRisky, CrossTenantAccessType;
//
// === SECTION 3: collapse duplicate ingestion rows, one row per sign-in ===
let IdpPrep = materialize(
    IdpRawSigninRows
    | summarize
        RawRecordCount = count(),
        arg_max(
            TimeGenerated,
            EventTime, CorrelationId, SessionId, UserId,
            IPAddress, AutonomousSystemNumber, Location, LocationDetails,
            DeviceDetail, AppId, AppDisplayName, AuthenticationProtocol,
            AuthenticationRequirement, AuthenticationMethodsUsed,
            ClientAppUsed, ResultType, ResultDescription,
            ConditionalAccessStatus, RiskLevelDuringSignIn,
            RiskEventTypes_V2, IsRisky, CrossTenantAccessType)
      by FlowKey
    | extend Dev = DeviceDetail, Loc = LocationDetails
    | extend
        OsRaw = tostring(Dev.operatingSystem),
        BrowserRaw = tostring(Dev.browser),
        ProtocolRaw = tostring(AuthenticationProtocol),
        AuthMethodsRaw = tostring(AuthenticationMethodsUsed)
    | extend
        DimAsn = iff(isempty(tostring(AutonomousSystemNumber)),
                     "<missing>", tostring(AutonomousSystemNumber)),
        DimCountry = toupper(coalesce(
                         Location,
                         tostring(Loc.countryOrRegion),
                         "<missing>")),
        DeviceId = iff(isempty(tostring(Dev.deviceId)),
                       "<unregistered>", tostring(Dev.deviceId)),
        DeviceTrust = iff(isempty(tostring(Dev.trustType)),
                          "<none>", tostring(Dev.trustType)),
        DeviceCompliant = iff(isempty(tostring(Dev.isCompliant)),
                              "<unknown>", tostring(Dev.isCompliant)),
        DimOs = tolower(replace_regex(
                    iff(isempty(OsRaw), "<missing>", OsRaw),
                    @'[0-9]+([.][0-9]+)*', "#")),
        DimBrowser = tolower(replace_regex(
                         iff(isempty(BrowserRaw), "<missing>", BrowserRaw),
                         @'[0-9]+([.][0-9]+)*', "#")),
        DimApp = coalesce(AppId, AppDisplayName, "<missing>"),
        DimProtocol = tolower(iff(
                          isempty(ProtocolRaw), "<missing>", ProtocolRaw)),
        DimClient = coalesce(ClientAppUsed, "<missing>"),
        DimResult = iff(isempty(tostring(ResultType)),
                        "<missing>", tostring(ResultType)),
        BrowserExpected = ClientAppUsed has "Browser",
        AuthMethodsObserved = isnotempty(AuthMethodsRaw)
                              and AuthMethodsRaw != "[]",
        IngestionDelay = TimeGenerated - EventTime
    | extend
        BrowserApplicable = BrowserExpected or isnotempty(BrowserRaw),
        BrowserMissing = BrowserExpected and isempty(BrowserRaw),
        AuthRequirementDisplay = iff(
            isempty(AuthenticationRequirement),
            "<not_reported>", AuthenticationRequirement),
        AuthMethodsDisplay = iff(
            AuthMethodsObserved, AuthMethodsRaw, "<not_reported>"),
        AuthEvidenceState = case(
            AuthMethodsObserved, "observed",
            AuthenticationProtocol in~ ("saml20", "wsFederation"),
                "federated_upstream",
            AuthenticationRequirement =~ "multiFactorAuthentication",
                "missing_expected",
            "not_reported")
    | extend
        DimDevice = DeviceId,
        Registered = iff(DeviceId == "<unregistered>",
                         "unregistered device", "registered device"),
        // CONTROL flags: a control was absent, bypassed, or fired. Event-like,
        // low volume, always worth an analyst's eye. Drives Priority 4.
        ControlFlags = set_difference(
            pack_array(
                iff(tolower(ConditionalAccessStatus) == "failure",
                    "conditional_access_failure", ""),
                iff(AuthenticationProtocol =~ "ropc"
                    or ClientAppUsed in~
                       ("Exchange ActiveSync", "IMAP", "MAPI", "SMTP", "POP"),
                    "legacy_auth", ""),
                iff(IsRisky == true
                    or RiskLevelDuringSignIn in~ ("medium", "high"),
                    "entra_risk_signal", ""),
                iff(isnotempty(CrossTenantAccessType)
                    and CrossTenantAccessType !~ "none",
                    "cross_tenant", "")),
            dynamic([""])),
        // POSTURE flags: an ambient device-estate state. High volume in any
        // tenant with imperfect enrolment. Hygiene on its own; escalates to
        // Priority 4 only when it coincides with actionable novelty.
        PostureFlags = set_difference(
            pack_array(
                iff(DeviceId == "<unregistered>",
                    "unregistered_device", ""),
                iff(tolower(DeviceCompliant) == "false",
                    "noncompliant_device", "")),
            dynamic([""]))
);
//
// === SECTION 4: long form, one row per sign-in + dimension + value ===
let IdpPrepLong = (start: datetime, stop: datetime) {
    IdpPrep
    | where EventTime >= start and EventTime < stop
    | extend Dims = pack_array(
        bag_pack("d", "asn",       "p", "network", "context", true,
                 "v", DimAsn,      "a", true,
                 "m", DimAsn == "<missing>"),
        bag_pack("d", "country",   "p", "network", "context", true,
                 "v", DimCountry,  "a", true,
                 "m", DimCountry == "<missing>"),
        bag_pack("d", "device",    "p", "client",  "context", true,
                 "v", DimDevice,   "a", true, "m", false),
        bag_pack("d", "os",        "p", "client",  "context", true,
                 "v", DimOs,       "a", true,
                 "m", DimOs == "<missing>"),
        bag_pack("d", "browser",   "p", "client",  "context", true,
                 "v", DimBrowser,  "a", BrowserApplicable,
                 "m", BrowserMissing),
        bag_pack("d", "app",       "p", "access",  "context", true,
                 "v", DimApp,      "a", true,
                 "m", DimApp == "<missing>"),
        bag_pack("d", "protocol",  "p", "access",  "context", true,
                 "v", DimProtocol, "a", true,
                 "m", DimProtocol == "<missing>"),
        bag_pack("d", "clientapp", "p", "access",  "context", true,
                 "v", DimClient,   "a", true,
                 "m", DimClient == "<missing>"),
        bag_pack("d", "result",    "p", "outcome", "context", false,
                 "v", DimResult,   "a", true,
                 "m", DimResult == "<missing>"))
    | mv-expand D = Dims
    | extend
        Dimension = tostring(D.d),
        Plane = tostring(D.p),
        IncludeContext = tobool(D.context),
        Value = tostring(D.v),
        Applicable = tobool(D.a),
        Missing = tobool(D.m)
    | project-away D, Dims
};
//
// === SECTION 5: baseline health, measured on successful terminal flows ===
let IdpBaselineHealth = materialize(
    IdpPrep
    | where EventTime >= IdpModelStart and EventTime < IdpModelEnd
    | where DimResult == "0"
    | summarize
        BaselineFlows = count(),
        BaselineActiveDays = dcount(startofday(EventTime)),
        BaselineFirst = min(EventTime),
        BaselineLast = max(EventTime)
);
let IdpBaselineN = toscalar(
    IdpBaselineHealth | project BaselineFlows);
let IdpBaselineDays = toscalar(
    IdpBaselineHealth | project BaselineActiveDays);
let IdpBaselineStateScalar = case(
    IdpTargetConfigured == false, "target_not_set",
    IdpAnchorConfigured == false, "anchor_not_set",
    IdpBaselineN < IdpNoBaselineFloor, "no_baseline",
    IdpBaselineN < IdpMinBaselineEvents
        or IdpBaselineDays < IdpMinBaselineActiveDays,
        "thin_baseline",
    "ready");
//
// === SECTION 6: per-dimension vocabularies ===
// Context dimensions learn successful flows. Outcome learns all flows.
let IdpModel = materialize(
    IdpPrepLong(IdpModelStart, IdpModelEnd)
    | where Applicable == true
    | where Missing == false
    | where IncludeContext == false or DimResult == "0"
    | summarize ValueCount = count() by Dimension, Value
);
//
// === SECTION 7: coherent, smoothed unseen-bucket price ===
let IdpDimStats =
    IdpModel
    | summarize
        DimTotal = sum(ValueCount),
        Singletons = countif(ValueCount == 1)
      by Dimension
    | extend PUnseen = (todouble(Singletons) + 0.5)
                       / (todouble(DimTotal) + 1.0)
    | project Dimension, DimTotal, PUnseen;
//
// === SECTION 8: score the recent sign-ins ===
let IdpScoredLong =
    IdpPrepLong(IdpScoreStart, IdpScoreEnd)
    | lookup kind=leftouter IdpModel on Dimension, Value
    | lookup kind=leftouter IdpDimStats on Dimension
    | lookup kind=leftouter IdpDispositionedResolved on UserId, Dimension, Value
    | extend HasModel = isnotnull(DimTotal) and DimTotal > 0
    | extend Novel = Applicable and Missing == false
                     and HasModel and isnull(ValueCount)
    | extend Probability = case(
        Applicable == false or Missing or HasModel == false, real(null),
        Novel, PUnseen,
        (1.0 - PUnseen)
            * todouble(ValueCount)
            / todouble(DimTotal))
    | extend RawBits = case(
        IdpBaselineStateScalar != "ready" or isnull(Probability), real(null),
        -log2(Probability))
    | extend DispositionApplies =
        isnotempty(DispositionNote)
        and Applicable and Missing == false
        and (isnull(ValidFrom) or EventTime >= ValidFrom)
        and (isnull(ExpiresOn) or EventTime < ExpiresOn)
    | extend ActionableNovel = Novel and DispositionApplies == false
    | extend AdjustedBits = case(
        isnull(RawBits), real(null),
        DispositionApplies, 0.0,
        RawBits);
//
// === SECTION 9: one analyst-facing row per sign-in ===
let IdpScored = materialize(
    IdpScoredLong
    | summarize
        RawContextBitsCalc = sumif(RawBits, IncludeContext),
        AdjustedContextBitsCalc = sumif(AdjustedBits, IncludeContext),
        RawOutcomeBitsCalc = sumif(RawBits, IncludeContext == false),
        AdjustedOutcomeBitsCalc = sumif(
            AdjustedBits, IncludeContext == false),
        // One bag replaces eighteen per-dimension columns. This is the
        // "which plane moved" breakdown; it is the point of the scorer.
        DimensionBits = make_bag_if(
            bag_pack(Dimension, round(RawBits, 1)), isnotnull(RawBits)),
        ResultScoreCount = countif(
            Dimension == "result" and isnotnull(RawBits)),
        ApplicableContextDims = countif(IncludeContext and Applicable),
        ScoredContextDims = countif(IncludeContext and isnotnull(RawBits)),
        ActionableNetworkNovelCount = countif(
            ActionableNovel and IncludeContext and Plane == "network"),
        ActionableClientNovelCount = countif(
            ActionableNovel and IncludeContext and Plane == "client"),
        ActionableAccessNovelCount = countif(
            ActionableNovel and IncludeContext and Plane == "access"),
        RawOutcomeNovelCount = countif(
            Novel and IncludeContext == false),
        ActionableOutcomeNovelCount = countif(
            ActionableNovel and IncludeContext == false),
        RawNovelDims = make_set_if(
            Dimension, Novel and IncludeContext),
        ActionableNovelDims = make_set_if(
            Dimension, ActionableNovel and IncludeContext),
        MissingDims = make_set_if(
            Dimension, Applicable and Missing),
        UnmodelledDims = make_set_if(
            Dimension,
            Applicable and Missing == false and HasModel == false),
        DispositionHits = make_set_if(
            strcat(Dimension, "=", Value, " [", CaseId, "]"),
            DispositionApplies),
        take_any(
            UserId, IPAddress, AutonomousSystemNumber, Location,
            AppDisplayName, AppId, DeviceId, DeviceTrust, DeviceCompliant,
            Registered, DimOs, DimBrowser, BrowserApplicable, DimProtocol,
            DimClient, DimResult, AuthRequirementDisplay, AuthMethodsDisplay,
            AuthEvidenceState, ResultDescription, ConditionalAccessStatus,
            RiskLevelDuringSignIn, RiskEventTypes_V2, CrossTenantAccessType,
            SessionId, CorrelationId, RawRecordCount, IngestionDelay,
            ControlFlags, PostureFlags)
      by FlowKey, EventTime
    | extend
        RawContextBits = iff(
            IdpBaselineStateScalar == "ready" and ScoredContextDims > 0,
            round(RawContextBitsCalc, 1), real(null)),
        AdjustedContextBits = iff(
            IdpBaselineStateScalar == "ready" and ScoredContextDims > 0,
            round(AdjustedContextBitsCalc, 1), real(null)),
        RawOutcomeBits = iff(
            IdpBaselineStateScalar == "ready" and ResultScoreCount > 0,
            round(RawOutcomeBitsCalc, 1), real(null)),
        AdjustedOutcomeBits = iff(
            IdpBaselineStateScalar == "ready" and ResultScoreCount > 0,
            round(AdjustedOutcomeBitsCalc, 1), real(null)),
        ModelCoverage = iff(
            ApplicableContextDims > 0,
            round(
                100.0 * todouble(ScoredContextDims)
                / todouble(ApplicableContextDims), 1),
            real(null))
    | extend
        ActionableMultiContextPlane =
            (ActionableNetworkNovelCount > 0
             and ActionableClientNovelCount > 0)
            or (ActionableNetworkNovelCount > 0
                and ActionableAccessNovelCount > 0)
            or (ActionableClientNovelCount > 0
                and ActionableAccessNovelCount > 0)
    | extend
        BaselineState = IdpBaselineStateScalar,
        BaselineFlows = IdpBaselineN,
        BaselineActiveDays = IdpBaselineDays,
        ActionableNoveltyPattern = case(
            IdpBaselineStateScalar != "ready", "not_assessed",
            array_length(RawNovelDims) > 0
                and array_length(ActionableNovelDims) == 0,
                "fully_dispositioned",
            ActionableMultiContextPlane, "multi_plane",
            ActionableNetworkNovelCount > 0, "network",
            ActionableClientNovelCount > 0, "client",
            ActionableAccessNovelCount > 0, "access",
            "all_context_values_seen"),
        RawOutcomeNovel =
            IdpBaselineStateScalar == "ready"
            and RawOutcomeNovelCount > 0,
        ActionableOutcomeNovel =
            IdpBaselineStateScalar == "ready"
            and ActionableOutcomeNovelCount > 0
    | extend
        ActionableContextNovel = ActionableNoveltyPattern !in
            ("all_context_values_seen", "fully_dispositioned",
             "not_assessed"),
        ScoreConfidence = case(
            IdpBaselineStateScalar != "ready", "not_scored",
            isnull(ModelCoverage)
                or ModelCoverage < IdpMinModelCoveragePct,
                "low_model_coverage",
            array_length(MissingDims) > 0
                or AuthEvidenceState == "missing_expected",
                "reduced_missing_telemetry",
            "standard")
    // Priority ladder. Control flags are event-like and always top tier.
    // Posture flags are ambient and only reach the top tier when they
    // coincide with novelty; alone they are a hygiene finding.
    // Control and posture flags are deterministic: they do not depend on the
    // model, so they keep their tier even when the baseline is not ready.
    // Every novelty condition below already resolves false in that state.
    | extend NotePriority = case(
        array_length(ControlFlags) > 0, 4,
        array_length(PostureFlags) > 0
            and (ActionableContextNovel or ActionableOutcomeNovel), 4,
        ActionableOutcomeNovel, 3,
        ActionableNoveltyPattern == "multi_plane", 3,
        ActionableNoveltyPattern in ("network", "client", "access"), 2,
        array_length(PostureFlags) > 0, 1,
        ActionableNoveltyPattern == "fully_dispositioned", 1,
        RawOutcomeNovel, 1,
        ScoreConfidence != "standard", 1,
        0)
    | extend NoteWorthy =
        array_length(ControlFlags) > 0
        or array_length(PostureFlags) > 0
        or (BaselineState == "ready"
            and (RawOutcomeNovel or array_length(RawNovelDims) > 0))
    | extend Assessment = case(
        BaselineState == "target_not_set",
            "Not assessed: set parent TargetUPN.",
        BaselineState == "anchor_not_set",
            "Not assessed: set parent AnchorTime.",
        BaselineState == "no_baseline",
            "Not assessed: fewer than the no-baseline floor of successful flows.",
        BaselineState == "thin_baseline",
            "Not assessed: baseline is too thin for confident bits.",
        array_length(ControlFlags) > 0
            and (ActionableContextNovel or ActionableOutcomeNovel),
            "Novel identity context with one or more control flags; investigate.",
        array_length(ControlFlags) > 0,
            "Known identity context with one or more control flags; review the flags.",
        array_length(PostureFlags) > 0
            and (ActionableContextNovel or ActionableOutcomeNovel),
            "Novel identity context from a device with a posture gap; investigate.",
        ActionableOutcomeNovel,
            "Novel authentication outcome; compromise is not established.",
        ActionableContextNovel,
            "Novel identity context observed; compromise is not established.",
        ActionableNoveltyPattern == "fully_dispositioned",
            "Raw novelty observed; active dispositions removed it from the actionable view.",
        array_length(PostureFlags) > 0,
            "Known identity context from a device with a posture gap; hygiene finding.",
        "All scored context values were previously observed; compromise is not excluded.")
    | project-away
        RawContextBitsCalc, AdjustedContextBitsCalc,
        RawOutcomeBitsCalc, AdjustedOutcomeBitsCalc,
        ResultScoreCount,
        ActionableNetworkNovelCount, ActionableClientNovelCount,
        ActionableAccessNovelCount,
        RawOutcomeNovelCount, ActionableOutcomeNovelCount,
        ActionableMultiContextPlane
);
//
// ============================================================
// PRODUCTION ADAPTER. Bounded, union-safe investigation rows.
// ============================================================
// Sort on adjusted bits first so an actively dispositioned sign-in cannot
// outrank a live one for a scarce detail slot within the same tier.
let IdpFindingCandidates = materialize(
    IdpScored
    | where NoteWorthy
    | sort by
        NotePriority desc,
        AdjustedContextBits desc nulls last,
        RawContextBits desc nulls last,
        EventTime desc
    | extend CandidateRank = row_number()
);
let IdpFlowSummary = materialize(
    IdpScored
    | summarize
        TotalFlows = count(),
        ActionableNovelFlows = countif(ActionableContextNovel),
        MultiPlaneNovelFlows = countif(
            ActionableNoveltyPattern == "multi_plane"),
        ActionableOutcomeNovelFlows = countif(ActionableOutcomeNovel),
        FullyDispositionedFlows = countif(
            ActionableNoveltyPattern == "fully_dispositioned"),
        ControlFlaggedFlows = countif(array_length(ControlFlags) > 0),
        PostureFlaggedFlows = countif(array_length(PostureFlags) > 0),
        RawNovelOutcomeFlows = countif(RawOutcomeNovel),
        ReducedConfidenceFlows = countif(ScoreConfidence != "standard"),
        DetailedCandidates = countif(NoteWorthy)
);
let IdpStatusOutput =
    IdpBaselineHealth
    | project
        SectionOrder = toint(IdpSectionOrder),
        FindingOrder = tolong(0),
        Section = "identity_posture",
        RecordType = "section_status",
        Priority = toint(
            iff(IdpBaselineStateScalar == "ready", 0, 3)),
        EventTime = IdpAnchorTime,
        Entity = tostring(IdpTargetUPN),
        FindingKey = strcat(
            "identity:",
            coalesce(IdpResolvedUserId, IdpTargetUPN),
            ":status"),
        Title = iff(
            IdpBaselineStateScalar == "ready",
            "Identity posture model ready",
            strcat(
                "Identity posture not assessed: ",
                IdpBaselineStateScalar)),
        Note = strcat(
            "Identity posture, ", IdpTargetUPN, ": ",
            format_datetime(IdpScoreStart, "yyyy-MM-dd HH:mm"), " to ",
            format_datetime(IdpScoreEnd, "yyyy-MM-dd HH:mm"),
            " UTC scored against the preceding ",
            toint(IdpBaselineWindow / 1d), " days (",
            BaselineFlows, " successful baseline flows across ",
            BaselineActiveDays, " active days; state ",
            IdpBaselineStateScalar, ")."),
        Evidence = bag_pack(
            "target_upn", IdpTargetUPN,
            "resolved_user_id", IdpResolvedUserId,
            "anchor_time_utc", IdpAnchorTime,
            "model_start_utc", IdpModelStart,
            "model_end_utc", IdpModelEnd,
            "score_start_utc", IdpScoreStart,
            "score_end_utc", IdpScoreEnd,
            "baseline_flows", BaselineFlows,
            "baseline_active_days", BaselineActiveDays,
            "baseline_first_utc", BaselineFirst,
            "baseline_last_utc", BaselineLast,
            "baseline_state", IdpBaselineStateScalar,
            "required_events", IdpMinBaselineEvents,
            "required_active_days", IdpMinBaselineActiveDays,
            "required_coverage_pct", IdpMinModelCoveragePct);
let IdpSummaryOutput =
    IdpFlowSummary
    | project
        SectionOrder = toint(IdpSectionOrder),
        FindingOrder = tolong(10),
        Section = "identity_posture",
        RecordType = "section_summary",
        Priority = toint(case(
            ControlFlaggedFlows > 0, 4,
            PostureFlaggedFlows > 0
                and (ActionableNovelFlows > 0
                     or ActionableOutcomeNovelFlows > 0), 4,
            IdpBaselineStateScalar != "ready", 3,
            ActionableOutcomeNovelFlows > 0
                or MultiPlaneNovelFlows > 0, 3,
            ActionableNovelFlows > 0, 2,
            PostureFlaggedFlows > 0
                or RawNovelOutcomeFlows > 0
                or FullyDispositionedFlows > 0
                or ReducedConfidenceFlows > 0, 1,
            0)),
        EventTime = IdpAnchorTime,
        Entity = tostring(IdpTargetUPN),
        FindingKey = strcat(
            "identity:",
            coalesce(IdpResolvedUserId, IdpTargetUPN),
            ":summary"),
        Title = "Identity posture flow summary",
        Note = strcat(
            "Flow summary: ", TotalFlows, " total; ",
            ActionableNovelFlows, " actionable novel; ",
            MultiPlaneNovelFlows, " multi-plane novel; ",
            ActionableOutcomeNovelFlows, " actionable novel outcomes; ",
            FullyDispositionedFlows, " fully dispositioned; ",
            ControlFlaggedFlows, " control-flagged; ",
            PostureFlaggedFlows, " posture-flagged; ",
            RawNovelOutcomeFlows, " raw novel outcomes; ",
            ReducedConfidenceFlows, " reduced-confidence; ",
            DetailedCandidates,
            " detailed candidates (showing at most ",
            IdpMaxFindings, ")."),
        Evidence = bag_pack(
            "total_flows", TotalFlows,
            "actionable_novel_flows", ActionableNovelFlows,
            "multi_plane_novel_flows", MultiPlaneNovelFlows,
            "actionable_novel_outcome_flows", ActionableOutcomeNovelFlows,
            "fully_dispositioned_flows", FullyDispositionedFlows,
            "control_flagged_flows", ControlFlaggedFlows,
            "posture_flagged_flows", PostureFlaggedFlows,
            "raw_novel_outcome_flows", RawNovelOutcomeFlows,
            "reduced_confidence_flows", ReducedConfidenceFlows,
            "detailed_candidates", DetailedCandidates,
            "maximum_detailed_findings", IdpMaxFindings,
            "baseline_state", IdpBaselineStateScalar);
let IdpDetailOutput =
    IdpFindingCandidates
    | where CandidateRank <= IdpMaxFindings
    | extend
        BrowserText = iff(
            BrowserApplicable, DimBrowser, "<not_applicable>"),
        ScoreText = iff(
            isnull(RawContextBits),
            strcat("not scored (", BaselineState, ")"),
            strcat(
                RawContextBits, " raw / ",
                AdjustedContextBits, " adjusted context bits; ",
                RawOutcomeBits, " raw / ",
                AdjustedOutcomeBits, " adjusted outcome bits")),
        FindingTitle = case(
            array_length(ControlFlags) > 0
                and (ActionableContextNovel or ActionableOutcomeNovel),
                "Control flags with novel identity context",
            array_length(ControlFlags) > 0,
                "Control flags in known identity context",
            array_length(PostureFlags) > 0
                and (ActionableContextNovel or ActionableOutcomeNovel),
                "Novel identity context from a device with a posture gap",
            ActionableOutcomeNovel,
                "Novel authentication outcome",
            ActionableNoveltyPattern == "multi_plane",
                "Novel identity context across multiple planes",
            ActionableNoveltyPattern in ("network", "client", "access"),
                strcat("Novel identity context: ", ActionableNoveltyPattern),
            ActionableNoveltyPattern == "fully_dispositioned",
                "Dispositioned identity novelty",
            RawOutcomeNovel,
                "Raw authentication-outcome novelty",
            array_length(PostureFlags) > 0,
                "Device posture gap in known identity context",
            "Identity posture candidate")
    | project
        SectionOrder = toint(IdpSectionOrder),
        FindingOrder = tolong(100) + CandidateRank,
        Section = "identity_posture",
        RecordType = "finding",
        Priority = toint(NotePriority),
        EventTime = EventTime,
        Entity = tostring(IdpTargetUPN),
        FindingKey = strcat("identity:", FlowKey),
        Title = FindingTitle,
        Note = strcat(
            format_datetime(EventTime, "yyyy-MM-dd HH:mm"), " UTC | ",
            ScoreText,
            " | bits ", tostring(DimensionBits),
            " | actionable pattern ", ActionableNoveltyPattern,
            " | confidence ", ScoreConfidence,
            " (", ModelCoverage, "% coverage)",
            " | IP ", IPAddress,
            " (AS", AutonomousSystemNumber, ", ", Location, ")",
            " | ", DimOs, " / ", BrowserText,
            " | ", Registered,
            " | app ", AppDisplayName, " [", AppId, "]",
            " | protocol ", DimProtocol,
            " | requirement ", AuthRequirementDisplay,
            " | methods ", AuthMethodsDisplay,
            " (", AuthEvidenceState, ")",
            " | result ", DimResult,
            " | control flags ", tostring(ControlFlags),
            " | posture flags ", tostring(PostureFlags),
            " | raw novel ", tostring(RawNovelDims),
            " | actionable novel ", tostring(ActionableNovelDims),
            " | missing ", tostring(MissingDims),
            " | unmodelled ", tostring(UnmodelledDims),
            " | flow ", FlowKey,
            " | ", Assessment),
        Evidence = bag_pack(
            "flow_key", FlowKey,
            "user_id", UserId,
            "event_time_utc", EventTime,
            "raw_context_bits", RawContextBits,
            "adjusted_context_bits", AdjustedContextBits,
            "raw_outcome_bits", RawOutcomeBits,
            "adjusted_outcome_bits", AdjustedOutcomeBits,
            "dimension_bits", DimensionBits,
            "actionable_novelty_pattern", ActionableNoveltyPattern,
            "raw_novel_dimensions", RawNovelDims,
            "actionable_novel_dimensions", ActionableNovelDims,
            "raw_outcome_novel", RawOutcomeNovel,
            "actionable_outcome_novel", ActionableOutcomeNovel,
            "score_confidence", ScoreConfidence,
            "model_coverage_pct", ModelCoverage,
            "missing_dimensions", MissingDims,
            "unmodelled_dimensions", UnmodelledDims,
            "auth_evidence_state", AuthEvidenceState,
            "disposition_hits", DispositionHits,
            "control_flags", ControlFlags,
            "posture_flags", PostureFlags,
            "ip_address", IPAddress,
            "asn", AutonomousSystemNumber,
            "country", Location,
            "registered", Registered,
            "device_id", DeviceId,
            "device_trust", DeviceTrust,
            "device_compliant", DeviceCompliant,
            "os", DimOs,
            "browser", BrowserText,
            "app_display_name", AppDisplayName,
            "app_id", AppId,
            "protocol", DimProtocol,
            "client_app", DimClient,
            "auth_requirement", AuthRequirementDisplay,
            "auth_methods", AuthMethodsDisplay,
            "result", DimResult,
            "result_description", ResultDescription,
            "conditional_access_status", ConditionalAccessStatus,
            "risk_level_during_signin", RiskLevelDuringSignIn,
            "risk_event_types_v2", RiskEventTypes_V2,
            "cross_tenant_access_type", CrossTenantAccessType,
            "correlation_id", CorrelationId,
            "session_id", SessionId,
            "raw_record_count", RawRecordCount,
            "ingestion_delay", IngestionDelay,
            "assessment", Assessment);
let IdpTruncationOutput =
    IdpFlowSummary
    | where DetailedCandidates > IdpMaxFindings
    | project
        SectionOrder = toint(IdpSectionOrder),
        FindingOrder = tolong(1000000),
        Section = "identity_posture",
        RecordType = "truncation",
        Priority = toint(1),
        EventTime = IdpAnchorTime,
        Entity = tostring(IdpTargetUPN),
        FindingKey = strcat(
            "identity:",
            coalesce(IdpResolvedUserId, IdpTargetUPN),
            ":truncation"),
        Title = "Identity posture findings truncated",
        Note = strcat(
            "Detail truncated: ",
            DetailedCandidates - IdpMaxFindings,
            " additional identity candidate flow(s) omitted."),
        Evidence = bag_pack(
            "detailed_candidates", DetailedCandidates,
            "maximum_detailed_findings", IdpMaxFindings,
            "omitted_findings", DetailedCandidates - IdpMaxFindings);
let IdentityPostureSection =
    union
        IdpStatusOutput,
        IdpSummaryOutput,
        IdpDetailOutput,
        IdpTruncationOutput
    | project
        SectionOrder,
        FindingOrder,
        Section,
        RecordType,
        Priority,
        EventTime,
        Entity,
        FindingKey,
        Title,
        Note,
        Evidence;
//
// Standalone section output. In the complete one-shot query, replace these final
// two lines with the parent union across all investigation sections.
IdentityPostureSection
| sort by SectionOrder asc, FindingOrder asc
