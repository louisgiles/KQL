export const researchEntry   // the original `entry` zod schema, verbatim, plus the two query refinements below
export type ResearchEntry = z.infer<typeof researchEntry>;
export function researchSystemPrompt(): string;
export async function upsertResearch(entries: ResearchEntry[], nowIso: string): Promise<string[]>; // ids
