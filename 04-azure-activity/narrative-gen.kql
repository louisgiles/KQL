// name:              Azure Activity Narrative Generator
// purpose:           Dash-prefixed, paste-ready investigation note for recurring Azure Activity alerts:
//                    suspicious azure activity, suspicious resource deployment,
//                    suspicious resource deletion.
// starting_entities: AlertTime, Caller, CallerIpAddress, OperationName, ResourceId, SubscriptionId
// required_tables:   AzureActivity
// optional_tables:   SigninLogs (actor sign-in context near AlertTime), AuditLogs (correlated directory activity)
// variables:         AlertTime, AlertTitle, CallerToCheck, CallerIpToCheck, OperationToCheck, ResourceIdToCheck, SubscriptionIdToCheck, EventWindow, BaselineWindow, BaselineLabel, IdentityContextWindow
// done_criteria:     Verdict-first narrative output. Determination is line 1. For non-trivial verdicts an Analyst assessment line is pre-filled; for escalation verdicts a branch-aware ASK BLOCK enumerates what is required from the recipient. Literal entity values (UPN, IP, resource id, subscription id) stay in the projected non-narrative columns — the narrative body refers to them by role label only. Output pasted into the investigation ticket.
// output_type:       narrative
// companions:        04-azure-activity/quick-dive.kql, 04-azure-activity/deep-dive.kql
//
// Philosophy:
// Azure Activity benignity is often prevalence-based.
// This narrative summarises what happened, how normal it is for the actor,
// whether the actor appears to be a user/service principal/managed identity,
// and whether surrounding context supports closure or deeper review.

let AlertTime = datetime(2026-01-01T00:00:00Z);
let AlertTitle = "";
let CallerToCheck = "";
let CallerIpToCheck = "";
let OperationToCheck = "";
let ResourceIdToCheck = "";
let SubscriptionIdToCheck = "";
//
let EventWindow = 1h;
let BaselineWindow = 90d;
let BaselineLabel = "90d";
let IdentityContextWindow = 24h;
//
// --- Render a timespan as plain English ("30 days", "1 hour", "30 minutes"). ---
let humanTimespan = (t:timespan) {
    case(
        t >= 1d, strcat(tostring(toint(t / 1d)), iff(toint(t / 1d) == 1, " day", " days")),
        t >= 1h, strcat(tostring(toint(t / 1h)), iff(toint(t / 1h) == 1, " hour", " hours")),
        t >= 1m, strcat(tostring(toint(t / 1m)), iff(toint(t / 1m) == 1, " minute", " minutes")),
        tostring(t)
    )
};
//
// ============================================================================
// Alert scope
// ============================================================================
let AlertScope = materialize(
    AzureActivity
    | where TimeGenerated between (AlertTime - EventWindow .. AlertTime + EventWindow)
    | where isempty(CallerToCheck) or Caller contains CallerToCheck
    | where isempty(CallerIpToCheck) or CallerIpAddress contains CallerIpToCheck
    | where isempty(OperationToCheck) or OperationNameValue contains OperationToCheck or OperationName contains OperationToCheck
    | where isempty(ResourceIdToCheck) or ResourceId contains ResourceIdToCheck
    | where isempty(SubscriptionIdToCheck) or SubscriptionId contains SubscriptionIdToCheck
    | extend
        Actor = tolower(tostring(Caller)),
        ActorIP = tostring(CallerIpAddress),
        Operation = tostring(OperationNameValue),
        OperationDisplay = tostring(OperationName),
        Resource = tostring(ResourceId),
        ResourceGroup = tostring(ResourceGroup),
        ResourceProvider = tostring(ResourceProviderValue),
        Subscription = tostring(SubscriptionId),
        Status = tostring(ActivityStatusValue),
        Correlation = tostring(CorrelationId),
        ResourceType = extract(@"/providers/([^/]+/[^/]+)", 1, tostring(ResourceId)),
        ResourceName = tostring(split(ResourceId, "/")[-1])
    | extend ActorType = case(
        Actor has "@", "User",
        Actor matches regex @"^[0-9a-fA-F-]{8}-[0-9a-fA-F-]{4}-[0-9a-fA-F-]{4}-[0-9a-fA-F-]{4}-[0-9a-fA-F-]{12}$", "Service Principal / AppId",
        Actor has_any ("msi", "managed identity"), "Managed Identity",
        "Unknown / App Context"
    )
    | extend ActivityCategory = case(
        AlertTitle has "deployment"
            or Operation has "/deployments/write",
                "Infrastructure Deployment",
        AlertTitle has "deletion"
            or Operation endswith "/delete",
                "Resource Deletion",
        Operation has "roleAssignments/write"
            or Operation has "roleDefinitions/write"
            or Operation has "elevateAccess/action",
                "Privilege Escalation / RBAC Change",
        Operation has "policyAssignments/write"
            or Operation has "policyAssignments/delete"
            or Operation has "diagnosticSettings/delete"
            or Operation has "locks/delete",
                "Security Control Modification",
        Operation has "networkSecurityGroups/securityRules/write"
            or Operation has "publicIPAddresses/write"
            or Operation has "loadBalancers/write"
            or Operation has "applicationGateways/write",
                "Exposure / Network Change",
        Operation has "automationAccounts/write"
            or Operation has "automationAccounts/runbooks/write"
            or Operation has "virtualMachines/extensions/write"
            or Operation has "userAssignedIdentities/write"
            or Operation has "sites/config/write",
                "Persistence-Capable Change",
        Operation has "Microsoft.KeyVault/vaults"
            or Operation has "Microsoft.Storage/storageAccounts"
            or Operation has "Microsoft.Sql/servers"
            or Operation has "Microsoft.DocumentDB/databaseAccounts",
                "Sensitive Resource Change",
        "General Azure Activity"
    )
    | extend IsSensitiveCategory = ActivityCategory in (
        "Privilege Escalation / RBAC Change",
        "Security Control Modification",
        "Exposure / Network Change",
        "Persistence-Capable Change",
        "Sensitive Resource Change",
        "Resource Deletion"
    )
);
//
let TargetRow = materialize(AlertScope | summarize arg_min(TimeGenerated, *));
let AlertActors = toscalar(AlertScope | where isnotempty(Actor) | summarize make_set(Actor, 100));
let AlertOperations = toscalar(AlertScope | where isnotempty(Operation) | summarize make_set(Operation, 100));
let AlertSubscriptions = toscalar(AlertScope | where isnotempty(Subscription) | summarize make_set(Subscription, 100));
let AlertResourceTypes = toscalar(AlertScope | where isnotempty(ResourceType) | summarize make_set(ResourceType, 100));
//
// ============================================================================
// Historical Azure Activity baseline
// ============================================================================
let Historical = materialize(
    AzureActivity
    | where TimeGenerated between (AlertTime - BaselineWindow .. AlertTime - EventWindow)
    | extend
        Actor = tolower(tostring(Caller)),
        ActorIP = tostring(CallerIpAddress),
        Operation = tostring(OperationNameValue),
        Resource = tostring(ResourceId),
        Subscription = tostring(SubscriptionId),
        ResourceType = extract(@"/providers/([^/]+/[^/]+)", 1, tostring(ResourceId)),
        Status = tostring(ActivityStatusValue)
);
//
let ActorOperationBaseline =
    Historical
    | where Actor in (AlertActors)
    | summarize
        ActorOperationCount=count(),
        ActorOperationSuccessCount=countif(Status =~ "Success"),
        ActorOperationDaysSeen=dcount(bin(TimeGenerated, 1d)),
        ActorOperationFirstSeen=min(TimeGenerated),
        ActorOperationLastSeen=max(TimeGenerated),
        ActorOperationDistinctResources=dcount(Resource),
        ActorOperationDistinctSubs=dcount(Subscription)
        by Actor, Operation;
//
let ActorIpBaseline =
    Historical
    | where Actor in (AlertActors)
    | summarize
        ActorIpCount=count(),
        ActorIpDaysSeen=dcount(bin(TimeGenerated, 1d)),
        ActorIpFirstSeen=min(TimeGenerated),
        ActorIpLastSeen=max(TimeGenerated)
        by Actor, ActorIP;
//
let ActorSubscriptionBaseline =
    Historical
    | where Actor in (AlertActors)
    | summarize
        ActorSubscriptionCount=count(),
        ActorSubscriptionDaysSeen=dcount(bin(TimeGenerated, 1d)),
        ActorSubscriptionFirstSeen=min(TimeGenerated),
        ActorSubscriptionLastSeen=max(TimeGenerated)
        by Actor, Subscription;
//
let ActorResourceTypeBaseline =
    Historical
    | where Actor in (AlertActors)
    | summarize
        ActorResourceTypeCount=count(),
        ActorResourceTypeDaysSeen=dcount(bin(TimeGenerated, 1d)),
        ActorResourceTypeFirstSeen=min(TimeGenerated),
        ActorResourceTypeLastSeen=max(TimeGenerated)
        by Actor, ResourceType;
//
let TenantOperationBaseline =
    Historical
    | summarize
        TenantOperationCount=count(),
        TenantOperationActors=dcount(Actor),
        TenantOperationDaysSeen=dcount(bin(TimeGenerated, 1d)),
        TenantOperationResources=dcount(Resource)
        by Operation;
//
// ============================================================================
// Related Azure activity in alert window
// ============================================================================
let RelatedActivity = materialize(
    AzureActivity
    | where TimeGenerated between (AlertTime - EventWindow .. AlertTime + EventWindow)
    | extend
        Actor = tolower(tostring(Caller)),
        Operation = tostring(OperationNameValue),
        Resource = tostring(ResourceId),
        Subscription = tostring(SubscriptionId),
        ResourceType = extract(@"/providers/([^/]+/[^/]+)", 1, tostring(ResourceId)),
        Status = tostring(ActivityStatusValue)
    | where Actor in (AlertActors)
        or Operation in (AlertOperations)
        or Subscription in (AlertSubscriptions)
        or ResourceType in (AlertResourceTypes)
);
//
let RelatedSummary =
    RelatedActivity
    | summarize
        RelatedOps=count(),
        RelatedSuccess=countif(Status =~ "Success"),
        RelatedFailures=countif(Status !~ "Success"),
        RelatedActors=dcount(Actor),
        RelatedResources=dcount(Resource),
        RelatedOperations=make_set(Operation, 20);
//
// ============================================================================
// User sign-in context
// ============================================================================
let UserSigninContext = materialize(
    SigninLogs
    | where TimeGenerated between (AlertTime - IdentityContextWindow .. AlertTime + IdentityContextWindow)
    | extend Actor = tolower(UserPrincipalName)
    | where Actor in (AlertActors)
    | extend DeviceParsed = parse_json(tostring(DeviceDetail))
    | extend
        SigninTrustType = tostring(DeviceParsed.trustType),
        SigninIsManaged = tostring(DeviceParsed.isManaged),
        SigninIsCompliant = tostring(DeviceParsed.isCompliant),
        SigninDeviceOS = tostring(DeviceParsed.operatingSystem),
        SigninDeviceName = tostring(DeviceParsed.displayName)
    | summarize arg_max(TimeGenerated,
        IPAddress,
        Location,
        ResultType,
        ResultDescription,
        RiskLevelDuringSignIn,
        RiskDetail,
        RiskEventTypes,
        ConditionalAccessStatus,
        AuthenticationRequirement,
        SigninTrustType,
        SigninIsManaged,
        SigninIsCompliant,
        SigninDeviceOS,
        SigninDeviceName)
        by Actor
    | project-rename
        SigninTime = TimeGenerated,
        SigninIP = IPAddress,
        SigninLocation = Location,
        SigninResult = ResultType,
        SigninResultDescription = ResultDescription,
        SigninRiskLevel = RiskLevelDuringSignIn,
        SigninRiskDetail = RiskDetail,
        SigninRiskEvents = RiskEventTypes,
        SigninCAStatus = ConditionalAccessStatus,
        SigninAuthRequirement = AuthenticationRequirement
);
//
// ============================================================================
// Service principal / app context from AuditLogs
// ============================================================================
let SpCredentialChanges = materialize(
    AuditLogs
    | where TimeGenerated between (AlertTime - IdentityContextWindow .. AlertTime + IdentityContextWindow)
    | where OperationName has_any (
        "Add service principal credentials",
        "Update service principal",
        "Add app role assignment to service principal",
        "Add delegated permission grant",
        "Consent to application",
        "Add application",
        "Update application",
        "Add application password",
        "Add application certificate"
    )
    | extend Raw = tostring(TargetResources)
    | extend ActorMatch = tolower(Raw)
    | where ActorMatch has_any (AlertActors)
    | summarize
        SpChangeCount=count(),
        SpChangeOps=make_set(OperationName, 20),
        SpChangeLatest=max(TimeGenerated)
);
//
let SpRoleChanges = materialize(
    AuditLogs
    | where TimeGenerated between (AlertTime - IdentityContextWindow .. AlertTime + IdentityContextWindow)
    | where OperationName has_any (
        "Add member to role",
        "Add eligible member to role",
        "Add app role assignment to service principal",
        "Add owner to service principal",
        "Add owner to application"
    )
    | extend Raw = tostring(TargetResources)
    | extend ActorMatch = tolower(Raw)
    | where ActorMatch has_any (AlertActors)
    | summarize
        SpRoleChangeCount=count(),
        SpRoleChangeOps=make_set(OperationName, 20),
        SpRoleChangeLatest=max(TimeGenerated)
);
//
// ============================================================================
// Build narrative
// ============================================================================
TargetRow
| join kind=leftouter ActorOperationBaseline on Actor, Operation
| join kind=leftouter ActorIpBaseline on Actor, ActorIP
| join kind=leftouter ActorSubscriptionBaseline on Actor, Subscription
| join kind=leftouter ActorResourceTypeBaseline on Actor, ResourceType
| join kind=leftouter TenantOperationBaseline on Operation
| join kind=leftouter UserSigninContext on Actor
| extend _joinKey = 1
| join kind=leftouter (RelatedSummary | extend _joinKey = 1) on _joinKey
| join kind=leftouter (SpCredentialChanges | extend _joinKey = 1) on _joinKey
| join kind=leftouter (SpRoleChanges | extend _joinKey = 1) on _joinKey
| extend
    ActorOperationCount=coalesce(ActorOperationCount, 0),
    ActorOperationDaysSeen=coalesce(ActorOperationDaysSeen, 0),
    ActorIpCount=coalesce(ActorIpCount, 0),
    ActorIpDaysSeen=coalesce(ActorIpDaysSeen, 0),
    ActorSubscriptionCount=coalesce(ActorSubscriptionCount, 0),
    ActorSubscriptionDaysSeen=coalesce(ActorSubscriptionDaysSeen, 0),
    ActorResourceTypeCount=coalesce(ActorResourceTypeCount, 0),
    ActorResourceTypeDaysSeen=coalesce(ActorResourceTypeDaysSeen, 0),
    TenantOperationCount=coalesce(TenantOperationCount, 0),
    TenantOperationActors=coalesce(TenantOperationActors, 0),
    TenantOperationDaysSeen=coalesce(TenantOperationDaysSeen, 0),
    RelatedOps=coalesce(RelatedOps, 0),
    RelatedSuccess=coalesce(RelatedSuccess, 0),
    RelatedFailures=coalesce(RelatedFailures, 0),
    RelatedActors=coalesce(RelatedActors, 0),
    RelatedResources=coalesce(RelatedResources, 0),
    SpChangeCount=coalesce(SpChangeCount, 0),
    SpRoleChangeCount=coalesce(SpRoleChangeCount, 0)
| extend
    ActorOperationFamiliarity = case(
        ActorOperationCount == 0, "new for actor",
        ActorOperationDaysSeen <= 1, "rare for actor",
        ActorOperationDaysSeen <= 5, "occasional for actor",
        "common for actor"
    ),
    ActorIpFamiliarity = case(
        ActorIpCount == 0, "new IP for actor",
        ActorIpDaysSeen <= 1, "rare IP for actor",
        ActorIpDaysSeen <= 5, "occasional IP for actor",
        "familiar IP for actor"
    ),
    ActorSubscriptionFamiliarity = case(
        ActorSubscriptionCount == 0, "new subscription for actor",
        ActorSubscriptionDaysSeen <= 1, "rare subscription for actor",
        ActorSubscriptionDaysSeen <= 5, "occasional subscription for actor",
        "familiar subscription for actor"
    ),
    ActorResourceTypeFamiliarity = case(
        ActorResourceTypeCount == 0, "new resource type for actor",
        ActorResourceTypeDaysSeen <= 1, "rare resource type for actor",
        ActorResourceTypeDaysSeen <= 5, "occasional resource type for actor",
        "familiar resource type for actor"
    ),
    TenantOperationFamiliarity = case(
        TenantOperationCount == 0, "new operation in tenant baseline",
        TenantOperationDaysSeen <= 1, "rare operation in tenant",
        TenantOperationDaysSeen <= 5, "occasional operation in tenant",
        "common operation in tenant"
    )
| extend
    NewActorOperation = ActorOperationCount == 0,
    NewActorIP = ActorIpCount == 0,
    NewActorSubscription = ActorSubscriptionCount == 0,
    NewActorResourceType = ActorResourceTypeCount == 0,
    RareTenantOperation = TenantOperationCount <= 2,
    FailedThenSuccessPattern = RelatedFailures > 0 and Status =~ "Success",
    RelatedBurst = RelatedOps >= 10,
    RiskySignin = SigninRiskLevel in ("medium", "high") or (isnotempty(SigninRiskDetail) and SigninRiskDetail != "none"),
    UnmanagedSigninDevice = isnotempty(SigninTrustType) and SigninTrustType !in ("Azure AD joined", "Hybrid Azure AD joined"),
    RecentSpCredentialChange = SpChangeCount > 0,
    RecentSpRoleChange = SpRoleChangeCount > 0
| extend BehaviouralFlags = strcat_array(array_concat(
    iff(IsSensitiveCategory, pack_array("SENSITIVE_ACTIVITY_CATEGORY"), dynamic([])),
    iff(NewActorOperation, pack_array("NEW_OPERATION_FOR_ACTOR"), dynamic([])),
    iff(NewActorIP, pack_array("NEW_IP_FOR_ACTOR"), dynamic([])),
    iff(NewActorSubscription, pack_array("NEW_SUBSCRIPTION_FOR_ACTOR"), dynamic([])),
    iff(NewActorResourceType, pack_array("NEW_RESOURCE_TYPE_FOR_ACTOR"), dynamic([])),
    iff(RareTenantOperation, pack_array("RARE_TENANT_OPERATION"), dynamic([])),
    iff(FailedThenSuccessPattern, pack_array("FAILED_THEN_SUCCESS_PATTERN"), dynamic([])),
    iff(RelatedBurst, pack_array("RELATED_ACTIVITY_BURST"), dynamic([])),
    iff(RiskySignin, pack_array("RISKY_SIGNIN_CONTEXT"), dynamic([])),
    iff(UnmanagedSigninDevice, pack_array("UNMANAGED_SIGNIN_DEVICE"), dynamic([])),
    iff(RecentSpCredentialChange, pack_array("RECENT_SP_CREDENTIAL_OR_APP_CHANGE"), dynamic([])),
    iff(RecentSpRoleChange, pack_array("RECENT_SP_ROLE_OR_PERMISSION_CHANGE"), dynamic([]))
), " | ")
| extend _determination = strcat("- Determination: ", case(
    ActorType in ("Service Principal / AppId", "Managed Identity")
        and RecentSpCredentialChange and IsSensitiveCategory,
            "suspicious service principal context. Recent app/credential change observed near sensitive Azure control-plane activity. Deep-dive recommended.",
    ActorType in ("Service Principal / AppId", "Managed Identity")
        and ActorOperationCount > 20 and ActorSubscriptionDaysSeen > 10 and ActorResourceTypeDaysSeen > 10 and SpChangeCount == 0 and SpRoleChangeCount == 0,
            "likely benign service principal or managed identity behaviour based on legacy frequency and absence of recent app/credential or role-change context.",
    ActorType == "User" and RiskySignin,
            "review required. User sign-in context contains elevated risk signals near the Azure activity.",
    NewActorOperation and RareTenantOperation,
            "potentially suspicious. Operation is new for actor and rare in tenant baseline. Deep-dive recommended.",
    ActorOperationCount > 20 and ActorSubscriptionDaysSeen > 10 and ActorResourceTypeDaysSeen > 10,
            "likely benign based on legacy frequency. Validate change context if required.",
    RelatedBurst,
            "review required. High surrounding Azure activity observed near the alert.",
    "review required. Mixed or insufficient context for confident closure from narrative alone."
))
//
// --- Verdict-class, Analyst assessment, ASK BLOCK ---
// Derived in parallel from the same computed signals as _determination —
// never parsed from the determination text. Branch order mirrors
// _determination so a signal change updates all branches in lockstep.
// ASK BLOCK is branch-aware: the SP/MI suspicious-context branch and the
// new+rare operation branch each get their own action items.
| extend
    _verdictClass = case(
        ActorType in ("Service Principal / AppId", "Managed Identity")
            and RecentSpCredentialChange and IsSensitiveCategory,
                "escalation",
        ActorType in ("Service Principal / AppId", "Managed Identity")
            and ActorOperationCount > 20 and ActorSubscriptionDaysSeen > 10 and ActorResourceTypeDaysSeen > 10 and SpChangeCount == 0 and SpRoleChangeCount == 0,
                "benign",
        ActorType == "User" and RiskySignin,
                "review",
        NewActorOperation and RareTenantOperation,
                "escalation",
        ActorOperationCount > 20 and ActorSubscriptionDaysSeen > 10 and ActorResourceTypeDaysSeen > 10,
                "benign",
        RelatedBurst,
                "review",
        "review"
    ),
    _analystAssessment = case(
        ActorType in ("Service Principal / AppId", "Managed Identity")
            and RecentSpCredentialChange and IsSensitiveCategory,
                "- Analyst assessment: the actor is a service principal or managed identity that performed sensitive control-plane activity close to a recent app or credential change. Confirm whether the credential change was authorised and whether the subsequent activity matches the change's documented purpose.",
        ActorType in ("Service Principal / AppId", "Managed Identity")
            and ActorOperationCount > 20 and ActorSubscriptionDaysSeen > 10 and ActorResourceTypeDaysSeen > 10 and SpChangeCount == 0 and SpRoleChangeCount == 0,
                "",
        ActorType == "User" and RiskySignin,
                "- Analyst assessment: the user actor's sign-in context shows elevated risk signals near the Azure activity. Correlate against Identity Protection alerts and confirm whether the session was recognised by the actor.",
        NewActorOperation and RareTenantOperation,
                "- Analyst assessment: the operation is new for the actor and rare in the tenant baseline. Confirm whether the operation was authorised and expected for the actor's role.",
        ActorOperationCount > 20 and ActorSubscriptionDaysSeen > 10 and ActorResourceTypeDaysSeen > 10,
                "",
        RelatedBurst,
                "- Analyst assessment: a high volume of surrounding Azure activity was observed near the alert. Determine whether the burst is a planned change or unexpected automation.",
        "- Analyst assessment: automated heuristics returned mixed signals. Examine the deep-dive output and decide based on actor reputation, operation sensitivity, and timing of surrounding events."
    ),
    _askBlock = case(
        ActorType in ("Service Principal / AppId", "Managed Identity")
            and RecentSpCredentialChange and IsSensitiveCategory,
                strcat(
                    "- ASK BLOCK — required from recipient:",
                    "\n- Confirm whether the recent app or credential change on the actor service principal was authorised, and identify the owner who made the change.",
                    "\n- Confirm whether any consent grants or app role assignments were added to the actor service principal in the same window.",
                    "\n- Confirm whether the sensitive Azure control-plane activity that followed matches the documented purpose of the credential change.",
                    "\n- If the credential change was not authorised: rotate or remove the credential, audit recent activity attributable to the actor, and engage incident response."
                ),
        NewActorOperation and RareTenantOperation,
                strcat(
                    "- ASK BLOCK — required from recipient:",
                    "\n- Confirm whether the actor's operation was authorised and expected for their role.",
                    "\n- Confirm whether a change request, runbook, or maintenance window covers this operation.",
                    "\n- If the operation was not expected: review the actor's recent activity for additional unfamiliar operations and engage incident response."
                ),
        ""
    )
| extend IdentityContextLine = case(
    ActorType == "User" and isnotempty(SigninTime),
        strcat(
            "- User sign-in context: ", tostring(SigninTime),
            " from ", iff(isempty(SigninLocation), "an unrecorded location", SigninLocation),
            "; sign-in source IP captured in the Entities block",
            "; trust type: ", iff(isempty(SigninTrustType), "N/A", SigninTrustType),
            "; managed: ", iff(isempty(SigninIsManaged), "N/A", SigninIsManaged),
            "; compliant: ", iff(isempty(SigninIsCompliant), "N/A", SigninIsCompliant),
            "; risk: ", iff(isempty(SigninRiskLevel), "none/unknown", SigninRiskLevel), "."
        ),
    ActorType == "User",
        "- User sign-in context: no matching sign-in found in scoped window.",
    ActorType in ("Service Principal / AppId", "Managed Identity") and (SpChangeCount > 0 or SpRoleChangeCount > 0),
        strcat(
            "- App/SP context: ", tostring(SpChangeCount), " app or credential change(s), ",
            tostring(SpRoleChangeCount), " role/permission change(s) observed within ±",
            humanTimespan(IdentityContextWindow), "."
        ),
    ActorType in ("Service Principal / AppId", "Managed Identity"),
        strcat("- App/SP context: no app/credential or role/permission changes observed within ±", humanTimespan(IdentityContextWindow), "."),
    "- Identity context: actor type unclear; review actor manually."
)
// --- Assemble (verdict-first; literal entities replaced with role labels; zero counters suppressed) ---
| extend InvestigationNarrative = strcat_array(array_concat(
    pack_array(_determination),
    iff(isnotempty(_analystAssessment), pack_array(_analystAssessment), dynamic([])),
    iff(isnotempty(_askBlock),          pack_array(_askBlock),          dynamic([])),
    pack_array(
        strcat("- Generated: ", format_datetime(now(), "yyyy-MM-dd HH:mm"), " UTC"),
        strcat("- Azure activity reviewed for ", iff(isempty(AlertTitle), "Azure Activity alert", AlertTitle), "."),
        strcat("- TimeGenerated: ", tostring(TimeGenerated), "."),
        strcat("- Activity category: ", ActivityCategory, "."),
        strcat("- Actor type: ", ActorType, "; actor identifier captured in the Entities block."),
        "- Source IP captured in the Entities block.",
        strcat("- Operation: ", Operation, "; status: ", Status, "."),
        strcat("- Target resource of type ", iff(isempty(ResourceType), "N/A", ResourceType), "; subscription scope, resource group and full resource id captured in the Entities block."),
        strcat("- Actor operation history: ", ActorOperationFamiliarity,
            iff(ActorOperationCount > 0,
                strcat("; ", tostring(ActorOperationCount), " prior event(s) across ", tostring(ActorOperationDaysSeen), " day(s) in ", BaselineLabel),
                ""),
            "."),
        strcat("- Actor IP familiarity: ", ActorIpFamiliarity,
            iff(ActorIpCount > 0,
                strcat("; ", tostring(ActorIpCount), " prior event(s) across ", tostring(ActorIpDaysSeen), " day(s) in ", BaselineLabel),
                ""),
            "."),
        strcat("- Actor subscription familiarity: ", ActorSubscriptionFamiliarity,
            iff(ActorSubscriptionCount > 0,
                strcat("; ", tostring(ActorSubscriptionCount), " prior event(s) across ", tostring(ActorSubscriptionDaysSeen), " day(s) in ", BaselineLabel),
                ""),
            "."),
        strcat("- Actor resource-type familiarity: ", ActorResourceTypeFamiliarity,
            iff(ActorResourceTypeCount > 0,
                strcat("; ", tostring(ActorResourceTypeCount), " prior event(s) across ", tostring(ActorResourceTypeDaysSeen), " day(s) in ", BaselineLabel),
                ""),
            "."),
        strcat("- Tenant operation familiarity: ", TenantOperationFamiliarity,
            iff(TenantOperationCount > 0,
                strcat("; ", tostring(TenantOperationCount), " prior event(s) across ", tostring(TenantOperationActors), " actor(s) in ", BaselineLabel),
                ""),
            "."),
        iff(RelatedOps == 0,
            strcat("- Related activity: none observed within ±", humanTimespan(EventWindow), "."),
            strcat("- Related activity: ", tostring(RelatedOps), " related Azure operation(s) within ±", humanTimespan(EventWindow), "; ",
                tostring(RelatedSuccess), " success(es), ", tostring(RelatedFailures), " failure(s), ",
                tostring(RelatedResources), " resource(s).")),
        IdentityContextLine,
        strcat("- Behavioural flags: ", iff(isempty(BehaviouralFlags), "none", BehaviouralFlags), ".")
    )
), "\n")
| project InvestigationNarrative
