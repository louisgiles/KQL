// name:              Suspicious Device-Code Sign-In - Rapid Decision
// purpose:           Reduce one suspicious direct device-code sign-in to explicit client/resource,
//                    protocol-prevalence, network-change, and containment decision nodes.
// starting_entities: Exact user UPN and sign-in event time; SigninLogs.Id, CorrelationId, and source IP are optional disambiguators.
// required_tables:   SigninLogs
// optional_tables:   none
// variables:         AlertTime, TargetUPN, TargetSignInId, TargetCorrelationId, TargetIPAddress,
//                    BrokerDRSProhibitedByPolicy, alert/baseline windows, clean-history gap, and frequency thresholds.
// time_window:       Target within +/-5m of AlertTime; 90d clean history ending 24h before the alert window.
// done_criteria:     One successful direct device-code flow isolated; tenant-scoped client -> resource path,
//                    user/tenant protocol history, UPN/device ASN-country state, coverage, action, and reason returned.
// artifact_type:     investigation
// output_type:       quick-triage
//
let AlertTime = datetime(null);                 // required: actual UTC sign-in time, not incident creation time
let TargetUPN = "";                             // required: exact UPN
let TargetSignInId = "";                        // optional: SigninLogs.Id; preferred
let TargetCorrelationId = "";                   // optional
let TargetIPAddress = "";                       // optional: exact IP
let BrokerDRSProhibitedByPolicy = false;        // set true only when tenant policy explicitly prohibits this path
//
let AlertHalfWindow = 5m;
let AlertIngestionSlack = 1h;
let BaselineWindow = 90d;
let CleanHistoryGap = 24h;                      // prevents the current campaign from normalising itself
let BaselineIngestionGrace = 2d;
let CoverageStartTolerance = 7d;
let CoverageEndTolerance = 1d;
let CoverageMinActiveDays = 60;
let SuddenChangeMaxGapHours = 168;              // 7d
// Keep the success rank larger than either bounded LogTime scan, even when grace settings change.
let SuccessPreferenceShift = BaselineWindow + CleanHistoryGap
    + BaselineIngestionGrace + BaselineIngestionGrace
    + AlertIngestionSlack + AlertIngestionSlack + 1d;
//
// Initial transparent thresholds. Calibrate them per tenant and keep the raw counts in Evidence.
let UserEstablishedMinFlows = 3;
let UserEstablishedMinActiveDays = 2;
let TenantFrequentMinFlows = 20;
let TenantFrequentMinUsers = 5;
let TenantFrequentMinActiveDays = 10;
//
let InputsPresent = isnotempty(TargetUPN) and isnotnull(AlertTime);
let AlertWindowStart = AlertTime - AlertHalfWindow;
let AlertWindowEnd = AlertTime + AlertHalfWindow;
let BaselineEnd = AlertWindowStart - CleanHistoryGap;
let BaselineStart = BaselineEnd - BaselineWindow;
let Prior90dStart = AlertWindowStart - BaselineWindow;

let CandidateRows = materialize(
    SigninLogs
    | where InputsPresent
    | where TimeGenerated between
        (AlertWindowStart - AlertIngestionSlack .. AlertWindowEnd + AlertIngestionSlack)
    | extend EventTime = coalesce(CreatedDateTime, TimeGenerated), LogTime = TimeGenerated
    | where EventTime between (AlertWindowStart .. AlertWindowEnd)
    | where UserPrincipalName =~ TargetUPN
    | where isempty(TargetSignInId) or tostring(Id) =~ TargetSignInId
    | where isempty(TargetCorrelationId) or tostring(CorrelationId) =~ TargetCorrelationId
    | where isempty(TargetIPAddress) or tostring(IPAddress) == TargetIPAddress
    | extend
        RowSignInId = tolower(tostring(Id)),
        RowOriginalRequestId = tolower(tostring(OriginalRequestId)),
        RowCorrelationId = tolower(tostring(CorrelationId)),
        RowSessionId = tolower(tostring(SessionId)),
        RowAppId = tolower(tostring(AppId)),
        OriginalTransfer = tostring(column_ifexists("OriginalTransferMethod", "")),
        IsDirectDeviceCode = AuthenticationProtocol =~ "deviceCode"
    | extend
        IsProtocolTrackedDeviceCode = OriginalTransfer in~ ("deviceCodeFlow", "deviceCode"),
        FlowKey = case(
            isnotempty(RowOriginalRequestId), strcat("request:", RowOriginalRequestId),
            isnotempty(RowCorrelationId), strcat("correlation:", RowCorrelationId),
            isnotempty(RowSignInId), strcat("id:", RowSignInId),
            strcat(
                "fallback:", tolower(UserPrincipalName), "|",
                tostring(EventTime), "|",
                tostring(IPAddress), "|", RowAppId)),
        FlowKeyBasis = case(
            isnotempty(RowOriginalRequestId), "OriginalRequestId",
            isnotempty(RowCorrelationId), "CorrelationId",
            isnotempty(RowSignInId), "Id",
            "Fallback")
    | extend
        Device = todynamic(DeviceDetail),
        Geo = todynamic(LocationDetails),
        GsaValue = tobool(column_ifexists("IsThroughGlobalSecureAccess", bool(null)))
    | project
        EventTime,
        LogTime,
        FlowKey,
        FlowKeyBasis,
        IsDirectDeviceCode,
        IsProtocolTrackedDeviceCode,
        AlertUPN = tolower(UserPrincipalName),
        AlertUserId = tolower(tostring(UserId)),
        AlertAADTenantId = tolower(tostring(AADTenantId)),
        AlertSignInId = tostring(Id),
        AlertOriginalRequestId = tostring(OriginalRequestId),
        AlertCorrelationId = tostring(CorrelationId),
        AlertSessionId = tostring(SessionId),
        AlertSuccess = tostring(ResultType) == "0",
        AlertResultType = tostring(ResultType),
        AlertResultDescription = tostring(ResultDescription),
        AlertAuthenticationProtocol = tostring(AuthenticationProtocol),
        AlertOriginalTransferMethod = OriginalTransfer,
        AlertAppId = RowAppId,
        AlertAppDisplayName = tostring(AppDisplayName),
        AlertAppOwnerTenantId = tostring(column_ifexists("AppOwnerTenantId", "")),
        AlertResourceId = tolower(tostring(ResourceId)),
        AlertResourceDisplayName = tostring(ResourceDisplayName),
        AlertClientAppUsed = tostring(ClientAppUsed),
        AlertIPAddress = tostring(IPAddress),
        AlertASN = iff(tostring(AutonomousSystemNumber) == "0", "", tostring(AutonomousSystemNumber)),
        AlertCountry = toupper(coalesce(tostring(Location), tostring(Geo.countryOrRegion))),
        AlertCity = tostring(Geo.city),
        AlertState = tostring(Geo.state),
        AlertDeviceId = tolower(tostring(Device.deviceId)),
        AlertDeviceName = tostring(Device.displayName),
        AlertDeviceOS = tostring(Device.operatingSystem),
        AlertDeviceBrowser = tostring(Device.browser),
        AlertDeviceManaged = tostring(Device.isManaged),
        AlertDeviceCompliant = tostring(Device.isCompliant),
        AlertDeviceTrustType = tostring(Device.trustType),
        AlertRiskLevel = tostring(RiskLevelDuringSignIn),
        AlertRiskState = tostring(RiskState),
        AlertRiskEvents = tostring(column_ifexists("RiskEventTypes_V2", "")),
        AlertConditionalAccessStatus = tostring(ConditionalAccessStatus),
        AlertAuthenticationRequirement = tostring(AuthenticationRequirement),
        AlertThroughGlobalSecureAccessKnown = isnotnull(GsaValue),
        AlertThroughGlobalSecureAccess = coalesce(GsaValue, false),
        AlertGlobalSecureAccessIP = tostring(column_ifexists("GlobalSecureAccessIpAddress", "")),
        AlertNetworkLocationDetails = tostring(NetworkLocationDetails)
);
let AlertRows = materialize(CandidateRows | where IsDirectDeviceCode);
// Prefer a successful direct row when a flow has both successful and failed records.
let AlertFlows = materialize(
    AlertRows
    | extend RepresentativeSort = LogTime + iff(AlertSuccess, SuccessPreferenceShift, 0d)
    | summarize arg_max(RepresentativeSort, *) by FlowKey
);
let AlertRawRowCount = toscalar(AlertRows | summarize count());
let AlertFlowCount = toscalar(AlertFlows | summarize count());
let TrackedDeviceCodeOnlyRows = toscalar(
    CandidateRows
    | where not(IsDirectDeviceCode) and IsProtocolTrackedDeviceCode
    | summarize count());
let Alert = materialize(
    AlertFlows
    | extend DistanceSeconds = abs(datetime_diff("second", EventTime, AlertTime))
    | sort by DistanceSeconds asc, LogTime desc
    | take 1
    | extend JoinKey = 1
);
//
let AnchorUserId = tostring(toscalar(Alert | project AlertUserId));
let AnchorUPN = coalesce(tostring(toscalar(Alert | project AlertUPN)), tolower(TargetUPN));
let AnchorAADTenantId = tostring(toscalar(Alert | project AlertAADTenantId));
let AnchorAppId = tostring(toscalar(Alert | project AlertAppId));
let AnchorResourceId = tostring(toscalar(Alert | project AlertResourceId));
let AnchorASN = tostring(toscalar(Alert | project AlertASN));
let AnchorCountry = tostring(toscalar(Alert | project AlertCountry));
let AnchorDeviceId = tostring(toscalar(Alert | project AlertDeviceId));
let AnchorFlowKey = tostring(toscalar(Alert | project FlowKey));
let AnchorFlowKeyBasis = tostring(toscalar(Alert | project FlowKeyBasis));
let AnchorOriginalRequestId = tolower(tostring(toscalar(Alert | project AlertOriginalRequestId)));
let AnchorCorrelationId = tolower(tostring(toscalar(Alert | project AlertCorrelationId)));
let AnchorSessionId = tolower(tostring(toscalar(Alert | project AlertSessionId)));
let AnchorSignInId = tolower(tostring(toscalar(Alert | project AlertSignInId)));
let AnchorAlertSuccess = coalesce(tobool(toscalar(Alert | project AlertSuccess)), false);
let CanBaseline = InputsPresent
    and AlertFlowCount == 1
    and AnchorAlertSuccess
    and AnchorFlowKeyBasis != "Fallback"
    and isnotempty(AnchorAADTenantId);

let CoverageStats =
    SigninLogs
    | where CanBaseline
    | where TimeGenerated between
        (BaselineStart - BaselineIngestionGrace .. AlertWindowStart + BaselineIngestionGrace)
    | where AADTenantId =~ AnchorAADTenantId
    | extend EventTime = coalesce(CreatedDateTime, TimeGenerated)
    | where EventTime >= BaselineStart and EventTime < AlertWindowStart
    | summarize
        PriorTenantRows = countif(EventTime < BaselineEnd),
        PriorEarliestEvent = minif(EventTime, EventTime < BaselineEnd),
        PriorLatestEvent = maxif(EventTime, EventTime < BaselineEnd),
        PriorTenantActiveDays = dcount(iff(
            EventTime < BaselineEnd, startofday(EventTime), datetime(null))),
        Prior90dTenantRows = countif(EventTime >= Prior90dStart),
        Prior90dEarliestEvent = minif(EventTime, EventTime >= Prior90dStart),
        Prior90dLatestEvent = maxif(EventTime, EventTime >= Prior90dStart),
        Prior90dTenantActiveDays = dcount(iff(
            EventTime >= Prior90dStart, startofday(EventTime), datetime(null)))
    | extend JoinKey = 1;

let TenantDeviceCodeFlows = materialize(
    SigninLogs
    | where CanBaseline
    | where TimeGenerated between
        (BaselineStart - BaselineIngestionGrace .. BaselineEnd + BaselineIngestionGrace)
    | where AADTenantId =~ AnchorAADTenantId
    | where AuthenticationProtocol =~ "deviceCode"
    | where tostring(ResultType) == "0"
    | extend EventTime = coalesce(CreatedDateTime, TimeGenerated), LogTime = TimeGenerated
    | where EventTime >= BaselineStart and EventTime < BaselineEnd
    | extend
        PriorUPN = tolower(UserPrincipalName),
        PriorUserId = tolower(tostring(UserId)),
        PriorAppId = tolower(tostring(AppId)),
        PriorResourceId = tolower(tostring(ResourceId)),
        PriorSignInId = tolower(tostring(Id)),
        PriorOriginalRequestId = tolower(tostring(OriginalRequestId)),
        PriorCorrelationId = tolower(tostring(CorrelationId)),
        PriorSessionId = tolower(tostring(SessionId))
    | extend
        PriorUserKey = iff(isnotempty(PriorUserId), PriorUserId, PriorUPN),
        FlowKey = case(
            isnotempty(PriorOriginalRequestId), strcat("request:", PriorOriginalRequestId),
            isnotempty(PriorCorrelationId), strcat("correlation:", PriorCorrelationId),
            isnotempty(PriorSignInId), strcat("id:", PriorSignInId),
            strcat(
                "fallback:", PriorUPN, "|", tostring(EventTime), "|",
                tostring(IPAddress), "|", PriorAppId)),
        FlowKeyBasis = case(
            isnotempty(PriorOriginalRequestId), "OriginalRequestId",
            isnotempty(PriorCorrelationId), "CorrelationId",
            isnotempty(PriorSignInId), "Id",
            "Fallback")
    | extend IsAnchorSequence =
        (isnotempty(AnchorOriginalRequestId) and PriorOriginalRequestId == AnchorOriginalRequestId)
        or (isnotempty(AnchorCorrelationId) and PriorCorrelationId == AnchorCorrelationId)
        or (isnotempty(AnchorSessionId) and PriorSessionId == AnchorSessionId)
        or (isnotempty(AnchorSignInId) and PriorSignInId == AnchorSignInId)
        or FlowKey == AnchorFlowKey
    | where not(IsAnchorSequence)
    | project
        FlowKey,
        LogTime,
        EventTime,
        PriorUserKey,
        PriorAppId,
        PriorResourceId,
        FlowKeyBasis
    | summarize arg_max(LogTime, *) by FlowKey
    | project
        EventTime,
        EventDay = startofday(EventTime),
        PriorUserKey,
        PriorAppId,
        PriorResourceId,
        FlowKeyBasis
);
let TenantProtocolStats =
    TenantDeviceCodeFlows
    | where FlowKeyBasis != "Fallback" and isnotempty(PriorUserKey)
    | summarize
        TenantDeviceCodeFlows = count(),
        TenantDeviceCodeUsers = dcount(PriorUserKey),
        TenantDeviceCodeActiveDays = dcount(EventDay)
    | extend JoinKey = 1;
let TenantSamePathStats =
    TenantDeviceCodeFlows
    | where FlowKeyBasis != "Fallback" and isnotempty(PriorUserKey)
    | where isnotempty(AnchorAppId) and isnotempty(AnchorResourceId)
    | where PriorAppId == AnchorAppId and PriorResourceId == AnchorResourceId
    | summarize
        TenantSamePathDeviceCodeFlows = count(),
        TenantSamePathDeviceCodeUsers = dcount(PriorUserKey),
        TenantSamePathDeviceCodeActiveDays = dcount(EventDay)
    | extend JoinKey = 1;
let TenantProtocolQualityStats =
    TenantDeviceCodeFlows
    | summarize TenantDeviceCodeFallbackFlows = countif(FlowKeyBasis == "Fallback")
    | extend JoinKey = 1;

let UserRows = materialize(
    SigninLogs
    | where CanBaseline
    | where TimeGenerated between
        (BaselineStart - BaselineIngestionGrace .. AlertWindowStart + BaselineIngestionGrace)
    | where AADTenantId =~ AnchorAADTenantId
    | where (isnotempty(AnchorUserId) and UserId =~ AnchorUserId)
        or (isempty(AnchorUserId) and UserPrincipalName =~ AnchorUPN)
    | extend EventTime = coalesce(CreatedDateTime, TimeGenerated), LogTime = TimeGenerated
    | where EventTime >= BaselineStart and EventTime < AlertWindowStart
    | extend
        IsCleanBaseline = EventTime < BaselineEnd,
        IsWithinPrior90d = EventTime >= AlertWindowStart - BaselineWindow,
        IsWithinRecent24h = EventTime >= AlertWindowStart - 24h,
        Device = todynamic(DeviceDetail),
        Geo = todynamic(LocationDetails)
    | extend
        PriorUPN = tolower(UserPrincipalName),
        PriorUserId = tolower(tostring(UserId)),
        PriorDeviceId = tolower(tostring(Device.deviceId)),
        PriorAppId = tolower(tostring(AppId)),
        PriorResourceId = tolower(tostring(ResourceId)),
        PriorASN = iff(tostring(AutonomousSystemNumber) == "0", "", tostring(AutonomousSystemNumber)),
        PriorCountry = toupper(coalesce(tostring(Location), tostring(Geo.countryOrRegion))),
        PriorSignInId = tolower(tostring(Id)),
        PriorOriginalRequestId = tolower(tostring(OriginalRequestId)),
        PriorCorrelationId = tolower(tostring(CorrelationId)),
        PriorSessionId = tolower(tostring(SessionId)),
        IsSuccess = tostring(ResultType) == "0",
        IsDirectDeviceCode = AuthenticationProtocol =~ "deviceCode"
    | extend
        FlowKey = case(
            isnotempty(PriorOriginalRequestId), strcat("request:", PriorOriginalRequestId),
            isnotempty(PriorCorrelationId), strcat("correlation:", PriorCorrelationId),
            isnotempty(PriorSignInId), strcat("id:", PriorSignInId),
            strcat(
                "fallback:", PriorUPN, "|", tostring(EventTime), "|",
                tostring(IPAddress), "|", PriorAppId)),
        FlowKeyBasis = case(
            isnotempty(PriorOriginalRequestId), "OriginalRequestId",
            isnotempty(PriorCorrelationId), "CorrelationId",
            isnotempty(PriorSignInId), "Id",
            "Fallback")
    | extend IsAnchorSequence =
        (isnotempty(AnchorOriginalRequestId) and PriorOriginalRequestId == AnchorOriginalRequestId)
        or (isnotempty(AnchorCorrelationId) and PriorCorrelationId == AnchorCorrelationId)
        or (isnotempty(AnchorSessionId) and PriorSessionId == AnchorSessionId)
        or (isnotempty(AnchorSignInId) and PriorSignInId == AnchorSignInId)
        or FlowKey == AnchorFlowKey
    | where not(IsAnchorSequence)
    | project
        FlowKey,
        LogTime,
        EventTime,
        IsCleanBaseline,
        IsWithinPrior90d,
        IsWithinRecent24h,
        FlowKeyBasis,
        IsSuccess,
        IsDirectDeviceCode,
        PriorAppId,
        PriorResourceId,
        PriorASN,
        PriorCountry,
        PriorDeviceId,
        PriorIPAddress = tostring(IPAddress)
);
let UserFlows = materialize(
    UserRows
    | summarize arg_max(LogTime, *) by FlowKey
    | project
        EventTime,
        EventDay = startofday(EventTime),
        LogTime,
        IsCleanBaseline,
        IsWithinPrior90d,
        IsWithinRecent24h,
        FlowKeyBasis,
        IsSuccess,
        IsDirectDeviceCode,
        PriorAppId,
        PriorResourceId,
        PriorASN,
        PriorCountry,
        PriorDeviceId,
        PriorIPAddress
);
let UserSuccessfulFlows = materialize(
    UserRows
    | where IsSuccess
    | summarize arg_max(LogTime, *) by FlowKey
    | project
        EventTime,
        EventDay = startofday(EventTime),
        LogTime,
        IsCleanBaseline,
        FlowKeyBasis,
        PriorASN,
        PriorCountry,
        PriorDeviceId,
        PriorIPAddress
);
let UserDeviceCodeFlows = materialize(
    UserRows
    | where IsDirectDeviceCode
    | extend RepresentativeSort = LogTime + iff(IsSuccess, SuccessPreferenceShift, 0d)
    | summarize arg_max(RepresentativeSort, *) by FlowKey
    | project
        EventTime,
        EventDay = startofday(EventTime),
        LogTime,
        IsCleanBaseline,
        IsWithinPrior90d,
        IsWithinRecent24h,
        FlowKeyBasis,
        IsSuccess,
        PriorAppId,
        PriorResourceId
);
let UserDeviceCodeSuccessStats =
    UserDeviceCodeFlows
    | where IsCleanBaseline and FlowKeyBasis != "Fallback" and IsSuccess
    | summarize
        UserDeviceCodeSuccesses = count(),
        UserDeviceCodeActiveDays = dcount(EventDay),
        UserDeviceCodeFirstSuccess = min(EventTime),
        UserDeviceCodeLastSuccess = max(EventTime),
        UserSameAppDeviceCodeSuccesses = countif(isnotempty(AnchorAppId) and PriorAppId == AnchorAppId),
        UserSamePathDeviceCodeSuccesses = countif(
            isnotempty(AnchorAppId) and isnotempty(AnchorResourceId)
            and PriorAppId == AnchorAppId and PriorResourceId == AnchorResourceId)
    | extend JoinKey = 1;
let UserDeviceCodeFailureStats =
    UserDeviceCodeFlows
    | where IsCleanBaseline and FlowKeyBasis != "Fallback" and not(IsSuccess)
    | summarize UserDeviceCodeFailures = count()
    | extend JoinKey = 1;
let Prior90dUserDeviceCodeStats =
    UserDeviceCodeFlows
    | where IsWithinPrior90d and FlowKeyBasis != "Fallback"
    | summarize
        Prior90dStableDeviceCodeAttempts = count(),
        Prior90dStableDeviceCodeSuccesses = countif(IsSuccess),
        Prior90dStableDeviceCodeFailures = countif(not(IsSuccess)),
        Recent24hStableDeviceCodeAttempts = countif(IsWithinRecent24h),
        Recent24hStableDeviceCodeSuccesses = countif(IsWithinRecent24h and IsSuccess),
        Recent24hStableDeviceCodeFailures = countif(IsWithinRecent24h and not(IsSuccess))
    | extend JoinKey = 1;
let UserQualityStats =
    UserFlows
    | where IsCleanBaseline
    | summarize UserFallbackFlows = countif(FlowKeyBasis == "Fallback")
    | extend JoinKey = 1;
let UserDeviceCodeQualityStats =
    UserDeviceCodeFlows
    | summarize
        UserDeviceCodeFallbackFlows = countif(IsCleanBaseline and FlowKeyBasis == "Fallback"),
        UserDeviceCodeFallbackSuccesses = countif(
            IsCleanBaseline and FlowKeyBasis == "Fallback" and IsSuccess),
        Prior90dDeviceCodeFallbackAttempts = countif(
            IsWithinPrior90d and FlowKeyBasis == "Fallback"),
        Prior90dDeviceCodeFallbackSuccesses = countif(
            IsWithinPrior90d and FlowKeyBasis == "Fallback" and IsSuccess),
        Prior90dDeviceCodeFallbackFailures = countif(
            IsWithinPrior90d and FlowKeyBasis == "Fallback" and not(IsSuccess)),
        Recent24hDeviceCodeFallbackAttempts = countif(
            IsWithinRecent24h and FlowKeyBasis == "Fallback"),
        Recent24hDeviceCodeFallbackSuccesses = countif(
            IsWithinRecent24h and FlowKeyBasis == "Fallback" and IsSuccess),
        Recent24hDeviceCodeFallbackFailures = countif(
            IsWithinRecent24h and FlowKeyBasis == "Fallback" and not(IsSuccess))
    | extend JoinKey = 1;
let UserNetworkStats =
    UserSuccessfulFlows
    | where IsCleanBaseline and FlowKeyBasis != "Fallback"
    | summarize
        UserSuccessfulFlows = count(),
        UserKnownASNFlows = countif(isnotempty(PriorASN)),
        UserCurrentASNMatches = countif(isnotempty(AnchorASN) and PriorASN == AnchorASN),
        UserKnownCountryFlows = countif(isnotempty(PriorCountry)),
        UserCurrentCountryMatches = countif(isnotempty(AnchorCountry) and PriorCountry == AnchorCountry),
        UserKnownNetworkPairFlows = countif(isnotempty(PriorASN) and isnotempty(PriorCountry)),
        UserCurrentNetworkPairMatches = countif(
            isnotempty(AnchorASN) and isnotempty(AnchorCountry)
            and PriorASN == AnchorASN and PriorCountry == AnchorCountry)
    | extend JoinKey = 1;
let PreviousUserSignIn =
    UserSuccessfulFlows
    | where FlowKeyBasis != "Fallback"
    | sort by EventTime desc, LogTime desc
    | take 1
    | project
        JoinKey = 1,
        PreviousUserEventTime = EventTime,
        PreviousUserIPAddress = PriorIPAddress,
        PreviousUserASN = PriorASN,
        PreviousUserCountry = PriorCountry,
        PreviousUserDeviceId = PriorDeviceId;

let DeviceFlows = materialize(
    SigninLogs
    | where CanBaseline and isnotempty(AnchorDeviceId)
    | where TimeGenerated between
        (BaselineStart - BaselineIngestionGrace .. AlertWindowStart + BaselineIngestionGrace)
    | where AADTenantId =~ AnchorAADTenantId
    | where tostring(ResultType) == "0"
    | where tostring(DeviceDetail.deviceId) =~ AnchorDeviceId
    | extend EventTime = coalesce(CreatedDateTime, TimeGenerated), LogTime = TimeGenerated
    | where EventTime >= BaselineStart and EventTime < AlertWindowStart
    | extend IsCleanBaseline = EventTime < BaselineEnd, Geo = todynamic(LocationDetails)
    | extend
        PriorUPN = tolower(UserPrincipalName),
        PriorAppId = tolower(tostring(AppId)),
        PriorASN = iff(tostring(AutonomousSystemNumber) == "0", "", tostring(AutonomousSystemNumber)),
        PriorCountry = toupper(coalesce(tostring(Location), tostring(Geo.countryOrRegion))),
        PriorSignInId = tolower(tostring(Id)),
        PriorOriginalRequestId = tolower(tostring(OriginalRequestId)),
        PriorCorrelationId = tolower(tostring(CorrelationId)),
        PriorSessionId = tolower(tostring(SessionId))
    | extend
        FlowKey = case(
            isnotempty(PriorOriginalRequestId), strcat("request:", PriorOriginalRequestId),
            isnotempty(PriorCorrelationId), strcat("correlation:", PriorCorrelationId),
            isnotempty(PriorSignInId), strcat("id:", PriorSignInId),
            strcat(
                "fallback:", PriorUPN, "|", tostring(EventTime), "|",
                tostring(IPAddress), "|", PriorAppId)),
        FlowKeyBasis = case(
            isnotempty(PriorOriginalRequestId), "OriginalRequestId",
            isnotempty(PriorCorrelationId), "CorrelationId",
            isnotempty(PriorSignInId), "Id",
            "Fallback")
    | extend IsAnchorSequence =
        (isnotempty(AnchorOriginalRequestId) and PriorOriginalRequestId == AnchorOriginalRequestId)
        or (isnotempty(AnchorCorrelationId) and PriorCorrelationId == AnchorCorrelationId)
        or (isnotempty(AnchorSessionId) and PriorSessionId == AnchorSessionId)
        or (isnotempty(AnchorSignInId) and PriorSignInId == AnchorSignInId)
        or FlowKey == AnchorFlowKey
    | where not(IsAnchorSequence)
    | project
        FlowKey,
        LogTime,
        EventTime,
        IsCleanBaseline,
        FlowKeyBasis,
        PriorASN,
        PriorCountry,
        PriorIPAddress = tostring(IPAddress)
    | summarize arg_max(LogTime, *) by FlowKey
    | project
        EventTime,
        LogTime,
        IsCleanBaseline,
        FlowKeyBasis,
        PriorASN,
        PriorCountry,
        PriorIPAddress
);
let DeviceNetworkStats =
    DeviceFlows
    | where IsCleanBaseline and FlowKeyBasis != "Fallback"
    | summarize
        DeviceSuccessfulFlows = count(),
        DeviceKnownASNFlows = countif(isnotempty(PriorASN)),
        DeviceCurrentASNMatches = countif(isnotempty(AnchorASN) and PriorASN == AnchorASN),
        DeviceKnownCountryFlows = countif(isnotempty(PriorCountry)),
        DeviceCurrentCountryMatches = countif(isnotempty(AnchorCountry) and PriorCountry == AnchorCountry),
        DeviceKnownNetworkPairFlows = countif(isnotempty(PriorASN) and isnotempty(PriorCountry)),
        DeviceCurrentNetworkPairMatches = countif(
            isnotempty(AnchorASN) and isnotempty(AnchorCountry)
            and PriorASN == AnchorASN and PriorCountry == AnchorCountry)
    | extend JoinKey = 1;
let DeviceQualityStats =
    DeviceFlows
    | where IsCleanBaseline
    | summarize DeviceFallbackFlows = countif(FlowKeyBasis == "Fallback")
    | extend JoinKey = 1;
let PreviousDeviceSignIn =
    DeviceFlows
    | where FlowKeyBasis != "Fallback"
    | sort by EventTime desc, LogTime desc
    | take 1
    | project
        JoinKey = 1,
        PreviousDeviceEventTime = EventTime,
        PreviousDeviceIPAddress = PriorIPAddress,
        PreviousDeviceASN = PriorASN,
        PreviousDeviceCountry = PriorCountry;

print JoinKey = 1
| join kind=leftouter Alert on JoinKey
| join kind=leftouter CoverageStats on JoinKey
| join kind=leftouter TenantProtocolStats on JoinKey
| join kind=leftouter TenantSamePathStats on JoinKey
| join kind=leftouter TenantProtocolQualityStats on JoinKey
| join kind=leftouter UserDeviceCodeSuccessStats on JoinKey
| join kind=leftouter UserDeviceCodeFailureStats on JoinKey
| join kind=leftouter Prior90dUserDeviceCodeStats on JoinKey
| join kind=leftouter UserQualityStats on JoinKey
| join kind=leftouter UserDeviceCodeQualityStats on JoinKey
| join kind=leftouter UserNetworkStats on JoinKey
| join kind=leftouter PreviousUserSignIn on JoinKey
| join kind=leftouter DeviceNetworkStats on JoinKey
| join kind=leftouter DeviceQualityStats on JoinKey
| join kind=leftouter PreviousDeviceSignIn on JoinKey
| extend
    AlertRawRowCount = AlertRawRowCount,
    AlertFlowCount = AlertFlowCount,
    TrackedDeviceCodeOnlyRows = TrackedDeviceCodeOnlyRows,
    BaselineStart = BaselineStart,
    BaselineEnd = BaselineEnd,
    Prior90dStart = Prior90dStart,
    CleanHistoryGap = CleanHistoryGap,
    UserKeyBasis = iff(isnotempty(AlertUserId), "UserId", "exact UPN fallback")
| extend BaselineCoverageState = case(
    not(InputsPresent), "NOT_RUN_MISSING_INPUT",
    AlertFlowCount != 1, "NOT_RUN_ALERT_NOT_ISOLATED",
    not(AlertSuccess), "NOT_RUN_TARGET_NOT_SUCCESSFUL",
    FlowKeyBasis == "Fallback", "NOT_RUN_FALLBACK_FLOW_KEY",
    isempty(AlertAADTenantId), "NOT_RUN_AAD_TENANT_ID_UNAVAILABLE",
    PriorTenantRows == 0, "NO_TENANT_BASELINE_ROWS",
    PriorEarliestEvent > BaselineStart + CoverageStartTolerance
        and PriorLatestEvent < BaselineEnd - CoverageEndTolerance, "BOTH_EDGES_UNCONFIRMED",
    PriorEarliestEvent > BaselineStart + CoverageStartTolerance, "START_EDGE_UNCONFIRMED",
    PriorLatestEvent < BaselineEnd - CoverageEndTolerance, "END_EDGE_UNCONFIRMED",
    PriorTenantActiveDays < CoverageMinActiveDays, "CONTINUITY_UNCONFIRMED",
    "90D_CLEAN_WINDOW_OBSERVED"),
    Prior90dCoverageState = case(
        not(InputsPresent), "NOT_RUN_MISSING_INPUT",
        AlertFlowCount != 1, "NOT_RUN_ALERT_NOT_ISOLATED",
        not(AlertSuccess), "NOT_RUN_TARGET_NOT_SUCCESSFUL",
        FlowKeyBasis == "Fallback", "NOT_RUN_FALLBACK_FLOW_KEY",
        isempty(AlertAADTenantId), "NOT_RUN_AAD_TENANT_ID_UNAVAILABLE",
        Prior90dTenantRows == 0, "NO_TENANT_PRIOR_90D_ROWS",
        Prior90dEarliestEvent > Prior90dStart + CoverageStartTolerance
            and Prior90dLatestEvent < AlertWindowStart - CoverageEndTolerance,
            "BOTH_EDGES_UNCONFIRMED",
        Prior90dEarliestEvent > Prior90dStart + CoverageStartTolerance,
            "START_EDGE_UNCONFIRMED",
        Prior90dLatestEvent < AlertWindowStart - CoverageEndTolerance,
            "END_EDGE_UNCONFIRMED",
        Prior90dTenantActiveDays < CoverageMinActiveDays, "CONTINUITY_UNCONFIRMED",
        "PRIOR_90D_WINDOW_OBSERVED")
| extend
    BaselineCoverageComplete = BaselineCoverageState == "90D_CLEAN_WINDOW_OBSERVED",
    Prior90dCoverageComplete = Prior90dCoverageState == "PRIOR_90D_WINDOW_OBSERVED",
    Prior90dDeviceCodeAttempts = Prior90dStableDeviceCodeAttempts
        + Prior90dDeviceCodeFallbackAttempts,
    Prior90dDeviceCodeSuccesses = Prior90dStableDeviceCodeSuccesses
        + Prior90dDeviceCodeFallbackSuccesses,
    Prior90dDeviceCodeFailures = Prior90dStableDeviceCodeFailures
        + Prior90dDeviceCodeFallbackFailures,
    Recent24hDeviceCodeAttempts = Recent24hStableDeviceCodeAttempts
        + Recent24hDeviceCodeFallbackAttempts,
    Recent24hDeviceCodeSuccesses = Recent24hStableDeviceCodeSuccesses
        + Recent24hDeviceCodeFallbackSuccesses,
    Recent24hDeviceCodeFailures = Recent24hStableDeviceCodeFailures
        + Recent24hDeviceCodeFallbackFailures,
    UserProtocolEstablished = UserDeviceCodeSuccesses >= UserEstablishedMinFlows
        and UserDeviceCodeActiveDays >= UserEstablishedMinActiveDays
| extend
    Prior90dDeviceCodeSeen = case(
        Prior90dDeviceCodeAttempts > 0, true,
        Prior90dCoverageComplete, false,
        bool(null)),
    CleanBaselineDeviceCodeSeen = case(
        UserDeviceCodeSuccesses + UserDeviceCodeFailures + UserDeviceCodeFallbackFlows > 0, true,
        BaselineCoverageComplete, false,
        bool(null)),
    CleanBaselinePriorSuccessfulDeviceCodeUse = case(
        UserDeviceCodeSuccesses + UserDeviceCodeFallbackSuccesses > 0, true,
        BaselineCoverageComplete, false,
        bool(null)),
    UserProtocolState = case(
        not(CanBaseline), "NOT_RUN",
        UserDeviceCodeSuccesses == 0 and UserDeviceCodeFallbackSuccesses > 0
            and BaselineCoverageComplete,
            "SUCCESS_SEEN_ONLY_ON_FALLBACK_KEY_IN_CLEAN_90D",
        UserDeviceCodeSuccesses == 0 and UserDeviceCodeFallbackSuccesses > 0,
            "SUCCESS_SEEN_ONLY_ON_FALLBACK_KEY_IN_AVAILABLE_BASELINE",
        UserDeviceCodeSuccesses == 0 and UserDeviceCodeFailures == 0
            and UserDeviceCodeFallbackFlows > 0
            and UserDeviceCodeFallbackSuccesses == 0 and BaselineCoverageComplete,
            "FALLBACK_KEY_ATTEMPTS_ONLY_IN_CLEAN_90D",
        UserDeviceCodeSuccesses == 0 and UserDeviceCodeFailures == 0
            and UserDeviceCodeFallbackFlows > 0 and UserDeviceCodeFallbackSuccesses == 0,
            "FALLBACK_KEY_ATTEMPTS_IN_AVAILABLE_BASELINE",
        UserDeviceCodeSuccesses == 0 and UserDeviceCodeFailures > 0 and BaselineCoverageComplete,
            "PRIOR_FAILURES_ONLY_IN_CLEAN_90D",
        UserDeviceCodeSuccesses == 0 and UserDeviceCodeFailures == 0 and BaselineCoverageComplete,
            "NO_PRIOR_ATTEMPT_IN_CLEAN_90D",
        UserDeviceCodeSuccesses == 0 and UserDeviceCodeFailures > 0,
            "PRIOR_FAILURES_ONLY_IN_AVAILABLE_BASELINE",
        UserDeviceCodeSuccesses == 0, "NOT_SEEN_IN_AVAILABLE_BASELINE",
        UserProtocolEstablished and BaselineCoverageComplete, "ESTABLISHED_SUCCESS_IN_CLEAN_90D",
        UserProtocolEstablished, "ESTABLISHED_SUCCESS_IN_AVAILABLE_BASELINE",
        BaselineCoverageComplete, "RARE_SUCCESS_IN_CLEAN_90D",
        "RARE_SUCCESS_IN_AVAILABLE_BASELINE"),
    TenantFrequencyState = case(
        not(CanBaseline), "NOT_RUN",
        TenantDeviceCodeFlows == 0 and BaselineCoverageComplete, "NO_SUCCESS_IN_CLEAN_90D",
        TenantDeviceCodeFlows == 0, "NOT_SEEN_IN_AVAILABLE_BASELINE",
        TenantDeviceCodeFlows >= TenantFrequentMinFlows
            and TenantDeviceCodeUsers >= TenantFrequentMinUsers
            and TenantDeviceCodeActiveDays >= TenantFrequentMinActiveDays
            and BaselineCoverageComplete, "FREQUENT_SUCCESS_IN_TENANT_CLEAN_90D",
        TenantDeviceCodeFlows >= TenantFrequentMinFlows
            and TenantDeviceCodeUsers >= TenantFrequentMinUsers
            and TenantDeviceCodeActiveDays >= TenantFrequentMinActiveDays,
            "FREQUENT_SUCCESS_IN_AVAILABLE_BASELINE",
        BaselineCoverageComplete, "LIMITED_SUCCESS_IN_TENANT_CLEAN_90D",
        "LIMITED_SUCCESS_IN_AVAILABLE_BASELINE"),
    TenantSamePathFrequencyState = case(
        not(CanBaseline) or isempty(AlertAppId) or isempty(AlertResourceId), "NOT_RUN",
        TenantSamePathDeviceCodeFlows == 0 and BaselineCoverageComplete, "PATH_NOT_SEEN_IN_CLEAN_90D",
        TenantSamePathDeviceCodeFlows == 0, "PATH_NOT_SEEN_IN_AVAILABLE_BASELINE",
        TenantSamePathDeviceCodeFlows >= TenantFrequentMinFlows
            and TenantSamePathDeviceCodeUsers >= TenantFrequentMinUsers
            and TenantSamePathDeviceCodeActiveDays >= TenantFrequentMinActiveDays
            and BaselineCoverageComplete, "PATH_FREQUENT_SUCCESS_IN_TENANT_CLEAN_90D",
        TenantSamePathDeviceCodeFlows >= TenantFrequentMinFlows
            and TenantSamePathDeviceCodeUsers >= TenantFrequentMinUsers
            and TenantSamePathDeviceCodeActiveDays >= TenantFrequentMinActiveDays,
            "PATH_FREQUENT_SUCCESS_IN_AVAILABLE_BASELINE",
        BaselineCoverageComplete, "PATH_LIMITED_SUCCESS_IN_TENANT_CLEAN_90D",
        "PATH_LIMITED_SUCCESS_IN_AVAILABLE_BASELINE")
| extend
    UserASNState = case(
        not(CanBaseline), "NOT_RUN",
        isempty(AlertASN), "CURRENT_ASN_UNAVAILABLE",
        UserKnownASNFlows == 0, "NO_USER_ASN_BASELINE",
        UserCurrentASNMatches > 0 and BaselineCoverageComplete, "FAMILIAR_IN_CLEAN_90D",
        UserCurrentASNMatches > 0, "FAMILIAR_IN_AVAILABLE_BASELINE",
        BaselineCoverageComplete, "NEW_IN_CLEAN_90D",
        "NOT_SEEN_IN_AVAILABLE_BASELINE"),
    UserCountryState = case(
        not(CanBaseline), "NOT_RUN",
        isempty(AlertCountry), "CURRENT_COUNTRY_UNAVAILABLE",
        UserKnownCountryFlows == 0, "NO_USER_COUNTRY_BASELINE",
        UserCurrentCountryMatches > 0 and BaselineCoverageComplete, "FAMILIAR_IN_CLEAN_90D",
        UserCurrentCountryMatches > 0, "FAMILIAR_IN_AVAILABLE_BASELINE",
        BaselineCoverageComplete, "NEW_IN_CLEAN_90D",
        "NOT_SEEN_IN_AVAILABLE_BASELINE"),
    UserNetworkPairState = case(
        not(CanBaseline), "NOT_RUN",
        isempty(AlertASN) or isempty(AlertCountry), "CURRENT_PAIR_UNAVAILABLE",
        UserKnownNetworkPairFlows == 0, "NO_USER_PAIR_BASELINE",
        UserCurrentNetworkPairMatches > 0 and BaselineCoverageComplete, "FAMILIAR_PAIR_IN_CLEAN_90D",
        UserCurrentNetworkPairMatches > 0, "FAMILIAR_PAIR_IN_AVAILABLE_BASELINE",
        BaselineCoverageComplete, "NEW_PAIR_IN_CLEAN_90D",
        "PAIR_NOT_SEEN_IN_AVAILABLE_BASELINE"),
    DeviceASNState = case(
        not(CanBaseline), "NOT_RUN",
        isempty(AlertDeviceId), "RECORDED_DEVICE_ID_UNAVAILABLE",
        DeviceSuccessfulFlows == 0, "NO_RECORDED_DEVICE_BASELINE",
        isempty(AlertASN), "CURRENT_ASN_UNAVAILABLE",
        DeviceKnownASNFlows == 0, "NO_RECORDED_DEVICE_ASN_BASELINE",
        DeviceCurrentASNMatches > 0 and BaselineCoverageComplete, "FAMILIAR_IN_CLEAN_90D",
        DeviceCurrentASNMatches > 0, "FAMILIAR_IN_AVAILABLE_BASELINE",
        BaselineCoverageComplete, "NEW_IN_CLEAN_90D",
        "NOT_SEEN_IN_AVAILABLE_BASELINE"),
    DeviceCountryState = case(
        not(CanBaseline), "NOT_RUN",
        isempty(AlertDeviceId), "RECORDED_DEVICE_ID_UNAVAILABLE",
        DeviceSuccessfulFlows == 0, "NO_RECORDED_DEVICE_BASELINE",
        isempty(AlertCountry), "CURRENT_COUNTRY_UNAVAILABLE",
        DeviceKnownCountryFlows == 0, "NO_RECORDED_DEVICE_COUNTRY_BASELINE",
        DeviceCurrentCountryMatches > 0 and BaselineCoverageComplete, "FAMILIAR_IN_CLEAN_90D",
        DeviceCurrentCountryMatches > 0, "FAMILIAR_IN_AVAILABLE_BASELINE",
        BaselineCoverageComplete, "NEW_IN_CLEAN_90D",
        "NOT_SEEN_IN_AVAILABLE_BASELINE"),
    DeviceNetworkPairState = case(
        not(CanBaseline), "NOT_RUN",
        isempty(AlertDeviceId), "RECORDED_DEVICE_ID_UNAVAILABLE",
        DeviceSuccessfulFlows == 0, "NO_RECORDED_DEVICE_BASELINE",
        isempty(AlertASN) or isempty(AlertCountry), "CURRENT_PAIR_UNAVAILABLE",
        DeviceKnownNetworkPairFlows == 0, "NO_RECORDED_DEVICE_PAIR_BASELINE",
        DeviceCurrentNetworkPairMatches > 0 and BaselineCoverageComplete, "FAMILIAR_PAIR_IN_CLEAN_90D",
        DeviceCurrentNetworkPairMatches > 0, "FAMILIAR_PAIR_IN_AVAILABLE_BASELINE",
        BaselineCoverageComplete, "NEW_PAIR_IN_CLEAN_90D",
        "PAIR_NOT_SEEN_IN_AVAILABLE_BASELINE")
| extend
    UserNetworkState = case(
        not(CanBaseline), "NOT_RUN",
        UserASNState == "NEW_IN_CLEAN_90D" and UserCountryState == "NEW_IN_CLEAN_90D",
            "NEW_ASN_AND_COUNTRY",
        UserNetworkPairState == "NEW_PAIR_IN_CLEAN_90D", "NEW_ASN_COUNTRY_PAIR",
        UserNetworkPairState == "FAMILIAR_PAIR_IN_CLEAN_90D", "FAMILIAR_ASN_COUNTRY_PAIR",
        UserASNState == "NEW_IN_CLEAN_90D", "NEW_ASN",
        UserCountryState == "NEW_IN_CLEAN_90D", "NEW_COUNTRY",
        "UNRESOLVED"),
    DeviceNetworkState = case(
        not(CanBaseline), "NOT_RUN",
        isempty(AlertDeviceId), "RECORDED_DEVICE_ID_UNAVAILABLE",
        DeviceSuccessfulFlows == 0, "NO_RECORDED_DEVICE_BASELINE",
        DeviceASNState == "NEW_IN_CLEAN_90D" and DeviceCountryState == "NEW_IN_CLEAN_90D",
            "NEW_ASN_AND_COUNTRY_CORROBORATIVE",
        DeviceNetworkPairState == "NEW_PAIR_IN_CLEAN_90D", "NEW_ASN_COUNTRY_PAIR_CORROBORATIVE",
        DeviceNetworkPairState == "FAMILIAR_PAIR_IN_CLEAN_90D", "FAMILIAR_ASN_COUNTRY_PAIR",
        "UNRESOLVED")
| extend
    PreviousUserGapHours = datetime_diff("hour", EventTime, PreviousUserEventTime),
    PreviousDeviceGapHours = datetime_diff("hour", EventTime, PreviousDeviceEventTime)
| extend
    PreviousUserNetworkChangeState = case(
        not(CanBaseline), "NOT_RUN",
        isnull(PreviousUserEventTime), "NO_PREVIOUS_SUCCESSFUL_USER_FLOW",
        isempty(AlertASN) or isempty(AlertCountry)
            or isempty(PreviousUserASN) or isempty(PreviousUserCountry), "PAIR_COMPARISON_UNAVAILABLE",
        AlertASN == PreviousUserASN and AlertCountry == PreviousUserCountry, "SAME_AS_PREVIOUS",
        PreviousUserGapHours <= SuddenChangeMaxGapHours, "CHANGED_WITHIN_7D",
        "CHANGED_FROM_PREVIOUS"),
    PreviousDeviceNetworkChangeState = case(
        not(CanBaseline), "NOT_RUN",
        isempty(AlertDeviceId), "RECORDED_DEVICE_ID_UNAVAILABLE",
        isnull(PreviousDeviceEventTime), "NO_PREVIOUS_RECORDED_DEVICE_FLOW",
        isempty(AlertASN) or isempty(AlertCountry)
            or isempty(PreviousDeviceASN) or isempty(PreviousDeviceCountry), "PAIR_COMPARISON_UNAVAILABLE",
        AlertASN == PreviousDeviceASN and AlertCountry == PreviousDeviceCountry, "SAME_AS_PREVIOUS",
        PreviousDeviceGapHours <= SuddenChangeMaxGapHours, "CHANGED_WITHIN_7D_CORROBORATIVE",
        "CHANGED_FROM_PREVIOUS_CORROBORATIVE")
// Client is the requesting application. Resource is the target service.
| extend ClientFamily = case(
    AlertAppId =~ "29d9ed98-a469-4536-ade2-f981bc1d605e", "AUTHENTICATION_BROKER",
    AlertAppId =~ "4765445b-32c6-49b0-83e6-1d93765276ca", "OFFICE_HOME",
    AlertAppId in~ (
        "0ec893e0-5785-4de6-99da-4ed124e5296c", "d3590ed6-52b3-4102-aeff-aad2292ab01c",
        "89bee1f7-5e6e-4d8a-9f3d-ecd601259da7", "4b233688-031c-404b-9a80-a4f3f2351f90",
        "0f698dd4-f011-4d23-a33e-b36416dcb1e6"), "MICROSOFT_365_OFFICE",
    AlertAppId in~ (
        "04b07795-8ddb-461a-bbee-02f9e1bf7b46", "1950a258-227b-4e31-a9cf-717495945fc2",
        "aebc6443-996d-45c2-90f0-388ff96faa56", "04f0c124-f2bc-4f59-8241-bf6df9866bbd",
        "872cd9fa-d31f-45e0-9eab-6e460a02d1f1", "a69788c6-1d43-44ed-9ca3-b83e194da255",
        "14d82eec-204b-4c2f-b7e8-296a70dab67e"), "DEVELOPER_TOOLING",
    tolower(AlertAppDisplayName) contains "authentication broker", "AUTHENTICATION_BROKER",
    tolower(AlertAppDisplayName) contains "officehome", "OFFICE_HOME",
    tolower(AlertAppDisplayName) contains "office 365"
        or tolower(AlertAppDisplayName) contains "microsoft office", "MICROSOFT_365_OFFICE",
    tolower(AlertAppDisplayName) contains "azure cli"
        or tolower(AlertAppDisplayName) contains "azure powershell"
        or tolower(AlertAppDisplayName) contains "visual studio"
        or tolower(AlertAppDisplayName) contains "graph command line", "DEVELOPER_TOOLING",
    "OTHER_OR_UNCLASSIFIED")
| extend
    ClientClassificationBasis = case(
        AlertAppId in~ (
            "29d9ed98-a469-4536-ade2-f981bc1d605e", "4765445b-32c6-49b0-83e6-1d93765276ca",
            "0ec893e0-5785-4de6-99da-4ed124e5296c", "d3590ed6-52b3-4102-aeff-aad2292ab01c",
            "89bee1f7-5e6e-4d8a-9f3d-ecd601259da7", "4b233688-031c-404b-9a80-a4f3f2351f90",
            "0f698dd4-f011-4d23-a33e-b36416dcb1e6", "04b07795-8ddb-461a-bbee-02f9e1bf7b46",
            "1950a258-227b-4e31-a9cf-717495945fc2", "aebc6443-996d-45c2-90f0-388ff96faa56",
            "04f0c124-f2bc-4f59-8241-bf6df9866bbd", "872cd9fa-d31f-45e0-9eab-6e460a02d1f1",
            "a69788c6-1d43-44ed-9ca3-b83e194da255", "14d82eec-204b-4c2f-b7e8-296a70dab67e"),
            "EXACT_PUBLIC_APP_ID_CLASSIFICATION",
        ClientFamily != "OTHER_OR_UNCLASSIFIED", "DISPLAY_NAME_CLASSIFICATION_ONLY",
        "UNCLASSIFIED"),
    ResourceFamily = case(
        AlertResourceId =~ "01cb2876-7ebd-4aa4-9cc9-d28bd4d359a9", "DEVICE_REGISTRATION_SERVICE",
        AlertResourceId =~ "00000003-0000-0000-c000-000000000000", "MICROSOFT_GRAPH",
        AlertResourceId in~ (
            "00000002-0000-0ff1-ce00-000000000000",
            "00000003-0000-0ff1-ce00-000000000000"), "MICROSOFT_365_WORKLOAD",
        tolower(AlertResourceDisplayName) contains "device registration", "DEVICE_REGISTRATION_SERVICE",
        tolower(AlertResourceDisplayName) contains "microsoft graph", "MICROSOFT_GRAPH",
        tolower(AlertResourceDisplayName) contains "exchange online"
            or tolower(AlertResourceDisplayName) contains "sharepoint online"
            or tolower(AlertResourceDisplayName) contains "office 365", "MICROSOFT_365_WORKLOAD",
        tolower(AlertResourceDisplayName) contains "azure", "AZURE",
        "OTHER_OR_UNCLASSIFIED")
| extend ResourceClassificationBasis = case(
    AlertResourceId in~ (
        "01cb2876-7ebd-4aa4-9cc9-d28bd4d359a9",
        "00000003-0000-0000-c000-000000000000",
        "00000002-0000-0ff1-ce00-000000000000",
        "00000003-0000-0ff1-ce00-000000000000"), "EXACT_RESOURCE_ID_CLASSIFICATION",
    ResourceFamily != "OTHER_OR_UNCLASSIFIED", "DISPLAY_NAME_CLASSIFICATION_ONLY",
    "UNCLASSIFIED")
| extend
    AppPath = strcat(ClientFamily, " -> ", ResourceFamily),
    NetworkLocationContextPresent = isnotempty(AlertNetworkLocationDetails)
        and AlertNetworkLocationDetails !in ("[]", "{}", "null"),
    RawElevatedIdentityRisk = AlertRiskLevel in~ ("medium", "high")
        or AlertRiskState in~ ("atRisk", "confirmedCompromised"),
    RiskResolved = AlertRiskState in~ ("confirmedSafe", "remediated", "dismissed"),
    ConfirmedCompromiseRisk = AlertRiskState =~ "confirmedCompromised",
    UserProtocolConcerning = BaselineCoverageComplete and not(UserProtocolEstablished),
    UserStrongNetworkShift = UserASNState == "NEW_IN_CLEAN_90D"
        and UserCountryState == "NEW_IN_CLEAN_90D",
    SuddenUserNetworkChange = PreviousUserNetworkChangeState == "CHANGED_WITHIN_7D",
    BrokerDRSPath = AlertAppId =~ "29d9ed98-a469-4536-ade2-f981bc1d605e"
        and AlertResourceId =~ "01cb2876-7ebd-4aa4-9cc9-d28bd4d359a9"
| extend
    ElevatedIdentityRisk = ConfirmedCompromiseRisk
        or (RawElevatedIdentityRisk and not(RiskResolved)),
    HighIdentityRisk = AlertRiskLevel =~ "high" and not(RiskResolved),
    MediumOrAtRisk = (AlertRiskLevel =~ "medium" and not(RiskResolved))
        or AlertRiskState =~ "atRisk",
    NetworkEvidenceHardTriggerEligible = AlertThroughGlobalSecureAccessKnown
        and (not(AlertThroughGlobalSecureAccess)
            or (isnotempty(AlertIPAddress)
                and isnotempty(AlertGlobalSecureAccessIP)
                and AlertIPAddress != AlertGlobalSecureAccessIP))
| extend
    BrokerDRSHardTrigger = BrokerDRSPath
        and (BrokerDRSProhibitedByPolicy
            or ElevatedIdentityRisk
            or UserProtocolConcerning
            or (UserStrongNetworkShift and NetworkEvidenceHardTriggerEligible)
            or (BaselineCoverageComplete and UserSamePathDeviceCodeSuccesses == 0)),
    NetworkPathContext = case(
        AlertThroughGlobalSecureAccess, "GLOBAL_SECURE_ACCESS_CONTEXT",
        NetworkLocationContextPresent, "NAMED_OR_CLASSIFIED_NETWORK_CONTEXT",
        "VPN_PROXY_OR_DIRECT_UNKNOWN")
| extend
    SuspiciousTrigger = ConfirmedCompromiseRisk
        or HighIdentityRisk
        or BrokerDRSHardTrigger
        or (MediumOrAtRisk and UserProtocolConcerning)
        or (MediumOrAtRisk and UserStrongNetworkShift and NetworkEvidenceHardTriggerEligible)
        or (UserProtocolConcerning and UserStrongNetworkShift
            and NetworkEvidenceHardTriggerEligible)
        or (UserProtocolConcerning and UserNetworkPairState == "NEW_PAIR_IN_CLEAN_90D"
            and SuddenUserNetworkChange and NetworkEvidenceHardTriggerEligible),
    ExpectedLookingPattern = BaselineCoverageComplete
        and UserProtocolEstablished
        and UserSamePathDeviceCodeSuccesses > 0
        and TenantSamePathFrequencyState == "PATH_FREQUENT_SUCCESS_IN_TENANT_CLEAN_90D"
        and UserNetworkPairState == "FAMILIAR_PAIR_IN_CLEAN_90D"
        and not(ElevatedIdentityRisk)
        and ClientClassificationBasis == "EXACT_PUBLIC_APP_ID_CLASSIFICATION"
        and ResourceClassificationBasis == "EXACT_RESOURCE_ID_CLASSIFICATION"
        and not(BrokerDRSPath)
| extend
    ContainmentTriggers = strcat_array(array_concat(
        iff(ConfirmedCompromiseRisk, pack_array("ENTRA_CONFIRMED_COMPROMISED"), dynamic([])),
        iff(HighIdentityRisk, pack_array("HIGH_ENTRA_SIGNIN_RISK"), dynamic([])),
        iff(BrokerDRSPath and BrokerDRSProhibitedByPolicy,
            pack_array("BROKER_TO_DRS_PROHIBITED_BY_TENANT_POLICY"), dynamic([])),
        iff(BrokerDRSPath and not(BrokerDRSProhibitedByPolicy)
                and BrokerDRSHardTrigger,
            pack_array("BROKER_TO_DRS_PLUS_INDEPENDENT_RISK_OR_NOVELTY"), dynamic([])),
        iff(MediumOrAtRisk and UserProtocolConcerning,
            pack_array("IDENTITY_RISK_PLUS_USER_PROTOCOL_FIRST_OR_RARE"), dynamic([])),
        iff(MediumOrAtRisk and UserStrongNetworkShift and NetworkEvidenceHardTriggerEligible,
            pack_array("IDENTITY_RISK_PLUS_NEW_USER_ASN_AND_COUNTRY"), dynamic([])),
        iff(UserProtocolConcerning and UserStrongNetworkShift and NetworkEvidenceHardTriggerEligible,
            pack_array("USER_PROTOCOL_FIRST_OR_RARE_PLUS_NEW_ASN_AND_COUNTRY"), dynamic([])),
        iff(UserProtocolConcerning and UserNetworkPairState == "NEW_PAIR_IN_CLEAN_90D"
                and SuddenUserNetworkChange and NetworkEvidenceHardTriggerEligible,
            pack_array("USER_PROTOCOL_FIRST_OR_RARE_PLUS_SUDDEN_NEW_NETWORK_PAIR"), dynamic([]))
    ), " | "),
    ReviewFlags = strcat_array(array_concat(
        iff(not(InputsPresent), pack_array("MISSING_REQUIRED_UPN_OR_SIGNIN_TIME"), dynamic([])),
        iff(AlertFlowCount == 0 and TrackedDeviceCodeOnlyRows > 0,
            pack_array("PROTOCOL_TRACKED_ROW_ONLY_LOCATE_FRESH_DEVICE_CODE_EVENT"), dynamic([])),
        iff(AlertFlowCount == 0, pack_array("NO_DIRECT_DEVICE_CODE_FLOW_MATCH"), dynamic([])),
        iff(AlertFlowCount > 1, pack_array("AMBIGUOUS_MULTIPLE_FLOWS"), dynamic([])),
        iff(FlowKeyBasis == "Fallback", pack_array("FALLBACK_ALERT_FLOW_KEY"), dynamic([])),
        iff(AlertFlowCount == 1 and not(AlertSuccess), pack_array("TARGET_FLOW_NOT_SUCCESSFUL"), dynamic([])),
        iff(AlertFlowCount == 1 and isempty(AlertAADTenantId), pack_array("AAD_TENANT_ID_UNAVAILABLE"), dynamic([])),
        iff(CanBaseline and BaselineCoverageState != "90D_CLEAN_WINDOW_OBSERVED",
            pack_array("BASELINE_COVERAGE_NOT_CONFIRMED"), dynamic([])),
        iff(CanBaseline and Prior90dCoverageState != "PRIOR_90D_WINDOW_OBSERVED",
            pack_array("PRIOR_90D_COVERAGE_NOT_CONFIRMED"), dynamic([])),
        iff(AlertFlowCount == 1 and ClientClassificationBasis != "EXACT_PUBLIC_APP_ID_CLASSIFICATION",
            pack_array("CLIENT_NOT_CLASSIFIED_BY_EXACT_PUBLIC_APP_ID"), dynamic([])),
        iff(AlertFlowCount == 1 and ResourceClassificationBasis != "EXACT_RESOURCE_ID_CLASSIFICATION",
            pack_array("RESOURCE_NOT_CLASSIFIED_BY_EXACT_ID"), dynamic([])),
        iff(AlertFlowCount == 1 and BrokerDRSPath and not(BrokerDRSHardTrigger),
            pack_array("BROKER_TO_DRS_HIGH_PRIORITY_VERIFICATION"), dynamic([])),
        iff(AlertFlowCount == 1 and RiskResolved and AlertRiskLevel in~ ("medium", "high"),
            pack_array("HISTORICAL_RISK_LEVEL_NOW_RESOLVED"), dynamic([])),
        iff(CanBaseline and UserSamePathDeviceCodeSuccesses == 0,
            pack_array("CLIENT_RESOURCE_PATH_NEW_TO_USER"), dynamic([])),
        iff(CanBaseline and UserProtocolConcerning, pack_array("USER_DEVICE_CODE_FIRST_OR_RARE"), dynamic([])),
        iff(CanBaseline and UserProtocolState == "NOT_SEEN_IN_AVAILABLE_BASELINE",
            pack_array("USER_PROTOCOL_NOVELTY_UNKNOWN_PARTIAL_BASELINE"), dynamic([])),
        iff(CanBaseline and UserNetworkState startswith "NEW_", pack_array("USER_ASN_COUNTRY_NOVELTY"), dynamic([])),
        iff(CanBaseline and DeviceNetworkState contains "CORROBORATIVE",
            pack_array("RECORDED_DEVICE_NETWORK_CHANGE_CORROBORATIVE_ONLY"), dynamic([])),
        iff(AlertFlowCount == 1 and isempty(AlertDeviceId), pack_array("RECORDED_DEVICE_ID_UNAVAILABLE"), dynamic([])),
        iff(AlertFlowCount == 1 and not(AlertThroughGlobalSecureAccessKnown),
            pack_array("GLOBAL_SECURE_ACCESS_FIELD_UNAVAILABLE_NETWORK_NOT_USED_FOR_HARD_TRIGGER"),
            dynamic([])),
        iff(AlertThroughGlobalSecureAccess, pack_array("GLOBAL_SECURE_ACCESS_NETWORK_CAVEAT"), dynamic([])),
        iff(AlertThroughGlobalSecureAccess and not(NetworkEvidenceHardTriggerEligible),
            pack_array("GSA_SOURCE_IP_RESTORATION_UNCONFIRMED_NETWORK_NOT_USED_FOR_HARD_TRIGGER"),
            dynamic([])),
        iff(NetworkLocationContextPresent, pack_array("NAMED_NETWORK_OR_PROXY_CONTEXT_REVIEW"), dynamic([])),
        iff(CanBaseline and (UserDeviceCodeFallbackFlows > 0
                or Prior90dDeviceCodeFallbackAttempts > 0
                or TenantDeviceCodeFallbackFlows > 0),
            pack_array("FALLBACK_KEYS_EXCLUDED_FROM_FAMILIARITY_AND_FREQUENCY_COUNTS"), dynamic([]))
    ), " | ")
| extend EvidencePattern = case(
    SuspiciousTrigger, "HARD_TRIGGER",
    ExpectedLookingPattern, "EXPECTED_LOOKING_REQUIRES_EXTERNAL_CONFIRMATION",
    "ANOMALOUS_OR_INCOMPLETE_REQUIRES_EXTERNAL_CONFIRMATION")
| extend Determination = case(
    not(InputsPresent), "FIX SCOPE",
    AlertFlowCount == 0, "FIX SCOPE",
    AlertFlowCount > 1, "FIX SCOPE",
    FlowKeyBasis == "Fallback", "FIX SCOPE",
    not(AlertSuccess), "FIX SCOPE",
    isempty(AlertAADTenantId), "FIX SCOPE",
    SuspiciousTrigger, "CONTAIN NOW",
    "VERIFY NOW")
| extend RecommendedAction = case(
    not(InputsPresent),
        "Set the exact UPN and actual sign-in EventTime. Do not use incident creation time",
    AlertFlowCount == 0 and TrackedDeviceCodeOnlyRows > 0,
        "This is protocol-tracked activity, not a fresh device-code event. Trace OriginalRequestId and SessionId to the initiating AuthenticationProtocol=deviceCode row",
    AlertFlowCount == 0,
        "Verify UPN/time and add SigninLogs.Id, CorrelationId, or source IP to isolate the direct device-code flow",
    AlertFlowCount > 1,
        "Add SigninLogs.Id, CorrelationId, or source IP so exactly one flow remains",
    FlowKeyBasis == "Fallback",
        "Obtain a stable request, correlation, or sign-in ID before making a containment decision",
    not(AlertSuccess),
        "Do not contain from this failed row alone. Trace the same request/session and user for a successful device-code flow",
    isempty(AlertAADTenantId),
        "Resolve the source Entra tenant before using environment frequency or history",
    Determination == "CONTAIN NOW",
        "Revoke sessions and block sign-in now per identity procedure. Confirm the user in parallel, then scope the request/session and post-authentication activity",
    EvidencePattern == "EXPECTED_LOOKING_REQUIRES_EXTERNAL_CONFIRMATION",
        "Confirm the exact device-code action with the user and a sanctioned change record now. Do not close from telemetry alone. If denied or not promptly verified, contain",
    "Confirm the action with the user now and resolve every review flag. If denied, unrecognised, or not promptly verified, contain")
| extend
    Prior90dDeviceCodeSeenState = case(
        not(CanBaseline), "NOT_RUN",
        isnull(Prior90dDeviceCodeSeen), "UNKNOWN_PARTIAL_COVERAGE",
        Prior90dDeviceCodeSeen, "YES",
        "NO"),
    CleanBaselinePriorSuccessfulDeviceCodeUseState = case(
        not(CanBaseline), "NOT_RUN",
        isnull(CleanBaselinePriorSuccessfulDeviceCodeUse), "UNKNOWN_PARTIAL_COVERAGE",
        CleanBaselinePriorSuccessfulDeviceCodeUse, "YES",
        "NO")
| extend
    CurrentNetwork = strcat("ip=", AlertIPAddress, "; asn=", AlertASN, "; country=", AlertCountry),
    PreviousUserNetwork = strcat(
        "time=", tostring(PreviousUserEventTime), "; ip=", PreviousUserIPAddress,
        "; asn=", PreviousUserASN, "; country=", PreviousUserCountry,
        "; gap_hours=", tostring(PreviousUserGapHours)),
    AlertResult = strcat("success=", tostring(AlertSuccess), "; result=", AlertResultType,
        "; ", AlertResultDescription),
    RiskSummary = strcat("level=", AlertRiskLevel, "; state=", AlertRiskState),
    CoverageSummary = strcat("clean=", BaselineCoverageState,
        "; prior_90d=", Prior90dCoverageState),
    DecisionSummary = strcat(
        "path=", AppPath, " [", ClientClassificationBasis, "]; ",
        "prior_90d_seen=", Prior90dDeviceCodeSeenState,
            " [attempts=", tostring(Prior90dDeviceCodeAttempts),
            ", recent_24h=", tostring(Recent24hDeviceCodeAttempts), "]; ",
        "clean_user_device_code=", UserProtocolState, " [success=", tostring(UserDeviceCodeSuccesses),
            ", failure=", tostring(UserDeviceCodeFailures), ", days=", tostring(UserDeviceCodeActiveDays),
            ", same_path=", tostring(UserSamePathDeviceCodeSuccesses), "]; ",
        "tenant_success=", TenantFrequencyState, " [flows=", tostring(TenantDeviceCodeFlows),
            ", users=", tostring(TenantDeviceCodeUsers), ", days=", tostring(TenantDeviceCodeActiveDays), "]; ",
        "user_network=", UserNetworkState, "; previous_change=", PreviousUserNetworkChangeState,
        "; recorded_device_network=", DeviceNetworkState,
        "; clean_coverage=", BaselineCoverageState,
        "; prior_90d_coverage=", Prior90dCoverageState,
        "; network_path=", NetworkPathContext)
| extend Evidence = bag_pack(
    "alert", bag_pack(
        "aad_tenant_id", AlertAADTenantId,
        "app_display_name", AlertAppDisplayName,
        "app_id", AlertAppId,
        "app_owner_tenant_id", AlertAppOwnerTenantId,
        "client_classification_basis", ClientClassificationBasis,
        "resource_display_name", AlertResourceDisplayName,
        "resource_id", AlertResourceId,
        "resource_classification_basis", ResourceClassificationBasis,
        "client_app_used", AlertClientAppUsed,
        "authentication_protocol", AlertAuthenticationProtocol,
        "original_transfer_method", AlertOriginalTransferMethod,
        "risk_events", AlertRiskEvents,
        "conditional_access_status", AlertConditionalAccessStatus,
        "authentication_requirement", AlertAuthenticationRequirement,
        "state", AlertState,
        "city", AlertCity,
        "device_id", AlertDeviceId,
        "device_name", AlertDeviceName,
        "device_os", AlertDeviceOS,
        "device_browser", AlertDeviceBrowser,
        "device_managed", AlertDeviceManaged,
        "device_compliant", AlertDeviceCompliant,
        "device_trust_type", AlertDeviceTrustType,
        "sign_in_id", AlertSignInId,
        "original_request_id", AlertOriginalRequestId,
        "correlation_id", AlertCorrelationId,
        "session_id", AlertSessionId),
    "protocol", bag_pack(
        "prior_90d_any_attempt_seen", Prior90dDeviceCodeSeen,
        "prior_90d_any_attempt_seen_state", Prior90dDeviceCodeSeenState,
        "prior_90d_attempts", Prior90dDeviceCodeAttempts,
        "prior_90d_successes", Prior90dDeviceCodeSuccesses,
        "prior_90d_failures", Prior90dDeviceCodeFailures,
        "recent_24h_attempts", Recent24hDeviceCodeAttempts,
        "recent_24h_successes", Recent24hDeviceCodeSuccesses,
        "recent_24h_failures", Recent24hDeviceCodeFailures,
        "clean_baseline_any_attempt_seen", CleanBaselineDeviceCodeSeen,
        "clean_baseline_prior_successful_use", CleanBaselinePriorSuccessfulDeviceCodeUse,
        "clean_baseline_prior_successful_use_state", CleanBaselinePriorSuccessfulDeviceCodeUseState,
        "user_successes", UserDeviceCodeSuccesses,
        "user_failures", UserDeviceCodeFailures,
        "user_active_days", UserDeviceCodeActiveDays,
        "user_first_success", UserDeviceCodeFirstSuccess,
        "user_last_success", UserDeviceCodeLastSuccess,
        "user_same_app_successes", UserSameAppDeviceCodeSuccesses,
        "user_same_path_successes", UserSamePathDeviceCodeSuccesses,
        "tenant_flows", TenantDeviceCodeFlows,
        "tenant_users", TenantDeviceCodeUsers,
        "tenant_active_days", TenantDeviceCodeActiveDays,
        "tenant_same_path_state", TenantSamePathFrequencyState,
        "tenant_same_path_flows", TenantSamePathDeviceCodeFlows,
        "tenant_same_path_users", TenantSamePathDeviceCodeUsers,
        "tenant_same_path_active_days", TenantSamePathDeviceCodeActiveDays),
    "network", bag_pack(
        "current_network", CurrentNetwork,
        "previous_user_network", PreviousUserNetwork,
        "network_path_context", NetworkPathContext,
        "user_asn_state", UserASNState,
        "user_country_state", UserCountryState,
        "user_pair_state", UserNetworkPairState,
        "user_asn_matches", UserCurrentASNMatches,
        "user_country_matches", UserCurrentCountryMatches,
        "user_pair_matches", UserCurrentNetworkPairMatches,
        "previous_user_device_id", PreviousUserDeviceId,
        "recorded_device_pair_state", DeviceNetworkPairState,
        "recorded_device_previous_change", PreviousDeviceNetworkChangeState,
        "previous_device_time", PreviousDeviceEventTime,
        "previous_device_ip", PreviousDeviceIPAddress,
        "previous_device_asn", PreviousDeviceASN,
        "previous_device_country", PreviousDeviceCountry,
        "previous_device_gap_hours", PreviousDeviceGapHours,
        "gsa_field_known", AlertThroughGlobalSecureAccessKnown,
        "through_gsa", AlertThroughGlobalSecureAccess,
        "gsa_ip", AlertGlobalSecureAccessIP,
        "network_location_details", AlertNetworkLocationDetails),
    "quality", bag_pack(
        "evidence_pattern", EvidencePattern,
        "alert_raw_rows", AlertRawRowCount,
        "alert_flows", AlertFlowCount,
        "tracked_device_code_only_rows", TrackedDeviceCodeOnlyRows,
        "alert_flow_key_basis", FlowKeyBasis,
        "user_key_basis", UserKeyBasis,
        "baseline_start", BaselineStart,
        "baseline_end", BaselineEnd,
        "prior_90d_start", Prior90dStart,
        "prior_90d_end", AlertWindowStart,
        "prior_90d_coverage_state", Prior90dCoverageState,
        "prior_90d_earliest_event", Prior90dEarliestEvent,
        "prior_90d_latest_event", Prior90dLatestEvent,
        "prior_90d_tenant_active_days", Prior90dTenantActiveDays,
        "clean_history_gap", CleanHistoryGap,
        "prior_earliest_event", PriorEarliestEvent,
        "prior_latest_event", PriorLatestEvent,
        "prior_tenant_active_days", PriorTenantActiveDays,
        "user_fallback_flows_excluded", UserFallbackFlows,
        "user_device_code_fallback_flows_excluded_from_familiarity",
            UserDeviceCodeFallbackFlows,
        "prior_90d_device_code_fallback_attempts_in_seen_total",
            Prior90dDeviceCodeFallbackAttempts,
        "tenant_device_code_fallback_flows_excluded", TenantDeviceCodeFallbackFlows,
        "recorded_device_fallback_flows_excluded", DeviceFallbackFlows))
| project
    Determination,
    RecommendedAction,
    ContainmentTriggers = iff(isempty(ContainmentTriggers), "none", ContainmentTriggers),
    ReviewFlags = iff(isempty(ReviewFlags), "none", ReviewFlags),
    DecisionSummary,
    EventTime,
    AlertUPN,
    AlertResult,
    AppPath,
    Prior90dDeviceCodeSeenState,
    CleanBaselinePriorSuccessfulDeviceCodeUseState,
    Recent24hDeviceCodeAttempts,
    UserProtocolState,
    TenantFrequencyState,
    UserNetworkState,
    PreviousUserNetworkChangeState,
    DeviceNetworkState,
    CurrentNetwork,
    RiskSummary,
    CoverageSummary,
    AlertSignInId,
    Evidence
