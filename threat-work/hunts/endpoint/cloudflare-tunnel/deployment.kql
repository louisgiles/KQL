// name:              Cloudflare Tunnel Deployment Hunt
// purpose:           Surface Cloudflare Tunnel deployment and execution evidence in Microsoft Sentinel without campaign-specific IOCs.
// starting_entities: HuntEnd/HuntWindow plus optional DeviceNameToCheck or AccountToCheck filters.
// required_tables:   DeviceProcessEvents
// optional_tables:   DeviceNetworkEvents (union isfuzzy=true; a missing table only removes connector-egress context)
// variables:         HuntEnd, HuntWindow, BaselineWindow, DeviceNameToCheck, AccountToCheck
// time_window:       7d hunt window plus the immediately preceding 21d baseline, both bounded by HuntEnd.
// done_criteria:     Review the raw command, binary identity/path, actor, first-seen context, and successful connector egress; confirm the owner and intended published service.
// artifact_type:     hunt
// output_type:       analysis
//
// Cloudflare Tunnel is a legitimate administration and development tool. This
// query returns evidence for investigation; it does not assign a threat verdict.
// Command lines and service values are intentionally unmodified for authorised
// Sentinel hunters and may contain credentials. Treat results and exports as sensitive.

let HuntEnd = now();
let HuntWindow = 7d;
let BaselineWindow = 21d;
let DeviceNameToCheck = "";
let AccountToCheck = "";
//
let HuntStart = HuntEnd - HuntWindow;
let BaselineStart = HuntStart - BaselineWindow;
let ActorLabel = (Upn:string, Domain:string, Name:string) {
    case(
        isnotempty(Upn), Upn,
        isnotempty(Domain), strcat(Domain, "\\", Name),
        Name)
};
let IsUserWritablePath = (Value:string) {
    let Path = tolower(tostring(Value));
    Path contains "\\users\\"
        or Path contains "\\downloads\\"
        or Path contains "\\appdata\\"
        or Path contains "\\temp\\"
        or Path contains "/home/"
        or Path contains "/users/"
        or Path contains "/tmp/"
        or Path contains "/var/tmp/"
};
let HasCredentialArgument = (Value:string) {
    let Text = tolower(tostring(Value));
    Text contains "--token"
        or Text contains "--credentials-file"
        or Text contains "tunnel_token"
};
//
// Normalize candidate process events and narrowly scoped supporting evidence.
// ProcessKey is retained as a pivot; this hunt deliberately does not sessionize
// or turn device-wide activity into artificial corroboration.
let AllEvidence = materialize(
    union isfuzzy=true
    (
        DeviceProcessEvents
        | where Timestamp >= BaselineStart and Timestamp < HuntEnd
        | extend
            FileNameLower = tolower(tostring(FileName)),
            OriginalFileNameLower = tolower(tostring(ProcessVersionInfoOriginalFileName)),
            ProductNameLower = tolower(tostring(ProcessVersionInfoProductName)),
            CommandLineLower = tolower(tostring(ProcessCommandLine))
        | extend
            IsCloudflaredIdentity = FileNameLower contains "cloudflared"
                or OriginalFileNameLower contains "cloudflared"
                or ProductNameLower contains "cloudflared",
            IsCommandWrapper = FileNameLower in~ (
                "cmd", "cmd.exe", "powershell", "powershell.exe", "pwsh", "pwsh.exe",
                "bash", "sh", "zsh", "docker", "podman", "nerdctl",
                "node", "node.exe", "npm", "npm.cmd", "npx", "npx.cmd",
                "bun", "bun.exe", "wrangler", "wrangler.exe",
                "winget", "winget.exe", "choco", "choco.exe", "curl", "wget"
            )
        | extend
            HasCloudflaredInvocation = IsCommandWrapper
                and CommandLineLower contains "cloudflared",
            HasContainerInvocation = IsCommandWrapper
                and CommandLineLower contains "cloudflare/cloudflared",
            HasWranglerTunnelCommand = IsCommandWrapper
                and CommandLineLower has "wrangler"
                and CommandLineLower has "tunnel"
                and CommandLineLower has_any ("create", "run", "quick-start")
        | where IsCloudflaredIdentity
            or HasCloudflaredInvocation
            or HasContainerInvocation
            or HasWranglerTunnelCommand
        | extend
            HasQuickTunnel = CommandLineLower has "tunnel"
                and CommandLineLower contains "--url",
            HasServiceInstall = CommandLineLower has "service"
                and CommandLineLower has "install",
            HasTunnelCreate = CommandLineLower has "tunnel"
                and CommandLineLower has "create",
            HasTunnelLogin = CommandLineLower has "login"
                and not(CommandLineLower has "access"),
            HasTunnelRoute = CommandLineLower has "tunnel"
                and CommandLineLower has "route"
                and CommandLineLower has_any ("dns", "ip"),
            HasTunnelRun = CommandLineLower has "tunnel"
                and CommandLineLower has "run",
            IsRenamedCloudflared = (OriginalFileNameLower contains "cloudflared"
                    or ProductNameLower contains "cloudflared")
                and not(FileNameLower contains "cloudflared")
        | extend Signal = case(
            IsRenamedCloudflared, "Renamed cloudflared-compatible binary executed",
            HasQuickTunnel, "Cloudflare Quick Tunnel command",
            HasServiceInstall, "Cloudflare Tunnel service installation command",
            HasContainerInvocation and HasTunnelRun, "Cloudflare Tunnel container execution",
            HasWranglerTunnelCommand, "Wrangler Tunnel command",
            HasTunnelCreate, "Cloudflare Tunnel creation command",
            HasTunnelLogin, "Cloudflare Tunnel authentication command",
            HasTunnelRoute, "Cloudflare Tunnel route command",
            HasTunnelRun, "Cloudflare Tunnel execution command",
            "cloudflared execution or command reference")
        | project
            EventTime = Timestamp,
            DeviceId = tostring(DeviceId),
            DeviceName = tostring(DeviceName),
            Actor = ActorLabel(AccountUpn, AccountDomain, AccountName),
            SourceTable = "DeviceProcessEvents",
            Signal,
            ActionType = tostring(ActionType),
            Artifact = strcat(FolderPath, "/", FileName),
            ProcessFileName = tostring(FileName),
            ProcessPath = tostring(FolderPath),
            ProcessSHA1 = tostring(SHA1),
            ProcessSHA256 = tostring(SHA256),
            CommandLine = tostring(ProcessCommandLine),
            RemoteHost = "",
            RemoteIP = "",
            RemotePort = long(null),
            Detail = strcat(
                "parent=", InitiatingProcessFileName,
                "; parent_command_line=", InitiatingProcessCommandLine),
            ProcessKey = strcat(
                DeviceId, "|", tostring(ProcessId), "|", tostring(ProcessCreationTime)),
            IsRenamedCloudflared,
            IsUserWritablePath = IsUserWritablePath(FolderPath),
            HasCredentialArgument = HasCredentialArgument(ProcessCommandLine)
    ),
    (
        DeviceNetworkEvents
        | where Timestamp >= BaselineStart and Timestamp < HuntEnd
        | where ActionType =~ "ConnectionSuccess"
        | where RemotePort == 7844 and Protocol in~ ("Tcp", "Udp")
        | where InitiatingProcessFileName contains "cloudflared"
            or InitiatingProcessCommandLine contains "cloudflared"
            or InitiatingProcessCommandLine contains "cloudflare/cloudflared"
        | project
            EventTime = Timestamp,
            DeviceId = tostring(DeviceId),
            DeviceName = tostring(DeviceName),
            Actor = ActorLabel(
                InitiatingProcessAccountUpn,
                InitiatingProcessAccountDomain,
                InitiatingProcessAccountName),
            SourceTable = "DeviceNetworkEvents",
            Signal = "Successful Cloudflare Tunnel connector egress",
            ActionType = tostring(ActionType),
            Artifact = strcat(iff(isempty(RemoteUrl), RemoteIP, RemoteUrl), ":", RemotePort),
            ProcessFileName = tostring(InitiatingProcessFileName),
            ProcessPath = tostring(InitiatingProcessFolderPath),
            ProcessSHA1 = tostring(InitiatingProcessSHA1),
            ProcessSHA256 = tostring(InitiatingProcessSHA256),
            CommandLine = tostring(InitiatingProcessCommandLine),
            RemoteHost = tostring(RemoteUrl),
            RemoteIP = tostring(RemoteIP),
            RemotePort = tolong(RemotePort),
            Detail = strcat("protocol=", Protocol),
            ProcessKey = strcat(
                DeviceId, "|", tostring(InitiatingProcessId), "|",
                tostring(InitiatingProcessCreationTime)),
            IsRenamedCloudflared = false,
            IsUserWritablePath = IsUserWritablePath(InitiatingProcessFolderPath),
            HasCredentialArgument = HasCredentialArgument(InitiatingProcessCommandLine)
    )
);
//
// Baseline is deliberately simple: prior Cloudflare evidence on the device and
// prior tenant prevalence for the same signal. It does not fingerprint complete
// commands, edge hosts, or paths, which change during normal operations.
let DeviceBaseline = materialize(
    AllEvidence
    | where EventTime >= BaselineStart and EventTime < HuntStart
    | summarize
        PriorDeviceEvents = count(),
        PriorDeviceFirstSeen = min(EventTime),
        PriorDeviceLastSeen = max(EventTime)
      by DeviceId
);
let SignalBaseline = materialize(
    AllEvidence
    | where EventTime >= BaselineStart and EventTime < HuntStart
    | summarize
        PriorSignalEvents = count(),
        PriorSignalDevices = dcount(DeviceId)
      by Signal
);
AllEvidence
| where EventTime >= HuntStart and EventTime < HuntEnd
| where isempty(DeviceNameToCheck) or DeviceName =~ DeviceNameToCheck
| where isempty(AccountToCheck) or Actor contains AccountToCheck
| join kind=leftouter DeviceBaseline on DeviceId
| join kind=leftouter SignalBaseline on Signal
| extend
    PriorDeviceEvents = coalesce(PriorDeviceEvents, 0),
    PriorSignalEvents = coalesce(PriorSignalEvents, 0),
    PriorSignalDevices = coalesce(PriorSignalDevices, 0)
| extend
    IsFirstSeenOnDevice = PriorDeviceEvents == 0,
    IsFirstSeenSignalInTenant = PriorSignalEvents == 0
| project
    EventTime,
    DeviceName,
    DeviceId,
    Actor,
    Signal,
    SourceTable,
    ActionType,
    Artifact,
    ProcessFileName,
    ProcessPath,
    ProcessSHA1,
    ProcessSHA256,
    CommandLine,
    RemoteHost,
    RemoteIP,
    RemotePort,
    Detail,
    ProcessKey,
    IsRenamedCloudflared,
    IsUserWritablePath,
    HasCredentialArgument,
    IsFirstSeenOnDevice,
    IsFirstSeenSignalInTenant,
    PriorDeviceEvents,
    PriorDeviceFirstSeen,
    PriorDeviceLastSeen,
    PriorSignalEvents,
    PriorSignalDevices
| sort by IsFirstSeenOnDevice desc, IsRenamedCloudflared desc, EventTime desc
//
// Coverage boundary: endpoint telemetry cannot show a dashboard/API-only tunnel
// creation until a connector or local artifact appears. If Cloudflare audit logs
// are ingested, hunt their tenant-specific table separately for tunnel create,
// update, connector registration, and route/CNAME changes by unfamiliar actors.
