// name:              Correlated incident context timeline
// purpose:           Build a compact identity, Microsoft 365, Azure, and endpoint sequence for already-associated incident entities.
// starting_entities: At least one user principal name, DeviceId, exact device name, or IP address
// required_tables:   At least one declared identity, cloud, M365, or endpoint table
// optional_tables:   SigninLogs, AuditLogs, OfficeActivity, AzureActivity, DeviceProcessEvents, DeviceNetworkEvents, DeviceFileEvents
// variables:         TargetUPN, TargetDeviceId, TargetDeviceName, TargetIP, AnchorTime, Lookback, Lookforward, MaxRows
// time_window:       Default 2h before and 1h after AnchorTime; maximum routine bound 24h
// done_criteria:     Cross-domain sequence is understood and containment scope or one unresolved pivot is explicit
// artifact_type:     investigation
// output_type:       analysis

let TargetUPN = "";
let TargetDeviceId = "";
let TargetDeviceName = "";
let TargetIP = "";
let AnchorTime = now();
let Lookback = 2h;
let Lookforward = 1h;
let MaxRows = 30;
let CandidateLimit = MaxRows + 1;
let NormalizedUPN = tolower(TargetUPN);
let NormalizedIP = tolower(TargetIP);
let StartTime = AnchorTime - Lookback;
let EndTime = AnchorTime + Lookforward;
let InputValid = (
        isnotempty(NormalizedUPN)
        or isnotempty(TargetDeviceId)
        or isnotempty(TargetDeviceName)
        or isnotempty(NormalizedIP)
    )
    and isnotnull(AnchorTime)
    and Lookback between (1m .. 24h)
    and Lookforward between (0m .. 24h)
    and MaxRows between (1 .. 100);
let EmptyEvidence = datatable(
    EventTime:datetime,
    EvidenceType:string,
    Entity:string,
    RelatedEntity:string,
    Summary:string,
    Evidence:dynamic,
    Decision:string,
    NextAction:string,
    SortOrder:int
)[];
let Candidates = materialize(
    union isfuzzy=true
        EmptyEvidence,
        (
            SigninLogs
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | extend SigninDevice = tostring(DeviceDetail)
            | where (isnotempty(NormalizedUPN) and tolower(UserPrincipalName) == NormalizedUPN)
                or (isnotempty(NormalizedIP) and tolower(IPAddress) == NormalizedIP)
                or (isnotempty(TargetDeviceId) and SigninDevice has TargetDeviceId)
                or (isnotempty(TargetDeviceName) and SigninDevice has TargetDeviceName)
            | extend Risk = tolower(strcat(tostring(RiskLevelDuringSignIn), "/", tostring(RiskState)))
            | project
                EventTime = TimeGenerated,
                EvidenceType = "identity/sign-in",
                Entity = tostring(UserPrincipalName),
                RelatedEntity = tostring(IPAddress),
                Summary = strcat("Sign-in to ", tostring(AppDisplayName), " via ", tostring(ClientAppUsed), " result ", tostring(ResultType)),
                Evidence = pack(
                    "risk", Risk,
                    "conditional_access", tostring(ConditionalAccessStatus),
                    "correlation_id", tostring(CorrelationId),
                    "session_id", tostring(column_ifexists("SessionId", "")),
                    "device", SigninDevice
                ),
                Decision = iff(Risk has_any ("high", "medium", "atrisk", "confirmedcompromised"), "Suspicious / escalate", "Review required"),
                NextAction = "Validate session, authentication context, source IP, and affected app",
                SortOrder = 1
        ),
        (
            AuditLogs
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | extend Initiator = tostring(InitiatedBy), TargetText = tostring(TargetResources)
            | where (isnotempty(NormalizedUPN) and (tolower(Initiator) has NormalizedUPN or tolower(TargetText) has NormalizedUPN))
                or (isnotempty(NormalizedIP) and tolower(Initiator) has NormalizedIP)
            | project
                EventTime = TimeGenerated,
                EvidenceType = "identity/directory-change",
                Entity = TargetUPN,
                RelatedEntity = tostring(OperationName),
                Summary = strcat(tostring(OperationName), " returned ", tostring(Result)),
                Evidence = pack(
                    "initiated_by", Initiator,
                    "targets", TargetText,
                    "category", tostring(Category),
                    "correlation_id", tostring(CorrelationId)
                ),
                Decision = "Review required",
                NextAction = "Validate actor, target, approval, and access impact",
                SortOrder = 1
        ),
        (
            OfficeActivity
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | extend OfficeIP = tolower(tostring(ClientIP)), OfficeActor = tolower(tostring(UserId))
            | where (isnotempty(NormalizedUPN) and OfficeActor == NormalizedUPN)
                or (isnotempty(NormalizedIP) and (OfficeIP == NormalizedIP or OfficeIP startswith strcat(NormalizedIP, ":")))
            | project
                EventTime = TimeGenerated,
                EvidenceType = "m365/operation",
                Entity = tostring(UserId),
                RelatedEntity = tostring(column_ifexists("ObjectId", "")),
                Summary = strcat(tostring(Operation), " in ", tostring(OfficeWorkload)),
                Evidence = pack(
                    "client_ip", tostring(ClientIP),
                    "result", tostring(ResultStatus),
                    "parameters", tostring(Parameters)
                ),
                Decision = "Review required",
                NextAction = "Confirm operation intent, target, persistence, and data impact",
                SortOrder = 1
        ),
        (
            AzureActivity
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | where (isnotempty(NormalizedUPN) and (tolower(tostring(Caller)) == NormalizedUPN or tolower(tostring(Claims)) has NormalizedUPN))
                or (isnotempty(NormalizedIP) and tolower(tostring(CallerIpAddress)) == NormalizedIP)
            | project
                EventTime = TimeGenerated,
                EvidenceType = "cloud/control-plane",
                Entity = tostring(Caller),
                RelatedEntity = tostring(ResourceId),
                Summary = strcat(tostring(OperationNameValue), " returned ", tostring(ActivityStatusValue)),
                Evidence = pack(
                    "source_ip", tostring(CallerIpAddress),
                    "subscription", tostring(SubscriptionId),
                    "resource_group", tostring(ResourceGroup),
                    "correlation_id", tostring(CorrelationId)
                ),
                Decision = "Review required",
                NextAction = "Validate operation scope and adjacent role, credential, or resource changes",
                SortOrder = 1
        ),
        (
            DeviceProcessEvents
            | where InputValid and Timestamp between (StartTime .. EndTime)
            | where (isnotempty(TargetDeviceId) and DeviceId =~ TargetDeviceId)
                or (isnotempty(TargetDeviceName) and DeviceName =~ TargetDeviceName)
                or (isnotempty(NormalizedUPN) and tolower(tostring(AccountUpn)) == NormalizedUPN)
                or (isnotempty(NormalizedUPN) and tolower(tostring(InitiatingProcessAccountUpn)) == NormalizedUPN)
            | project
                EventTime = Timestamp,
                EvidenceType = "endpoint/process",
                Entity = tostring(DeviceName),
                RelatedEntity = tostring(FileName),
                Summary = strcat(tostring(ActionType), ": ", tostring(FileName), " launched by ", tostring(InitiatingProcessFileName)),
                Evidence = pack(
                    "device_id", tostring(DeviceId),
                    "process_id", tostring(ProcessId),
                    "process_creation_time", tostring(ProcessCreationTime),
                    "command_line", tostring(ProcessCommandLine),
                    "sha256", tostring(SHA256),
                    "account", tostring(AccountUpn)
                ),
                Decision = "Review required",
                NextAction = "Pivot to the exact process identity and validate ancestry and effects",
                SortOrder = 1
        ),
        (
            DeviceNetworkEvents
            | where InputValid and Timestamp between (StartTime .. EndTime)
            | where (isnotempty(TargetDeviceId) and DeviceId =~ TargetDeviceId)
                or (isnotempty(TargetDeviceName) and DeviceName =~ TargetDeviceName)
                or (isnotempty(NormalizedUPN) and tolower(tostring(InitiatingProcessAccountUpn)) == NormalizedUPN)
                or (isnotempty(NormalizedIP) and (tolower(RemoteIP) == NormalizedIP or tolower(LocalIP) == NormalizedIP))
            | project
                EventTime = Timestamp,
                EvidenceType = "endpoint/network",
                Entity = tostring(DeviceName),
                RelatedEntity = iff(isnotempty(tostring(RemoteUrl)), tostring(RemoteUrl), tostring(RemoteIP)),
                Summary = strcat(tostring(InitiatingProcessFileName), " connected to ", iff(isnotempty(tostring(RemoteUrl)), tostring(RemoteUrl), tostring(RemoteIP)), ":", tostring(RemotePort)),
                Evidence = pack(
                    "device_id", tostring(DeviceId),
                    "remote_ip", tostring(RemoteIP),
                    "remote_url", tostring(RemoteUrl),
                    "remote_port", tostring(RemotePort),
                    "initiating_process_id", tostring(InitiatingProcessId),
                    "initiating_process_creation_time", tostring(InitiatingProcessCreationTime),
                    "account", tostring(InitiatingProcessAccountUpn)
                ),
                Decision = "Review required",
                NextAction = "Validate destination, process-destination relationship, and related devices",
                SortOrder = 1
        ),
        (
            DeviceFileEvents
            | where InputValid and Timestamp between (StartTime .. EndTime)
            | where (isnotempty(TargetDeviceId) and DeviceId =~ TargetDeviceId)
                or (isnotempty(TargetDeviceName) and DeviceName =~ TargetDeviceName)
                or (isnotempty(NormalizedUPN) and tolower(tostring(InitiatingProcessAccountUpn)) == NormalizedUPN)
            | project
                EventTime = Timestamp,
                EvidenceType = "endpoint/file",
                Entity = tostring(DeviceName),
                RelatedEntity = tostring(FolderPath),
                Summary = strcat(tostring(ActionType), ": ", tostring(FolderPath)),
                Evidence = pack(
                    "device_id", tostring(DeviceId),
                    "sha256", tostring(SHA256),
                    "initiating_process", tostring(InitiatingProcessFileName),
                    "initiating_process_id", tostring(InitiatingProcessId),
                    "initiating_process_creation_time", tostring(InitiatingProcessCreationTime),
                    "account", tostring(InitiatingProcessAccountUpn)
                ),
                Decision = "Review required",
                NextAction = "Validate origin, execution, signer, prevalence, and remediation",
                SortOrder = 1
        )
    | top CandidateLimit by EventTime desc
);
let CandidateCount = toscalar(Candidates | count);
let EvidenceRows = Candidates | top MaxRows by EventTime desc;
let PrimaryEntity = strcat(
    iff(isnotempty(TargetUPN), strcat("user=", TargetUPN, ";"), ""),
    iff(isnotempty(TargetDeviceName), strcat("device=", TargetDeviceName, ";"), ""),
    iff(isnotempty(TargetDeviceId), strcat("device_id=", TargetDeviceId, ";"), ""),
    iff(isnotempty(TargetIP), strcat("ip=", TargetIP), "")
);
let InvalidStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = PrimaryEntity,
        RelatedEntity = "",
        Summary = "invalid_input: supply at least one actor, device, or IP plus a valid anchor, window up to 24h, and MaxRows from 1 to 100",
        Evidence = pack("lookback", tostring(Lookback), "lookforward", tostring(Lookforward)),
        Decision = "Review required",
        NextAction = "Correct the declared inputs before querying telemetry",
        SortOrder = 0
    | where not(InputValid);
let NoDataStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = PrimaryEntity,
        RelatedEntity = "",
        Summary = "no_matching_telemetry: no declared domain returned an event for the supplied entities",
        Evidence = pack("start", StartTime, "end", EndTime),
        Decision = "Review required",
        NextAction = "Confirm entity association, table coverage, schema, and incident anchor",
        SortOrder = 0
    | where InputValid and CandidateCount == 0;
let TruncationStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = PrimaryEntity,
        RelatedEntity = "",
        Summary = strcat("truncated: more than ", tostring(MaxRows), " correlated events exist"),
        Evidence = pack("max_rows", MaxRows),
        Decision = "Review required",
        NextAction = "Narrow the window or pivot to the decisive session, process, operation, or resource",
        SortOrder = 2
    | where InputValid and CandidateCount > MaxRows;
union InvalidStatus, NoDataStatus, EvidenceRows, TruncationStatus
| order by SortOrder asc, EventTime asc
| project EventTime, EvidenceType, Entity, RelatedEntity, Summary, Evidence, Decision, NextAction
