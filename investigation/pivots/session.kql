// name:              Authentication session pivot
// purpose:           Follow one session, correlation, or original-request identifier across interactive, non-interactive, and cloud activity.
// starting_entities: SessionId, CorrelationId, or OriginalRequestId; optional user principal name
// required_tables:   At least one of SigninLogs, AADNonInteractiveUserSignInLogs, CloudAppEvents
// optional_tables:   Any remaining declared source table
// variables:         TargetSessionId, TargetUPN, AnchorTime, Lookback, Lookforward, MaxRows
// time_window:       Default 2h before and 1h after AnchorTime; maximum routine bound 7d
// done_criteria:     Session origin, continuation, affected apps or resources, and containment scope are identified
// artifact_type:     investigation
// output_type:       quick-triage

let TargetSessionId = "";
let TargetUPN = "";
let AnchorTime = now();
let Lookback = 2h;
let Lookforward = 1h;
let MaxRows = 20;
let CandidateLimit = MaxRows + 1;
let NormalizedSession = tolower(TargetSessionId);
let NormalizedUPN = tolower(TargetUPN);
let StartTime = AnchorTime - Lookback;
let EndTime = AnchorTime + Lookforward;
let InputValid = isnotempty(NormalizedSession)
    and isnotnull(AnchorTime)
    and Lookback between (1m .. 7d)
    and Lookforward between (0m .. 7d)
    and MaxRows between (1 .. 100);
let EmptyEvidence = datatable(
    EventTime:datetime,
    EvidenceType:string,
    Entity:string,
    RelatedEntity:string,
    Summary:string,
    Evidence:dynamic,
    Decision:string,
    NextAction:string,
    SortOrder:int
)[];
let Candidates = materialize(
    union isfuzzy=true
        EmptyEvidence,
        (
            SigninLogs
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | extend EventSession = tolower(tostring(column_ifexists("SessionId", ""))),
                     EventCorrelation = tolower(tostring(CorrelationId)),
                     EventRequest = tolower(tostring(OriginalRequestId))
            | where EventSession == NormalizedSession
                or EventCorrelation == NormalizedSession
                or EventRequest == NormalizedSession
            | where isempty(NormalizedUPN) or tolower(UserPrincipalName) == NormalizedUPN
            | project
                EventTime = TimeGenerated,
                EvidenceType = "identity/interactive-session",
                Entity = tostring(UserPrincipalName),
                RelatedEntity = tostring(AppDisplayName),
                Summary = strcat("Interactive authentication via ", tostring(AuthenticationProtocol), " returned ", tostring(ResultType)),
                Evidence = pack(
                    "session_id", EventSession,
                    "correlation_id", tostring(CorrelationId),
                    "original_request_id", tostring(OriginalRequestId),
                    "source_ip", tostring(IPAddress),
                    "client_app", tostring(ClientAppUsed),
                    "authentication_details", tostring(AuthenticationDetails),
                    "risk", strcat(tostring(RiskLevelDuringSignIn), "/", tostring(RiskState)),
                    "device", tostring(DeviceDetail)
                ),
                Decision = iff(tolower(strcat(tostring(RiskLevelDuringSignIn), "/", tostring(RiskState))) has_any ("high", "medium", "atrisk", "confirmedcompromised"), "Suspicious / escalate", "Review required"),
                NextAction = "Validate authentication method, source infrastructure, device, and app access",
                SortOrder = 1
        ),
        (
            AADNonInteractiveUserSignInLogs
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | extend EventSession = tolower(tostring(column_ifexists("SessionId", ""))),
                     EventCorrelation = tolower(tostring(CorrelationId)),
                     EventRequest = tolower(tostring(OriginalRequestId))
            | where EventSession == NormalizedSession
                or EventCorrelation == NormalizedSession
                or EventRequest == NormalizedSession
            | where isempty(NormalizedUPN) or tolower(UserPrincipalName) == NormalizedUPN
            | project
                EventTime = TimeGenerated,
                EvidenceType = "identity/non-interactive-session",
                Entity = tostring(UserPrincipalName),
                RelatedEntity = tostring(AppDisplayName),
                Summary = strcat("Non-interactive authentication via ", tostring(AuthenticationProtocol), " returned ", tostring(ResultType)),
                Evidence = pack(
                    "session_id", EventSession,
                    "correlation_id", tostring(CorrelationId),
                    "original_request_id", tostring(OriginalRequestId),
                    "source_ip", tostring(IPAddress),
                    "client_app", tostring(ClientAppUsed),
                    "resource", tostring(ResourceDisplayName),
                    "risk", strcat(tostring(RiskLevelDuringSignIn), "/", tostring(RiskState)),
                    "device", tostring(DeviceDetail)
                ),
                Decision = "Review required",
                NextAction = "Determine whether token use is expected and whether access continued after containment",
                SortOrder = 1
        ),
        (
            CloudAppEvents
            | where InputValid and Timestamp between (StartTime .. EndTime)
            | extend EventSession = tolower(tostring(column_ifexists("SessionId", ""))),
                     EventCorrelation = tolower(tostring(column_ifexists("CorrelationId", ""))),
                     EventAccount = tolower(tostring(AccountId))
            | where EventSession == NormalizedSession or EventCorrelation == NormalizedSession
            | where isempty(NormalizedUPN)
                or EventAccount == NormalizedUPN
                or tolower(tostring(AccountDisplayName)) == NormalizedUPN
            | project
                EventTime = Timestamp,
                EvidenceType = "cloud/session-activity",
                Entity = iff(isnotempty(tostring(AccountDisplayName)), tostring(AccountDisplayName), tostring(AccountId)),
                RelatedEntity = tostring(Application),
                Summary = strcat(tostring(ActionType), " on ", tostring(ObjectName)),
                Evidence = pack(
                    "session_id", EventSession,
                    "correlation_id", EventCorrelation,
                    "source_ip", tostring(IPAddress),
                    "application", tostring(Application),
                    "object", tostring(ObjectName),
                    "raw_event", tostring(RawEventData)
                ),
                Decision = "Review required",
                NextAction = "Validate the resource action and expand containment to affected apps or objects",
                SortOrder = 1
        )
    | top CandidateLimit by EventTime desc
);
let CandidateCount = toscalar(Candidates | count);
let EvidenceRows = Candidates | top MaxRows by EventTime desc;
let InvalidStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = TargetSessionId,
        RelatedEntity = TargetUPN,
        Summary = "invalid_input: supply a session, correlation, or original-request ID plus a valid anchor and bounded window",
        Evidence = pack("lookback", tostring(Lookback), "lookforward", tostring(Lookforward)),
        Decision = "Review required",
        NextAction = "Correct the declared inputs before querying telemetry",
        SortOrder = 0
    | where not(InputValid);
let NoDataStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = TargetSessionId,
        RelatedEntity = TargetUPN,
        Summary = "no_matching_telemetry: no declared source returned this session identifier in the incident window",
        Evidence = pack("start", StartTime, "end", EndTime),
        Decision = "Review required",
        NextAction = "Confirm which identifier field the alert supplied, table coverage, user alias, and anchor",
        SortOrder = 0
    | where InputValid and CandidateCount == 0;
let TruncationStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = TargetSessionId,
        RelatedEntity = TargetUPN,
        Summary = strcat("truncated: more than ", tostring(MaxRows), " matching session events exist"),
        Evidence = pack("max_rows", MaxRows),
        Decision = "Review required",
        NextAction = "Narrow the window or pivot to the decisive app, resource, account, or IP",
        SortOrder = 2
    | where InputValid and CandidateCount > MaxRows;
union InvalidStatus, NoDataStatus, EvidenceRows, TruncationStatus
| order by SortOrder asc, EventTime asc
| project EventTime, EvidenceType, Entity, RelatedEntity, Summary, Evidence, Decision, NextAction
