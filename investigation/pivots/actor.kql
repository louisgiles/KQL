// name:              Actor incident-window pivot
// purpose:           Show the smallest identity, Microsoft 365, and Azure event set that changes the decision for one user.
// starting_entities: User principal name
// required_tables:   At least one of SigninLogs, AuditLogs, OfficeActivity, AzureActivity
// optional_tables:   Any remaining declared source table
// variables:         TargetUPN, AnchorTime, Lookback, Lookforward, MaxRows
// time_window:       Default 2h before and 1h after AnchorTime; maximum routine bound 7d
// done_criteria:     Primary event confirmed, affected resources identified, and containment or one specific next pivot chosen
// artifact_type:     investigation
// output_type:       quick-triage

let TargetUPN = "";
let AnchorTime = now();
let Lookback = 2h;
let Lookforward = 1h;
let MaxRows = 20;
let CandidateLimit = MaxRows + 1;
let NormalizedUPN = tolower(TargetUPN);
let StartTime = AnchorTime - Lookback;
let EndTime = AnchorTime + Lookforward;
let InputValid = isnotempty(NormalizedUPN)
    and isnotnull(AnchorTime)
    and Lookback between (1m .. 7d)
    and Lookforward between (0m .. 7d)
    and MaxRows between (1 .. 100);
let EmptyEvidence = datatable(
    EventTime:datetime,
    EvidenceType:string,
    Entity:string,
    RelatedEntity:string,
    Summary:string,
    Evidence:dynamic,
    Decision:string,
    NextAction:string,
    SortOrder:int
)[];
let Candidates = materialize(
    union isfuzzy=true
        EmptyEvidence,
        (
            SigninLogs
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | where tolower(UserPrincipalName) == NormalizedUPN
            | extend Result = tostring(ResultType),
                     Risk = tolower(strcat(tostring(RiskLevelDuringSignIn), "/", tostring(RiskState)))
            | project
                EventTime = TimeGenerated,
                EvidenceType = "identity/sign-in",
                Entity = tostring(UserPrincipalName),
                RelatedEntity = tostring(IPAddress),
                Summary = strcat("Sign-in to ", tostring(AppDisplayName), " via ", tostring(ClientAppUsed), " returned ", Result),
                Evidence = pack(
                    "result_type", Result,
                    "risk", Risk,
                    "conditional_access", tostring(ConditionalAccessStatus),
                    "correlation_id", tostring(CorrelationId),
                    "device", tostring(DeviceDetail),
                    "location", tostring(LocationDetails)
                ),
                Decision = iff(Risk has_any ("high", "medium", "atrisk", "confirmedcompromised"), "Suspicious / escalate", "Review required"),
                NextAction = iff(Result == "0", "Validate session, app access, and source IP", "Check whether attempts continued or later succeeded"),
                SortOrder = 1
        ),
        (
            AuditLogs
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | extend Initiator = tolower(tostring(parse_json(tostring(InitiatedBy)).user.userPrincipalName)),
                     TargetText = tolower(tostring(TargetResources))
            | where Initiator == NormalizedUPN or TargetText has NormalizedUPN
            | project
                EventTime = TimeGenerated,
                EvidenceType = "identity/directory-change",
                Entity = TargetUPN,
                RelatedEntity = tostring(OperationName),
                Summary = strcat(tostring(OperationName), " returned ", tostring(Result)),
                Evidence = pack(
                    "initiated_by", tostring(InitiatedBy),
                    "targets", tostring(TargetResources),
                    "category", tostring(Category),
                    "correlation_id", tostring(CorrelationId)
                ),
                Decision = "Review required",
                NextAction = "Validate the actor, target, approval, and resulting access",
                SortOrder = 1
        ),
        (
            OfficeActivity
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | extend OfficeActor = tolower(tostring(UserId)),
                     OfficeTarget = tostring(column_ifexists("ObjectId", ""))
            | where OfficeActor == NormalizedUPN or tolower(tostring(Parameters)) has NormalizedUPN
            | project
                EventTime = TimeGenerated,
                EvidenceType = "m365/operation",
                Entity = tostring(UserId),
                RelatedEntity = OfficeTarget,
                Summary = strcat(tostring(Operation), " in ", tostring(OfficeWorkload)),
                Evidence = pack(
                    "client_ip", tostring(ClientIP),
                    "result", tostring(ResultStatus),
                    "parameters", tostring(Parameters),
                    "user_type", tostring(UserType)
                ),
                Decision = "Review required",
                NextAction = "Confirm the target, operation intent, and persistence or data impact",
                SortOrder = 1
        ),
        (
            AzureActivity
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | extend AzureActor = tolower(tostring(Caller))
            | where AzureActor == NormalizedUPN or tolower(tostring(Claims)) has NormalizedUPN
            | project
                EventTime = TimeGenerated,
                EvidenceType = "cloud/control-plane",
                Entity = tostring(Caller),
                RelatedEntity = tostring(ResourceId),
                Summary = strcat(tostring(OperationNameValue), " returned ", tostring(ActivityStatusValue)),
                Evidence = pack(
                    "source_ip", tostring(CallerIpAddress),
                    "subscription", tostring(SubscriptionId),
                    "resource_group", tostring(ResourceGroup),
                    "correlation_id", tostring(CorrelationId)
                ),
                Decision = "Review required",
                NextAction = "Validate the operation scope and inspect adjacent role, credential, or resource changes",
                SortOrder = 1
        )
    | top CandidateLimit by EventTime desc
);
let CandidateCount = toscalar(Candidates | count);
let EvidenceRows = Candidates | top MaxRows by EventTime desc;
let InvalidStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = TargetUPN,
        RelatedEntity = "",
        Summary = "invalid_input: supply a UPN, valid anchor, bounded window, and MaxRows from 1 to 100",
        Evidence = pack("lookback", tostring(Lookback), "lookforward", tostring(Lookforward)),
        Decision = "Review required",
        NextAction = "Correct the declared inputs before querying telemetry",
        SortOrder = 0
    | where not(InputValid);
let NoDataStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = TargetUPN,
        RelatedEntity = "",
        Summary = "no_matching_telemetry: no declared source returned an actor event in the incident window",
        Evidence = pack("start", StartTime, "end", EndTime),
        Decision = "Review required",
        NextAction = "Confirm table coverage, actor aliases, and the incident anchor",
        SortOrder = 0
    | where InputValid and CandidateCount == 0;
let TruncationStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = TargetUPN,
        RelatedEntity = "",
        Summary = strcat("truncated: more than ", tostring(MaxRows), " matching events exist"),
        Evidence = pack("max_rows", MaxRows),
        Decision = "Review required",
        NextAction = "Narrow the window or pivot to the decisive resource, session, or IP",
        SortOrder = 2
    | where InputValid and CandidateCount > MaxRows;
union InvalidStatus, NoDataStatus, EvidenceRows, TruncationStatus
| order by SortOrder asc, EventTime asc
| project EventTime, EvidenceType, Entity, RelatedEntity, Summary, Evidence, Decision, NextAction
