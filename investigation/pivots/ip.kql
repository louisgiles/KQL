// name:              IP incident-window pivot
// purpose:           Show which identity, Microsoft 365, Azure, endpoint, and email sources one IP touched in the incident window.
// starting_entities: IPv4 or IPv6 address
// required_tables:   At least one of SigninLogs, AADNonInteractiveUserSignInLogs, AuditLogs, OfficeActivity, AzureActivity, DeviceNetworkEvents, EmailEvents
// optional_tables:   Any remaining declared source table
// variables:         TargetIP, AnchorTime, Lookback, Lookforward
// time_window:       Default 4h before and 1h after AnchorTime; maximum routine bound 7d
// done_criteria:     Touched source families, accounts, devices, and the next containment pivot are identified
// artifact_type:     investigation
// output_type:       quick-triage

let TargetIP = "";
let AnchorTime = now();
let Lookback = 4h;
let Lookforward = 1h;
let NormalizedIP = tolower(TargetIP);
let StartTime = AnchorTime - Lookback;
let EndTime = AnchorTime + Lookforward;
let InputValid = isnotempty(NormalizedIP)
    and strlen(NormalizedIP) <= 64
    and (NormalizedIP contains "." or NormalizedIP contains ":")
    and isnotnull(AnchorTime)
    and Lookback between (1m .. 7d)
    and Lookforward between (0m .. 7d);
let EmptySource = datatable(
    EventTime:datetime,
    Source:string,
    Account:string,
    Device:string,
    Activity:string
)[];
let SourceEvents =
    union isfuzzy=true
        EmptySource,
        (
            SigninLogs
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | where tolower(IPAddress) == NormalizedIP
            | project
                EventTime = TimeGenerated,
                Source = "SigninLogs",
                Account = tostring(UserPrincipalName),
                Device = tostring(parse_json(tostring(DeviceDetail)).displayName),
                Activity = strcat("Interactive sign-in to ", tostring(AppDisplayName), " result ", tostring(ResultType))
        ),
        (
            AADNonInteractiveUserSignInLogs
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | where tolower(IPAddress) == NormalizedIP
            | project
                EventTime = TimeGenerated,
                Source = "AADNonInteractiveUserSignInLogs",
                Account = tostring(UserPrincipalName),
                Device = tostring(parse_json(tostring(DeviceDetail)).displayName),
                Activity = strcat("Non-interactive sign-in to ", tostring(AppDisplayName), " result ", tostring(ResultType))
        ),
        (
            AuditLogs
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | extend Initiator = parse_json(tostring(InitiatedBy))
            | where tolower(tostring(Initiator.user.ipAddress)) == NormalizedIP
                or tolower(tostring(Initiator.app.ipAddress)) == NormalizedIP
            | project
                EventTime = TimeGenerated,
                Source = "AuditLogs",
                Account = iff(isnotempty(tostring(Initiator.user.userPrincipalName)), tostring(Initiator.user.userPrincipalName), tostring(Initiator.app.displayName)),
                Device = "",
                Activity = tostring(OperationName)
        ),
        (
            OfficeActivity
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | extend OfficeIP = tolower(tostring(ClientIP))
            | where OfficeIP == NormalizedIP or OfficeIP startswith strcat(NormalizedIP, ":")
            | project
                EventTime = TimeGenerated,
                Source = "OfficeActivity",
                Account = tostring(UserId),
                Device = tostring(OfficeWorkload),
                Activity = tostring(Operation)
        ),
        (
            AzureActivity
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | where tolower(tostring(CallerIpAddress)) == NormalizedIP
            | project
                EventTime = TimeGenerated,
                Source = "AzureActivity",
                Account = tostring(Caller),
                Device = tostring(ResourceId),
                Activity = tostring(OperationNameValue)
        ),
        (
            DeviceNetworkEvents
            | where InputValid and Timestamp between (StartTime .. EndTime)
            | where tolower(RemoteIP) == NormalizedIP or tolower(LocalIP) == NormalizedIP
            | project
                EventTime = Timestamp,
                Source = "DeviceNetworkEvents",
                Account = tostring(InitiatingProcessAccountUpn),
                Device = tostring(DeviceName),
                Activity = strcat(tostring(ActionType), " via ", tostring(InitiatingProcessFileName), " to port ", tostring(RemotePort))
        ),
        (
            EmailEvents
            | where InputValid and TimeGenerated between (StartTime .. EndTime)
            | where tolower(tostring(SenderIPv4)) == NormalizedIP
                or tolower(tostring(column_ifexists("SenderIPv6", ""))) == NormalizedIP
            | project
                EventTime = TimeGenerated,
                Source = "EmailEvents",
                Account = tostring(RecipientEmailAddress),
                Device = tostring(SenderFromDomain),
                Activity = strcat("Mail delivery ", tostring(DeliveryAction), " / ", tostring(DeliveryLocation))
        );
let Rollup = materialize(
    SourceEvents
    | summarize
        Events = count(),
        FirstSeen = min(EventTime),
        LastSeen = max(EventTime),
        Accounts = make_set_if(Account, isnotempty(Account), 8),
        Devices = make_set_if(Device, isnotempty(Device), 8),
        Activities = make_set(Activity, 8)
      by Source
);
let SourceCount = toscalar(Rollup | count);
let EvidenceRows =
    Rollup
    | project
        EventTime = FirstSeen,
        EvidenceType = "ip/source-prevalence",
        Entity = TargetIP,
        RelatedEntity = tostring(Accounts),
        Summary = strcat(Source, ": ", tostring(Events), " events from ", tostring(FirstSeen), " to ", tostring(LastSeen)),
        Evidence = pack(
            "source", Source,
            "events", Events,
            "first_seen", FirstSeen,
            "last_seen", LastSeen,
            "accounts", Accounts,
            "devices", Devices,
            "activities", Activities
        ),
        Decision = "Review required",
        NextAction = case(
            Source == "DeviceNetworkEvents", "Inspect the initiating process and affected devices",
            Source in ("SigninLogs", "AADNonInteractiveUserSignInLogs"), "Validate the users, sessions, apps, and authentication result",
            Source == "EmailEvents", "Assess recipient exposure and campaign spread",
            "Validate the affected actor, operation, and resource"
        ),
        SortOrder = 1;
let InvalidStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = TargetIP,
        RelatedEntity = "",
        Summary = "invalid_input: supply an IPv4 or IPv6 address, valid anchor, and bounded window",
        Evidence = pack("lookback", tostring(Lookback), "lookforward", tostring(Lookforward)),
        Decision = "Review required",
        NextAction = "Correct the declared inputs before querying telemetry",
        SortOrder = 0
    | where not(InputValid);
let NoDataStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = TargetIP,
        RelatedEntity = "",
        Summary = "no_matching_telemetry: no declared source returned an event for this IP in the incident window",
        Evidence = pack("start", StartTime, "end", EndTime),
        Decision = "Review required",
        NextAction = "Confirm source-specific IP formatting, table coverage, and the incident anchor",
        SortOrder = 0
    | where InputValid and SourceCount == 0;
union InvalidStatus, NoDataStatus, EvidenceRows
| order by SortOrder asc, EventTime asc
| project EventTime, EvidenceType, Entity, RelatedEntity, Summary, Evidence, Decision, NextAction
