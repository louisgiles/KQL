// name:              Exact process activity pivot
// purpose:           Show what one exact Defender process executed, wrote, contacted, or changed without filename-only correlation.
// starting_entities: DeviceId, ProcessId, and ProcessCreationTime
// required_tables:   DeviceProcessEvents
// optional_tables:   DeviceNetworkEvents, DeviceFileEvents, DeviceRegistryEvents
// variables:         TargetDeviceId, TargetProcessId, TargetProcessCreationTime, AnchorTime, Lookback, Lookforward, MaxRows
// time_window:       Default 2h before and 1h after AnchorTime; maximum routine bound 7d
// done_criteria:     Exact process identity confirmed, direct children and effects reviewed, and isolation or closure evidence identified
// artifact_type:     investigation
// output_type:       quick-triage

let TargetDeviceId = "";
let TargetProcessId = long(-1);
let TargetProcessCreationTime = datetime(null);
let AnchorTime = now();
let Lookback = 2h;
let Lookforward = 1h;
let MaxRows = 30;
let CandidateLimit = MaxRows + 1;
let StartTime = AnchorTime - Lookback;
let EndTime = AnchorTime + Lookforward;
let ProcessKey = strcat(TargetDeviceId, "|", tostring(TargetProcessId), "|", tostring(TargetProcessCreationTime));
let InputValid = isnotempty(TargetDeviceId)
    and TargetProcessId >= 0
    and isnotnull(TargetProcessCreationTime)
    and isnotnull(AnchorTime)
    and Lookback between (1m .. 7d)
    and Lookforward between (0m .. 7d)
    and MaxRows between (1 .. 100);
let EmptyEvidence = datatable(
    EventTime:datetime,
    EvidenceType:string,
    Entity:string,
    RelatedEntity:string,
    Summary:string,
    Evidence:dynamic,
    Decision:string,
    NextAction:string,
    SortOrder:int
)[];
let Candidates = materialize(
    union isfuzzy=true
        EmptyEvidence,
        (
            DeviceProcessEvents
            | where InputValid and Timestamp between (StartTime .. EndTime)
            | where DeviceId =~ TargetDeviceId
            | where (ProcessId == TargetProcessId and ProcessCreationTime == TargetProcessCreationTime)
                or (InitiatingProcessId == TargetProcessId and InitiatingProcessCreationTime == TargetProcessCreationTime)
            | extend ProcessRole = iff(
                ProcessId == TargetProcessId and ProcessCreationTime == TargetProcessCreationTime,
                "target",
                "direct-child"
            )
            | project
                EventTime = Timestamp,
                EvidenceType = strcat("endpoint/process-", ProcessRole),
                Entity = ProcessKey,
                RelatedEntity = tostring(FileName),
                Summary = strcat(ProcessRole, ": ", tostring(FileName), " ", tostring(ProcessCommandLine)),
                Evidence = pack(
                    "device", tostring(DeviceName),
                    "device_id", tostring(DeviceId),
                    "process_id", tostring(ProcessId),
                    "process_creation_time", tostring(ProcessCreationTime),
                    "sha256", tostring(SHA256),
                    "account", tostring(AccountUpn),
                    "parent_file", tostring(InitiatingProcessFileName),
                    "parent_process_id", tostring(InitiatingProcessId),
                    "parent_creation_time", tostring(InitiatingProcessCreationTime)
                ),
                Decision = "Review required",
                NextAction = iff(ProcessRole == "target", "Validate signer, hash, command line, parent, and prevalence", "Decide whether the child expands the process chain or containment scope"),
                SortOrder = 1
        ),
        (
            DeviceNetworkEvents
            | where InputValid and Timestamp between (StartTime .. EndTime)
            | where DeviceId =~ TargetDeviceId
            | where InitiatingProcessId == TargetProcessId
                and InitiatingProcessCreationTime == TargetProcessCreationTime
            | project
                EventTime = Timestamp,
                EvidenceType = "endpoint/process-network",
                Entity = ProcessKey,
                RelatedEntity = iff(isnotempty(tostring(RemoteUrl)), tostring(RemoteUrl), tostring(RemoteIP)),
                Summary = strcat(tostring(ActionType), " to ", iff(isnotempty(tostring(RemoteUrl)), tostring(RemoteUrl), tostring(RemoteIP)), ":", tostring(RemotePort)),
                Evidence = pack(
                    "remote_ip", tostring(RemoteIP),
                    "remote_url", tostring(RemoteUrl),
                    "remote_port", tostring(RemotePort),
                    "local_ip", tostring(LocalIP),
                    "protocol", tostring(Protocol)
                ),
                Decision = "Review required",
                NextAction = "Validate destination, prevalence, traffic direction, and related devices",
                SortOrder = 1
        ),
        (
            DeviceFileEvents
            | where InputValid and Timestamp between (StartTime .. EndTime)
            | where DeviceId =~ TargetDeviceId
            | where InitiatingProcessId == TargetProcessId
                and InitiatingProcessCreationTime == TargetProcessCreationTime
            | project
                EventTime = Timestamp,
                EvidenceType = "endpoint/process-file",
                Entity = ProcessKey,
                RelatedEntity = tostring(FolderPath),
                Summary = strcat(tostring(ActionType), ": ", tostring(FolderPath)),
                Evidence = pack(
                    "file_name", tostring(FileName),
                    "folder_path", tostring(FolderPath),
                    "sha256", tostring(SHA256),
                    "previous_path", tostring(PreviousFolderPath),
                    "previous_name", tostring(PreviousFileName)
                ),
                Decision = "Review required",
                NextAction = "Validate file origin, execution, persistence value, prevalence, and remediation",
                SortOrder = 1
        ),
        (
            DeviceRegistryEvents
            | where InputValid and Timestamp between (StartTime .. EndTime)
            | where DeviceId =~ TargetDeviceId
            | where InitiatingProcessId == TargetProcessId
                and InitiatingProcessCreationTime == TargetProcessCreationTime
            | project
                EventTime = Timestamp,
                EvidenceType = "endpoint/process-registry",
                Entity = ProcessKey,
                RelatedEntity = tostring(RegistryKey),
                Summary = strcat(tostring(ActionType), ": ", tostring(RegistryKey), " ", tostring(RegistryValueName)),
                Evidence = pack(
                    "registry_key", tostring(RegistryKey),
                    "value_name", tostring(RegistryValueName),
                    "value_data", tostring(RegistryValueData),
                    "value_type", tostring(RegistryValueType)
                ),
                Decision = "Review required",
                NextAction = "Assess persistence, credential, or security-control impact",
                SortOrder = 1
        )
    | top CandidateLimit by EventTime desc
);
let CandidateCount = toscalar(Candidates | count);
let EvidenceRows = Candidates | top MaxRows by EventTime desc;
let InvalidStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = ProcessKey,
        RelatedEntity = "",
        Summary = "invalid_input: supply DeviceId, ProcessId, ProcessCreationTime, a valid anchor, bounded window, and MaxRows from 1 to 100",
        Evidence = pack("device_id", TargetDeviceId, "process_id", TargetProcessId, "creation_time", TargetProcessCreationTime),
        Decision = "Review required",
        NextAction = "Correct the exact process identity before querying telemetry",
        SortOrder = 0
    | where not(InputValid);
let NoDataStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = ProcessKey,
        RelatedEntity = "",
        Summary = "no_matching_telemetry: no target, child, network, file, or registry event matched the exact process identity",
        Evidence = pack("start", StartTime, "end", EndTime),
        Decision = "Review required",
        NextAction = "Confirm process creation time precision, device identity, sensor coverage, and anchor",
        SortOrder = 0
    | where InputValid and CandidateCount == 0;
let TruncationStatus =
    print
        EventTime = AnchorTime,
        EvidenceType = "status",
        Entity = ProcessKey,
        RelatedEntity = "",
        Summary = strcat("truncated: more than ", tostring(MaxRows), " matching process-chain events exist"),
        Evidence = pack("max_rows", MaxRows),
        Decision = "Review required",
        NextAction = "Narrow the window or pivot to the decisive child, file, registry key, or destination",
        SortOrder = 2
    | where InputValid and CandidateCount > MaxRows;
union InvalidStatus, NoDataStatus, EvidenceRows, TruncationStatus
| order by SortOrder asc, EventTime asc
| project EventTime, EvidenceType, Entity, RelatedEntity, Summary, Evidence, Decision, NextAction
