// name:              Device-Code Exact-IP Campaign Scope
// purpose:           Show other users, apps, and resources reached by direct device-code activity from the anchor tenant and exact source IP.
// starting_entities: Exact user UPN and sign-in event time; source IP, SigninLogs.Id, and CorrelationId are optional disambiguators.
// required_tables:   SigninLogs
// optional_tables:   none
// variables:         AlertTime, TargetUPN, TargetSignInId, TargetCorrelationId, TargetIPAddress, CampaignLookback, CampaignLookforward, MaxRows
// time_window:       Default 24h before and after AlertTime; maximum routine bound 7d each direction
// done_criteria:     Exact-IP tenant scope, affected users, successful flows, apps, resources, and containment expansion are explicit.
// artifact_type:     investigation
// output_type:       analysis

let AlertTime = datetime(null);                 // required: actual UTC sign-in time
let TargetUPN = "";                             // required: exact UPN
let TargetSignInId = "";                        // optional: SigninLogs.Id; preferred
let TargetCorrelationId = "";                   // optional
let TargetIPAddress = "";                       // optional: exact IP; resolved from the anchor when blank
let CampaignLookback = 24h;
let CampaignLookforward = 24h;
let MaxRows = 100;
let AlertHalfWindow = 5m;
let IngestionSlack = 1h;
let CandidateLimit = MaxRows + 1;
let NormalizedUPN = tolower(TargetUPN);
let NormalizedSignInId = tolower(TargetSignInId);
let NormalizedCorrelationId = tolower(TargetCorrelationId);
let InputValid = isnotempty(NormalizedUPN)
    and isnotnull(AlertTime)
    and CampaignLookback between (1h .. 7d)
    and CampaignLookforward between (0m .. 7d)
    and MaxRows between (1 .. 500);
let StartTime = AlertTime - CampaignLookback;
let EndTime = AlertTime + CampaignLookforward;

let AnchorCandidates = materialize(
    SigninLogs
    | where InputValid
    | where TimeGenerated between
        (AlertTime - AlertHalfWindow - IngestionSlack .. AlertTime + AlertHalfWindow + IngestionSlack)
    | extend EventTime = coalesce(CreatedDateTime, TimeGenerated)
    | where EventTime between (AlertTime - AlertHalfWindow .. AlertTime + AlertHalfWindow)
    | where tolower(UserPrincipalName) == NormalizedUPN
    | where AuthenticationProtocol =~ "deviceCode"
    | extend
        RowSignInId = tolower(tostring(Id)),
        RowCorrelationId = tolower(tostring(CorrelationId)),
        RowIPAddress = tostring(IPAddress),
        ExactId = isnotempty(NormalizedSignInId) and RowSignInId == NormalizedSignInId,
        ExactCorrelation = isnotempty(NormalizedCorrelationId) and RowCorrelationId == NormalizedCorrelationId,
        ExactIP = isnotempty(TargetIPAddress) and RowIPAddress == TargetIPAddress,
        DistanceSeconds = abs(datetime_diff("second", EventTime, AlertTime))
    | where isempty(NormalizedSignInId) or ExactId
    | where isempty(NormalizedCorrelationId) or ExactCorrelation
    | where isempty(TargetIPAddress) or ExactIP
    | extend AnchorRank = iff(ExactId, 1000, 0)
        + iff(ExactCorrelation, 100, 0)
        + iff(ExactIP, 10, 0)
        + iff(tostring(ResultType) == "0", 1, 0)
    | top 1 by AnchorRank desc, DistanceSeconds asc, EventTime asc
    | project
        AnchorEventTime = EventTime,
        AnchorSignInId = tostring(Id),
        AnchorTenantId = tolower(tostring(AADTenantId)),
        AnchorIPAddress = tostring(IPAddress),
        AnchorUserId = tolower(tostring(UserId)),
        AnchorAppId = tolower(tostring(AppId)),
        AnchorResourceId = tolower(tostring(ResourceId))
);
let AnchorFound = toscalar(AnchorCandidates | count) == 1;
let AnchorTenantId = tostring(toscalar(AnchorCandidates | project AnchorTenantId));
let ResolvedIPAddress = tostring(toscalar(AnchorCandidates | project AnchorIPAddress));
let AnchorSignInId = tostring(toscalar(AnchorCandidates | project AnchorSignInId));

let FlowRows = materialize(
    SigninLogs
    | where AnchorFound
    | where TimeGenerated between (StartTime - IngestionSlack .. EndTime + IngestionSlack)
    | extend EventTime = coalesce(CreatedDateTime, TimeGenerated)
    | where EventTime between (StartTime .. EndTime)
    | where tolower(tostring(AADTenantId)) == AnchorTenantId
    | where tostring(IPAddress) == ResolvedIPAddress
    | where AuthenticationProtocol =~ "deviceCode"
    | extend
        NormalizedEventUPN = tolower(tostring(UserPrincipalName)),
        IsAnchorUser = NormalizedEventUPN == NormalizedUPN,
        IsSuccess = tostring(ResultType) == "0",
        StableFlowKey = case(
            isnotempty(tostring(OriginalRequestId)), strcat("request:", tolower(tostring(OriginalRequestId))),
            isnotempty(tostring(CorrelationId)), strcat("correlation:", tolower(tostring(CorrelationId))),
            isnotempty(tostring(Id)), strcat("id:", tolower(tostring(Id))),
            strcat("fallback:", NormalizedEventUPN, "|", tostring(EventTime), "|", tolower(tostring(AppId))))
    | project
        EventTime,
        UserPrincipalName = tostring(UserPrincipalName),
        NormalizedEventUPN,
        UserId = tostring(UserId),
        IsAnchorUser,
        IsSuccess,
        StableFlowKey,
        AppId = tostring(AppId),
        AppDisplayName = tostring(AppDisplayName),
        ResourceId = tostring(ResourceId),
        ResourceDisplayName = tostring(ResourceDisplayName),
        ResultType = tostring(ResultType),
        ResultDescription = tostring(ResultDescription),
        SignInId = tostring(Id),
        OriginalRequestId = tostring(OriginalRequestId),
        CorrelationId = tostring(CorrelationId),
        SessionId = tostring(SessionId),
        TokenId = tostring(UniqueTokenIdentifier),
        ClientAppUsed = tostring(ClientAppUsed),
        UserAgent = tostring(UserAgent),
        Location = tostring(Location),
        ASN = tostring(AutonomousSystemNumber),
        Risk = strcat(tostring(RiskLevelDuringSignIn), "/", tostring(RiskState))
);

let ScopeRows = materialize(
    FlowRows
    | summarize
        FirstSeen = min(EventTime),
        LastSeen = max(EventTime),
        Attempts = dcount(StableFlowKey),
        SuccessfulFlows = dcountif(StableFlowKey, IsSuccess),
        SignInIds = make_set(SignInId, 20),
        CorrelationIds = make_set(CorrelationId, 20),
        SessionIds = make_set(SessionId, 20),
        TokenIds = make_set(TokenId, 20),
        ResultTypes = make_set(ResultType, 20),
        ResultDescriptions = make_set(ResultDescription, 10),
        ClientApps = make_set(ClientAppUsed, 10),
        UserAgents = make_set(UserAgent, 10),
        Locations = make_set(Location, 10),
        ASNs = make_set(ASN, 10),
        Risks = make_set(Risk, 10)
      by UserPrincipalName, NormalizedEventUPN, UserId, IsAnchorUser, AppId, AppDisplayName, ResourceId, ResourceDisplayName
    | extend
        Priority = case(not(IsAnchorUser) and SuccessfulFlows > 0, "critical", not(IsAnchorUser), "high", SuccessfulFlows > 0, "high", "review"),
        Decision = iff(not(IsAnchorUser), "Suspicious / escalate", "Review required"),
        ScopeReason = case(
            not(IsAnchorUser) and SuccessfulFlows > 0, "another identity has a successful device-code flow from the exact source IP",
            not(IsAnchorUser), "another identity has attempted device-code activity from the exact source IP",
            SuccessfulFlows > 0, "anchor identity has a successful device-code flow from the exact source IP",
            "anchor identity has failed device-code activity from the exact source IP")
    | top CandidateLimit by LastSeen desc
);
let ScopeRowCount = toscalar(ScopeRows | count);
let EvidenceRows =
    ScopeRows
    | top MaxRows by LastSeen desc
    | project
        EventTime = LastSeen,
        Priority,
        AssociationConfidence = "High",
        AssociationBasis = "same tenant, exact source IP, and direct device-code protocol",
        IsAnchorUser,
        UserPrincipalName,
        AppDisplayName,
        ResourceDisplayName,
        FirstSeen,
        LastSeen,
        Attempts,
        SuccessfulFlows,
        Summary = strcat(
            UserPrincipalName, " used ", AppDisplayName, " to ", ResourceDisplayName,
            ": ", tostring(SuccessfulFlows), " successful of ", tostring(Attempts), " stable flows"),
        Evidence = pack(
            "scope_reason", ScopeReason,
            "user_id", UserId,
            "app_id", AppId,
            "resource_id", ResourceId,
            "sign_in_ids", SignInIds,
            "correlation_ids", CorrelationIds,
            "session_ids", SessionIds,
            "token_ids", TokenIds,
            "result_types", ResultTypes,
            "result_descriptions", ResultDescriptions,
            "client_apps", ClientApps,
            "user_agents", UserAgents,
            "locations", Locations,
            "asns", ASNs,
            "risks", Risks),
        Decision,
        NextAction = iff(
            not(IsAnchorUser),
            "Add the identity to incident scope, validate the matching flow, and contain if unauthorised",
            "Use post-auth-scope.kql to determine session, token, application, and resource impact"),
        SortOrder = 1;

let InvalidStatus =
    print
        EventTime = AlertTime,
        Priority = "fix scope",
        AssociationConfidence = "none",
        AssociationBasis = "invalid input",
        IsAnchorUser = true,
        UserPrincipalName = TargetUPN,
        AppDisplayName = "invalid_input",
        ResourceDisplayName = "",
        FirstSeen = AlertTime,
        LastSeen = AlertTime,
        Attempts = long(0),
        SuccessfulFlows = long(0),
        Summary = "Supply the exact UPN, actual UTC sign-in time, bounded campaign window, and MaxRows from 1 to 500",
        Evidence = pack("lookback", tostring(CampaignLookback), "lookforward", tostring(CampaignLookforward), "max_rows", MaxRows),
        Decision = "Review required",
        NextAction = "Correct the declared inputs before querying telemetry",
        SortOrder = 0
    | where not(InputValid);
let AnchorStatus =
    print
        EventTime = AlertTime,
        Priority = "fix scope",
        AssociationConfidence = "none",
        AssociationBasis = "no unique device-code anchor",
        IsAnchorUser = true,
        UserPrincipalName = TargetUPN,
        AppDisplayName = "anchor_not_found",
        ResourceDisplayName = "deviceCode",
        FirstSeen = AlertTime,
        LastSeen = AlertTime,
        Attempts = long(0),
        SuccessfulFlows = long(0),
        Summary = "No device-code sign-in matched the supplied incident entities inside the anchor window",
        Evidence = pack("anchor_start", AlertTime - AlertHalfWindow, "anchor_end", AlertTime + AlertHalfWindow),
        Decision = "Review required",
        NextAction = "Correct the event time or add the SigninLogs.Id, CorrelationId, or exact source IP",
        SortOrder = 0
    | where InputValid and not(AnchorFound);
let NoIPStatus =
    print
        EventTime = AlertTime,
        Priority = "fix scope",
        AssociationConfidence = "none",
        AssociationBasis = "anchor has no source IP",
        IsAnchorUser = true,
        UserPrincipalName = TargetUPN,
        AppDisplayName = "source_ip_missing",
        ResourceDisplayName = "deviceCode",
        FirstSeen = AlertTime,
        LastSeen = AlertTime,
        Attempts = long(0),
        SuccessfulFlows = long(0),
        Summary = "The anchor sign-in has no source IP, so exact-IP campaign scope cannot run",
        Evidence = pack("anchor_sign_in_id", AnchorSignInId),
        Decision = "Review required",
        NextAction = "Confirm the source sign-in record or supply the exact incident IP",
        SortOrder = 0
    | where InputValid and AnchorFound and isempty(ResolvedIPAddress);
let NoDataStatus =
    print
        EventTime = AlertTime,
        Priority = "review",
        AssociationConfidence = "none",
        AssociationBasis = "no matching direct device-code rows",
        IsAnchorUser = true,
        UserPrincipalName = TargetUPN,
        AppDisplayName = "no_campaign_telemetry",
        ResourceDisplayName = "deviceCode",
        FirstSeen = StartTime,
        LastSeen = EndTime,
        Attempts = long(0),
        SuccessfulFlows = long(0),
        Summary = "No direct device-code activity was returned for the anchor tenant and exact source IP",
        Evidence = pack("tenant_id", AnchorTenantId, "source_ip", ResolvedIPAddress, "start", StartTime, "end", EndTime),
        Decision = "Review required",
        NextAction = "Verify SigninLogs coverage and the resolved source IP before declaring the campaign isolated",
        SortOrder = 0
    | where InputValid and AnchorFound and isnotempty(ResolvedIPAddress) and ScopeRowCount == 0;
let TruncationStatus =
    print
        EventTime = AlertTime,
        Priority = "review",
        AssociationConfidence = "none",
        AssociationBasis = "row limit",
        IsAnchorUser = true,
        UserPrincipalName = TargetUPN,
        AppDisplayName = "truncated",
        ResourceDisplayName = "deviceCode",
        FirstSeen = StartTime,
        LastSeen = EndTime,
        Attempts = long(0),
        SuccessfulFlows = long(0),
        Summary = strcat("More than ", tostring(MaxRows), " user, app, and resource combinations matched the exact-IP campaign scope"),
        Evidence = pack("max_rows", MaxRows, "tenant_id", AnchorTenantId, "source_ip", ResolvedIPAddress),
        Decision = "Review required",
        NextAction = "Narrow the campaign window or raise MaxRows within the declared ceiling",
        SortOrder = 2
    | where InputValid and AnchorFound and ScopeRowCount > MaxRows;
union InvalidStatus, AnchorStatus, NoIPStatus, NoDataStatus, EvidenceRows, TruncationStatus
| extend PriorityRank = case(Priority == "critical", 0, Priority == "high", 1, Priority == "review", 2, 3)
| order by SortOrder asc, PriorityRank asc, EventTime asc
| project
    EventTime,
    Priority,
    AssociationConfidence,
    AssociationBasis,
    IsAnchorUser,
    UserPrincipalName,
    AppDisplayName,
    ResourceDisplayName,
    FirstSeen,
    LastSeen,
    Attempts,
    SuccessfulFlows,
    Summary,
    Evidence,
    Decision,
    NextAction
