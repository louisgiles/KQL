// name:              Auth Changes Quick Dive + Narrative — App / SP Credential Added
// purpose:           Fast behavioural-context triage for the recurring alert:
//                    "New access credential added to Application or Service Principal".
// starting_entities: ActivityDateTime, OperationName, InitiatingUserPrincipalName
// required_tables:   AuditLogs
// optional_tables:   AADServicePrincipalSignInLogs
// output_type:       quick-triage
//
// Philosophy:
// Adding a key or password to an existing app registration or service principal
// is the canonical post-compromise persistence move. Benignity here is
// prevalence- and actor-based.
// This query answers:
// - What credential was added, of what class, to what object?
// - Is credential management normal for this actor?
// - Does this target normally receive credentials?
// - What else did the actor do under the same correlation?
// - Does this require deep-dive?

let AlertTime = datetime(2026-01-01T00:00:00Z);
let AlertTitle = "";
let ActorToCheck = "";            // InitiatingUserPrincipalName
let ActorIpToCheck = "";
let TargetToCheck = "";           // app / SP displayName or object id
let OperationToCheck = "";
//
let EventWindow = 1h;
let BaselineWindow = 90d;
//
let CredentialOps = dynamic([
    "Add service principal credentials",
    "Update application – Certificates and secrets management",
    "Update application",
    "Update service principal"
]);
//
let AlertScope = materialize(
    AuditLogs
    | where TimeGenerated between (AlertTime - EventWindow .. AlertTime + EventWindow)
    | where Category == "ApplicationManagement"
    | where isempty(OperationToCheck) or OperationName contains OperationToCheck
    | extend
        Actor = tolower(coalesce(
            tostring(InitiatedBy.user.userPrincipalName),
            tostring(InitiatedBy.app.displayName))),
        ActorType = iff(isnotempty(tostring(InitiatedBy.user.userPrincipalName)), "User", "ServicePrincipal"),
        ActorIP = tostring(InitiatedBy.user.ipAddress),
        ActorId = tostring(coalesce(tostring(InitiatedBy.user.id), tostring(InitiatedBy.app.appId))),
        Operation = tostring(OperationName),
        Correlation = tostring(CorrelationId),
        Result = tostring(Result)
    | where isempty(ActorToCheck) or Actor contains tolower(ActorToCheck)
    | where isempty(ActorIpToCheck) or ActorIP contains ActorIpToCheck
    | mv-expand TargetResource = TargetResources
    | extend
        TargetType = tostring(TargetResource.type),
        TargetName = tostring(TargetResource.displayName),
        TargetId   = tostring(TargetResource.id)
    | where isempty(TargetToCheck) or TargetName contains TargetToCheck or TargetId contains TargetToCheck
    | mv-expand ModProp = TargetResource.modifiedProperties
    | where tostring(ModProp.displayName) == "KeyDescription"
    | extend
        OldKeys = coalesce(todynamic(tostring(ModProp.oldValue)), dynamic([])),
        NewKeys = coalesce(todynamic(tostring(ModProp.newValue)), dynamic([]))
    | extend AddedKeys = set_difference(NewKeys, OldKeys)
    | where array_length(AddedKeys) > 0
    | mv-expand AddedKey = AddedKeys to typeof(string)
    | extend
        KeyId    = extract(@"KeyIdentifier=([^,\]]+)", 1, AddedKey),
        KeyType  = extract(@"KeyType=([^,\]]+)", 1, AddedKey),
        KeyUsage = extract(@"KeyUsage=([^,\]]+)", 1, AddedKey),
        KeyName  = extract(@"DisplayName=([^\]]+)", 1, AddedKey)
    | extend CredentialClass = case(
        KeyType has "Password",           "Client Secret (password)",
        KeyType has "AsymmetricX509Cert", "Certificate",
        KeyType has "Symmetric",          "Symmetric Key",
        isempty(KeyType),                 "Unspecified",
        KeyType)
    | extend EventHour = datetime_part("hour", TimeGenerated)
    // collapse the App + SP target-resource pair to one row per credential, preferring the Application object
    | extend TargetRank = iff(TargetType has "Application", 2, 1)
    | summarize arg_max(TargetRank, *) by Correlation, KeyId
);
//
let AlertActors  = toscalar(AlertScope | summarize make_set(Actor, 100));
let AlertTargets = toscalar(AlertScope | summarize make_set(TargetId, 100));
//
let Historical =
    AuditLogs
    | where TimeGenerated between (AlertTime - BaselineWindow .. AlertTime - EventWindow)
    | extend
        Actor = tolower(coalesce(
            tostring(InitiatedBy.user.userPrincipalName),
            tostring(InitiatedBy.app.displayName))),
        ActorIP = tostring(InitiatedBy.user.ipAddress),
        Operation = tostring(OperationName);
//
let ActorCredentialBaseline =
    Historical
    | where Actor in (AlertActors)
    | where Operation has_any (CredentialOps)
    | summarize ActorCredentialOpCount=count(),
                ActorCredentialDaysSeen=dcount(bin(TimeGenerated, 1d))
            by Actor;
//
let ActorIpBaseline =
    Historical
    | where Actor in (AlertActors)
    | summarize ActorIpCount=count() by Actor, ActorIP;
//
let ActorActivityBaseline =
    Historical
    | where Actor in (AlertActors)
    | summarize ActorTotalEvents=count(),
                ActorDaysActive=dcount(bin(TimeGenerated, 1d))
            by Actor;
//
let TargetCredentialBaseline =
    Historical
    | where Operation has_any (CredentialOps)
    | mv-expand TargetResource = TargetResources
    | extend TargetId = tostring(TargetResource.id)
    | where TargetId in (AlertTargets)
    | summarize TargetCredentialCount=count(),
                TargetCredentialActors=dcount(Actor),
                TargetCredentialDaysSeen=dcount(bin(TimeGenerated, 1d))
            by TargetId;
//
let TenantCredentialBaseline =
    Historical
    | where Operation has_any (CredentialOps)
    | summarize TenantCredentialEvents=count(),
                TenantCredentialActors=dcount(Actor)
            by Operation;
//
let RelatedActivity =
    AuditLogs
    | where TimeGenerated between (AlertTime - EventWindow .. AlertTime + EventWindow)
    | extend Actor = tolower(coalesce(
        tostring(InitiatedBy.user.userPrincipalName),
        tostring(InitiatedBy.app.displayName)))
    | where Actor in (AlertActors)
    | summarize RelatedOps=count(),
                RelatedOperationSet=make_set(OperationName, 50),
                ChainOps=countif(
                    OperationName has "owner"
                    or OperationName has "Consent"
                    or OperationName has "role assignment"
                    or OperationName has "Add application"
                    or OperationName has "Add member to role")
            by CorrelationId;
//
AlertScope
| join kind=leftouter ActorCredentialBaseline on Actor
| join kind=leftouter ActorIpBaseline on Actor, ActorIP
| join kind=leftouter ActorActivityBaseline on Actor
| join kind=leftouter TargetCredentialBaseline on TargetId
| join kind=leftouter TenantCredentialBaseline on Operation
| join kind=leftouter RelatedActivity on $left.Correlation == $right.CorrelationId
| extend
    ActorCredentialOpCount=coalesce(ActorCredentialOpCount, 0),
    ActorCredentialDaysSeen=coalesce(ActorCredentialDaysSeen, 0),
    ActorIpCount=coalesce(ActorIpCount, 0),
    ActorTotalEvents=coalesce(ActorTotalEvents, 0),
    ActorDaysActive=coalesce(ActorDaysActive, 0),
    TargetCredentialCount=coalesce(TargetCredentialCount, 0),
    TargetCredentialActors=coalesce(TargetCredentialActors, 0),
    TargetCredentialDaysSeen=coalesce(TargetCredentialDaysSeen, 0),
    TenantCredentialEvents=coalesce(TenantCredentialEvents, 0),
    TenantCredentialActors=coalesce(TenantCredentialActors, 0),
    RelatedOps=coalesce(RelatedOps, 0),
    ChainOps=coalesce(ChainOps, 0)
| extend
    NewCredentialOpForActor = ActorCredentialOpCount == 0,
    NewActorIP              = ActorIpCount == 0 and isnotempty(ActorIP),
    FirstCredentialOnTarget = TargetCredentialCount == 0,
    RareTenantOperation     = TenantCredentialEvents <= 2,
    LowTenureActor          = ActorDaysActive <= 3,
    PersistenceChain        = ChainOps > 0
| extend BehaviouralFlags = strcat_array(array_concat(
        iff(NewCredentialOpForActor, pack_array("NEW_CREDENTIAL_OP_FOR_ACTOR"), dynamic([])),
        iff(NewActorIP,              pack_array("NEW_IP_FOR_ACTOR"), dynamic([])),
        iff(FirstCredentialOnTarget, pack_array("FIRST_CREDENTIAL_ON_TARGET"), dynamic([])),
        iff(RareTenantOperation,     pack_array("RARE_TENANT_OPERATION"), dynamic([])),
        iff(LowTenureActor,          pack_array("LOW_TENURE_ACTOR"), dynamic([])),
        iff(PersistenceChain,        pack_array("PERSISTENCE_CHAIN"), dynamic([]))
    ), " | ")
| extend QuickAssessment = case(
        NewCredentialOpForActor and FirstCredentialOnTarget,
            "Potentially suspicious - new actor behaviour against an object with no credential history; deep dive recommended",
        PersistenceChain,
            "Persistence-pattern context - credential add chained with owner/consent/app changes under one correlation; escalate",
        NewCredentialOpForActor and (NewActorIP or LowTenureActor),
            "Suspicious context - validate actor identity and session before closing",
        ActorCredentialDaysSeen > 5 and TargetCredentialActors > 1,
            "Likely benign - routine credential management by an established actor on a shared application",
        RareTenantOperation,
            "Rare tenant operation - confirm operational context",
        "Validate operational context"
    )
| extend Narrative = strcat(
    "- Auth-change quick triage completed for ", iff(isempty(AlertTitle), "New access credential added to Application or Service Principal", AlertTitle), ".\n",
    "- A new credential was added to ", TargetType, " '", TargetName, "'.\n",
    "- Credential class: ", CredentialClass, " (KeyType ", KeyType, ", usage ", KeyUsage, ").\n",
    "- Credential key identifier: ", KeyId, iff(isempty(KeyName), "", strcat(" (label: ", KeyName, ")")), ".\n",
    "- Initiating actor: ", Actor, " (", ActorType, ").\n",
    "- Source IP: ", iff(isempty(ActorIP), "not recorded", ActorIP), ".\n",
    "- Operation: ", Operation, " | Result: ", Result, ".\n",
    "- Actor credential history: actor has added credentials ", tostring(ActorCredentialOpCount), " time(s) across ", tostring(ActorCredentialDaysSeen), " day(s) in the last ", tostring(BaselineWindow), ".\n",
    "- Actor tenant footprint: ", tostring(ActorTotalEvents), " directory event(s) across ", tostring(ActorDaysActive), " active day(s) in baseline.\n",
    "- Source IP familiarity: this IP carries ", tostring(ActorIpCount), " prior event(s) for the actor.\n",
    "- Target credential history: this object has received credentials ", tostring(TargetCredentialCount), " time(s) from ", tostring(TargetCredentialActors), " actor(s) in baseline.\n",
    "- Tenant context: this operation occurred ", tostring(TenantCredentialEvents), " time(s) across ", tostring(TenantCredentialActors), " actor(s) tenant-wide in baseline.\n",
    "- Correlated activity: ", tostring(RelatedOps), " directory operation(s) share this correlation ID within ±", tostring(EventWindow), ".\n",
    "- Behavioural flags: ", iff(isempty(BehaviouralFlags), "none", BehaviouralFlags), ".\n",
    "- Quick assessment: ", QuickAssessment, ".\n",
    "- Recommended pivot: confirm the credential's expiry window via the application blade (not exposed in AuditLogs) and review AADServicePrincipalSignInLogs for authentications attributable to this application from ", format_datetime(TimeGenerated, "yyyy-MM-dd HH:mm"), " onward."
)
| project
    TimeGenerated,
    AlertTitle,
    Actor,
    ActorType,
    ActorIP,
    Operation,
    Result,
    TargetType,
    TargetName,
    TargetId,
    CredentialClass,
    KeyType,
    KeyUsage,
    KeyId,
    KeyName,
    ActorCredentialOpCount,
    ActorCredentialDaysSeen,
    ActorTotalEvents,
    ActorDaysActive,
    ActorIpCount,
    TargetCredentialCount,
    TargetCredentialActors,
    TargetCredentialDaysSeen,
    TenantCredentialEvents,
    TenantCredentialActors,
    RelatedOps,
    RelatedOperationSet,
    EventHour,
    BehaviouralFlags,
    QuickAssessment,
    Narrative
| sort by TimeGenerated asc
